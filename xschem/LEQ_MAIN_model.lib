* LEQ_MAIN_model.lib -- three interchangeable implementations of the same
* LEQ_MAIN_MODEL subckt (same name + pin interface in every section):
*   ideal  : single ideal inductor, L=2.8399n
*   rl     : EM-derived series L+R, L=2.8399n R=3.6407ohm
*   snp2le : snp2le broadband vector-fitted macromodel (same EM data)
* Select the active one from the including file via:
*   .lib <path>/LEQ_MAIN_model.lib ideal   (or rl, or snp2le)

.lib ideal
.SUBCKT LEQ_MAIN_MODEL p1 p2
L1 p1 p2 2.8399n
.ENDS LEQ_MAIN_MODEL
.endl ideal

.lib rl
.SUBCKT LEQ_MAIN_MODEL p1 p2
R1 p1 mid_LEQ_MAIN 3.6407
L1 mid_LEQ_MAIN p2 2.8399n
.ENDS LEQ_MAIN_MODEL
.endl rl

.lib snp2le
