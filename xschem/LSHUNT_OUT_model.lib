* LSHUNT_OUT_model.lib -- three interchangeable implementations of the same
* LSHUNT_OUT_MODEL subckt (same name + pin interface in every section):
*   ideal  : single ideal inductor, L=2.5041n
*   rl     : EM-derived series L+R, L=2.5041n R=3.0693ohm
*   snp2le : snp2le broadband vector-fitted macromodel (same EM data)
* Select the active one from the including file via:
*   .lib <path>/LSHUNT_OUT_model.lib ideal   (or rl, or snp2le)

.lib ideal
.SUBCKT LSHUNT_OUT_MODEL p1
L1 p1 0 2.5041n
.ENDS LSHUNT_OUT_MODEL
.endl ideal

.lib rl
.SUBCKT LSHUNT_OUT_MODEL p1
L1 p1 mid_LSHUNT_OUT 2.5041n
R1 mid_LSHUNT_OUT 0 3.0693
.ENDS LSHUNT_OUT_MODEL
.endl rl

.lib snp2le
