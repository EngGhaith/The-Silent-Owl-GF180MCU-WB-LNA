format="tcleval( @value )"
value="
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice

.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice moscap_typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical

*.include /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_io/spice/gf180mcu_fd_io.spice
.include /media/sf_LNA_chipathon/The-Silent-Owl-GF180MCU-WB-LNA/analog_pad_sp_paramerters/xschem/gf180mcu_fd_io__asig_5p0.spice 
"}
C {code.sym} 1150 50 0 0 {name=s2 only_toplevel=false value="
* =============================================================================
* FIXED SUPPLY / PACKAGE VALUES
* =============================================================================
.param VDS=5.0
.param VDDIO_SUP=5.0
.param L_BW=2n
.param R_BW=0.2

* =============================================================================
* FIXED INPUT NETWORK
* =============================================================================
.param L_IN=1.80n
.param R_L_IN=1.5
.param CIN_VAL=100p
.param C_SH_IN=1f

* =============================================================================
* FIXED XM2 COMMON-GATE INPUT STAGE
* =============================================================================
.param VBIAS_CG=2.00
.param W_CG=140u
.param M_CG=2
.param L_CG=0.60u
.param RD1=760
.param RBIAS_CG=50k
.param CBYP_CG=20p

* =============================================================================
* FIXED MIXED-VOLTAGE XM1/XM4 STAGE
* =============================================================================
.param C12_VAL=33p

.param VBIAS_CS=0.95
.param W_CS=40u
.param M_CS=2
.param L_CS=0.28u
.param RBIAS_CS=50k

.param VBIAS_CAS=3.30
.param W_CAS=70u
.param M_CAS=1
.param L_CAS=0.60u
.param RD2=490

* XM1 source equalizer
.param RS_EQ=7
.param CSEQ_VAL=12p

* =============================================================================
* FIXED BODY-TIED SOURCE FOLLOWER
* =============================================================================
.param W_SF=125u
.param M_SF=2
.param L_SF=0.60u
.param RG_SF_VAL=0.01

* =============================================================================
* FIXED OUTPUT NETWORK
* =============================================================================
.param COUT_VAL=56p
.param L_OUT=0.20n
.param R_L_OUT=1.5
.param C_SH_OUT=1f

* =============================================================================
* FIXED XM5 COMMON-GATE CURRENT SINK
* =============================================================================
.param VBIAS_ICG=1.55
.param L_BIAS_CG=0.50u
.param W_BIAS_CG=30u
.param M_BIAS_CG=1

* =============================================================================
* FIXED XM6 SOURCE-FOLLOWER CURRENT SINK
* =============================================================================
.param VBIAS_BUF=2.40
.param L_BIAS_SF=0.50u
.param W_BIAS_SF=50u
.param M_BIAS_SF=3

* Disabled series-RC high-frequency snubber
.param C_STAB_VAL=1f
.param R_STAB_VAL=50
C_STAB net9 n_stab \{C_STAB_VAL\}
R_STAB n_stab GND \{R_STAB_VAL\}

.control
set noaskquit
set wr_singlescale
set wr_vecnames
set numdgt=10
set filetype=ascii
set plotwinsize=0

* =============================================================================
* SPECIFICATION LIMITS
* =============================================================================

* Original 2.30–2.50 GHz design-band limits
let TB_S11_LIMIT=-10
let TB_S22_LIMIT=-10
let TB_S21_LIMIT=15
let TB_NF_LIMIT=3.5
let TB_RIPPLE_LIMIT=1.2
let TB_PDC_LIMIT=300
let TB_MU_LIMIT=1.05
let TB_DELTA_LIMIT=1.0

* New exact 1–6 GHz broadband limits
let BB_S11_LIMIT=-10
let BB_S22_LIMIT=-10
let BB_S21_LIMIT=10
let BB_NF_LIMIT=5

* DC and reliability checks
let MIN_SATMARGIN_SINK=0.20
let MIN_SATMARGIN_XM1=0.25
let MIN_SATMARGIN_CORE=0.40
let MIN_SATMARGIN_CG=0.50
let MAX_03V3_TERMINAL=3.00

* Append frequency tables after the report headers.
set appendwrite

* =============================================================================
* INITIALIZE THE TWO REPORT FILES
* =============================================================================

echo ============================================================ > lna_v28_detailed_report.txt
echo LNA_V28_FIXED_DUAL_BAND_DETAILED_REPORT >> lna_v28_detailed_report.txt
echo NO_PARAMETER_SWEEPS >> lna_v28_detailed_report.txt
echo EXACT_BANDS 2.30_TO_2.50_GHZ AND 1_TO_6_GHZ >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt
echo FIXED_PARAMETERS >> lna_v28_detailed_report.txt
echo SUPPLY VDS 5.0 VDDIO 5.0 >> lna_v28_detailed_report.txt
echo INPUT LIN 1.80n RLIN 1.5 CIN 100p CSHIN 1f >> lna_v28_detailed_report.txt
echo XM2 WCG 140u MCG 2 LCG 0.60u VBCG 2.00 RD1 760 >> lna_v28_detailed_report.txt
echo XM1 WCS 40u MCS 2 LCS 0.28u VBCS 0.95 >> lna_v28_detailed_report.txt
echo XM4 WCAS 70u MCAS 1 LCAS 0.60u VBCAS 3.30 RD2 490 >> lna_v28_detailed_report.txt
echo INTERSTAGE C12 33p REQ 7 CEQ 12p >> lna_v28_detailed_report.txt
echo FOLLOWER WSF 125u MSF 2 LSF 0.60u RG 0.01 >> lna_v28_detailed_report.txt
echo OUTPUT COUT 56p LOUT 0.20n RLOUT 1.5 CSHOUT 1f >> lna_v28_detailed_report.txt
echo XM5 W5 30u M5 1 L5 0.50u VBICG 1.55 >> lna_v28_detailed_report.txt
echo XM6 W6 50u M6 3 L6 0.50u VBUF_BIAS 2.40 >> lna_v28_detailed_report.txt
echo SNUBBER CSTAB 1f RSTAB 50 DISABLED_EFFECTIVELY >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt

echo ============================================================ > lna_v28_summary_report.txt
echo LNA_V28_FIXED_DUAL_BAND_SUMMARY_REPORT >> lna_v28_summary_report.txt
echo NO_PARAMETER_SWEEPS >> lna_v28_summary_report.txt
echo ============================================================ >> lna_v28_summary_report.txt
echo BAND_1 2.30_TO_2.50_GHZ >> lna_v28_summary_report.txt
echo BAND_1_LIMITS S11_LT_-10 S22_LT_-10 S21_GT_15 NF_LT_3P5 RIPPLE_LT_1P2 PDC_LT_300 MU_GT_1P05 DELTA_LT_1 >> lna_v28_summary_report.txt
echo BAND_2 1_TO_6_GHZ >> lna_v28_summary_report.txt
echo BAND_2_LIMITS S11_LT_-10 S22_LT_-10 S21_GT_10 NF_LT_5 >> lna_v28_summary_report.txt
echo ============================================================ >> lna_v28_summary_report.txt

* =============================================================================
* 1. DC OPERATING POINT AND DEVICE HEADROOM
* =============================================================================
op

let PDCmW=1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))
let IDD=abs(i(VDD))
let IIO=abs(i(VDDIO))

let Vsrc1=v(net3)
let VX1=v(net8)
let V9=v(net9)
let VbufDC=v(vbuf)

let ID1=abs(@m.xm1.m0[id])
let GM1=@m.xm1.m0[gm]
let GDS1=@m.xm1.m0[gds]
let VGS1=v(g_cs)-v(net3)
let VGD1=v(g_cs)-v(net8)
let VGB1=v(g_cs)
let VDS1=v(net8)-v(net3)
let VDSAT1=abs(@m.xm1.m0[vdsat])
let SAT1=VDS1-VDSAT1
let GMID1=GM1/ID1

let ID2=abs(@m.xm2.m0[id])
let GM2=@m.xm2.m0[gm]
let GMB2=@m.xm2.m0[gmbs]
let GDS2=@m.xm2.m0[gds]
let VDS2=v(d)-v(s)
let VDSAT2=abs(@m.xm2.m0[vdsat])
let SAT2=VDS2-VDSAT2
let GMID2=GM2/ID2

let ID3=abs(@m.xm3.m0[id])
let GM3=@m.xm3.m0[gm]
let GDS3=@m.xm3.m0[gds]
let VDS3=v(vdcbias)-v(vbuf)
let VDSAT3=abs(@m.xm3.m0[vdsat])
let SAT3=VDS3-VDSAT3
let GMID3=GM3/ID3

let ID4=abs(@m.xm4.m0[id])
let GM4=@m.xm4.m0[gm]
let GDS4=@m.xm4.m0[gds]
let VDS4=v(net9)-v(net8)
let VDSAT4=abs(@m.xm4.m0[vdsat])
let SAT4=VDS4-VDSAT4
let GMID4=GM4/ID4

let ID5=abs(@m.xm5.m0[id])
let GM5=@m.xm5.m0[gm]
let GDS5=@m.xm5.m0[gds]
let VDS5=v(s)
let VDSAT5=abs(@m.xm5.m0[vdsat])
let SAT5=VDS5-VDSAT5
let GMID5=GM5/ID5
let RO5=1/GDS5

let ID6=abs(@m.xm6.m0[id])
let GM6=@m.xm6.m0[gm]
let GDS6=@m.xm6.m0[gds]
let VDS6=v(vbuf)
let VDSAT6=abs(@m.xm6.m0[vdsat])
let SAT6=VDS6-VDSAT6
let GMID6=GM6/ID6
let RO6=1/GDS6

let GMRatio25=(GM2+GMB2)/GM5

let DCPass=1
if SAT1 < MIN_SATMARGIN_XM1
  let DCPass=0
end
if SAT2 < MIN_SATMARGIN_CG
  let DCPass=0
end
if SAT3 < MIN_SATMARGIN_CORE
  let DCPass=0
end
if SAT4 < MIN_SATMARGIN_CORE
  let DCPass=0
end
if SAT5 < MIN_SATMARGIN_SINK
  let DCPass=0
end
if SAT6 < MIN_SATMARGIN_SINK
  let DCPass=0
end
if abs(VGS1) > MAX_03V3_TERMINAL
  let DCPass=0
end
if abs(VGD1) > MAX_03V3_TERMINAL
  let DCPass=0
end
if abs(VGB1) > MAX_03V3_TERMINAL
  let DCPass=0
end
if abs(VDS1) > MAX_03V3_TERMINAL
  let DCPass=0
end

* Preserve DC scalars after the OP plot is destroyed.
set OP_PDC=$&PDCmW
set OP_IDD=$&IDD
set OP_IIO=$&IIO
set OP_VSRC1=$&Vsrc1
set OP_VX1=$&VX1
set OP_V9=$&V9
set OP_VBUF=$&VbufDC

set OP_ID1=$&ID1
set OP_GM1=$&GM1
set OP_GDS1=$&GDS1
set OP_GMID1=$&GMID1
set OP_VGS1=$&VGS1
set OP_VGD1=$&VGD1
set OP_VGB1=$&VGB1
set OP_VDS1=$&VDS1
set OP_SAT1=$&SAT1

set OP_ID2=$&ID2
set OP_GM2=$&GM2
set OP_GMB2=$&GMB2
set OP_GDS2=$&GDS2
set OP_GMID2=$&GMID2
set OP_VDS2=$&VDS2
set OP_SAT2=$&SAT2

set OP_ID3=$&ID3
set OP_GM3=$&GM3
set OP_GDS3=$&GDS3
set OP_GMID3=$&GMID3
set OP_VDS3=$&VDS3
set OP_SAT3=$&SAT3

set OP_ID4=$&ID4
set OP_GM4=$&GM4
set OP_GDS4=$&GDS4
set OP_GMID4=$&GMID4
set OP_VDS4=$&VDS4
set OP_SAT4=$&SAT4

set OP_ID5=$&ID5
set OP_GM5=$&GM5
set OP_GDS5=$&GDS5
set OP_GMID5=$&GMID5
set OP_RO5=$&RO5
set OP_VDS5=$&VDS5
set OP_SAT5=$&SAT5

set OP_ID6=$&ID6
set OP_GM6=$&GM6
set OP_GDS6=$&GDS6
set OP_GMID6=$&GMID6
set OP_RO6=$&RO6
set OP_VDS6=$&VDS6
set OP_SAT6=$&SAT6

set OP_RATIO25=$&GMRatio25
set OP_DCPASS=$&DCPass

echo DC_OPERATING_POINT >> lna_v28_detailed_report.txt
echo POWER PDC_MW $OP_PDC IDD_A $OP_IDD IIO_A $OP_IIO >> lna_v28_detailed_report.txt
echo NODES NET3_XM1_SOURCE $OP_VSRC1 NET8_XM1_DRAIN $OP_VX1 NET9_XM4_DRAIN $OP_V9 VBUF $OP_VBUF >> lna_v28_detailed_report.txt
echo XM1 ID $OP_ID1 GM $OP_GM1 GDS $OP_GDS1 GMID $OP_GMID1 VGS $OP_VGS1 VGD $OP_VGD1 VGB $OP_VGB1 VDS $OP_VDS1 SAT_MARGIN $OP_SAT1 >> lna_v28_detailed_report.txt
echo XM2 ID $OP_ID2 GM $OP_GM2 GMB $OP_GMB2 GDS $OP_GDS2 GMID $OP_GMID2 VDS $OP_VDS2 SAT_MARGIN $OP_SAT2 >> lna_v28_detailed_report.txt
echo XM3 ID $OP_ID3 GM $OP_GM3 GDS $OP_GDS3 GMID $OP_GMID3 VDS $OP_VDS3 SAT_MARGIN $OP_SAT3 >> lna_v28_detailed_report.txt
echo XM4 ID $OP_ID4 GM $OP_GM4 GDS $OP_GDS4 GMID $OP_GMID4 VDS $OP_VDS4 SAT_MARGIN $OP_SAT4 >> lna_v28_detailed_report.txt
echo XM5 ID $OP_ID5 GM $OP_GM5 GDS $OP_GDS5 GMID $OP_GMID5 RO $OP_RO5 VDS $OP_VDS5 SAT_MARGIN $OP_SAT5 >> lna_v28_detailed_report.txt
echo XM6 ID $OP_ID6 GM $OP_GM6 GDS $OP_GDS6 GMID $OP_GMID6 RO $OP_RO6 VDS $OP_VDS6 SAT_MARGIN $OP_SAT6 >> lna_v28_detailed_report.txt
echo GM_RATIO_XM2EFF_OVER_XM5 $OP_RATIO25 >> lna_v28_detailed_report.txt
echo DC_PASS $OP_DCPASS >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt

destroy $curplot

* =============================================================================
* 2. EXACT 2.30 TO 2.50 GHz ANALYSIS
* =============================================================================
sp lin 401 2.30G 2.50G 1

let FGHz=frequency/1e9
let S11db=db(s_1_1)
let S21db=db(s_2_1)
let S12db=db(s_1_2)
let S22db=db(s_2_2)
let NFdb=real(NF)
let NFMINdb=real(NFmin)

let Delta=s_1_1*s_2_2-s_1_2*s_2_1
let DeltaMag=mag(Delta)
let A11=mag(s_1_1)
let A12=mag(s_1_2)
let A21=mag(s_2_1)
let A22=mag(s_2_2)

let Mu=(1-A11*A11)/(mag(s_2_2-Delta*conj(s_1_1))+mag(s_1_2*s_2_1))
let Mup=(1-A22*A22)/(mag(s_1_1-Delta*conj(s_2_2))+mag(s_1_2*s_2_1))
let Kfactor=(1-A11*A11-A22*A22+DeltaMag*DeltaMag)/(2*A12*A21)

let Zin=50*(1+s_1_1)/(1-s_1_1)
let Zout=50*(1+s_2_2)/(1-s_2_2)
let ZinRe=real(Zin)
let ZinIm=imag(Zin)
let ZoutRe=real(Zout)
let ZoutIm=imag(Zout)
let VSWRin=(1+A11)/(1-A11)
let VSWRout=(1+A22)/(1-A22)

let S11Worst=maximum(S11db)
let S21Min=minimum(S21db)
let S21Max=maximum(S21db)
let S21Ripple=S21Max-S21Min
let S21Tilt=abs(S21db[0]-S21db[400])
let S12Worst=maximum(S12db)
let S22Worst=maximum(S22db)
let NFWorst=maximum(NFdb)
let NFMINWorst=maximum(NFMINdb)
let MuMin=minimum(Mu)
let MupMin=minimum(Mup)
let KMin=minimum(Kfactor)
let DeltaMax=maximum(DeltaMag)
let VSWRinMax=maximum(VSWRin)
let VSWRoutMax=maximum(VSWRout)

* Exact 2.4 GHz values: index 200 of the 401-point linear sweep.
let S11At2p4=S11db[200]
let S21At2p4=S21db[200]
let S12At2p4=S12db[200]
let S22At2p4=S22db[200]
let NFAt2p4=NFdb[200]
let NFMINAt2p4=NFMINdb[200]
let MuAt2p4=Mu[200]
let MupAt2p4=Mup[200]
let KAt2p4=Kfactor[200]
let DeltaAt2p4=DeltaMag[200]
let ZinReAt2p4=ZinRe[200]
let ZinImAt2p4=ZinIm[200]
let ZoutReAt2p4=ZoutRe[200]
let ZoutImAt2p4=ZoutIm[200]

let TBPassCount=0
if S11Worst < TB_S11_LIMIT
  let TBPassCount=TBPassCount+1
end
if S22Worst < TB_S22_LIMIT
  let TBPassCount=TBPassCount+1
end
if S21Min > TB_S21_LIMIT
  let TBPassCount=TBPassCount+1
end
if NFWorst < TB_NF_LIMIT
  let TBPassCount=TBPassCount+1
end
if S21Ripple < TB_RIPPLE_LIMIT
  let TBPassCount=TBPassCount+1
end
if $OP_PDC < TB_PDC_LIMIT
  let TBPassCount=TBPassCount+1
end
if MuMin > TB_MU_LIMIT
  let TBPassCount=TBPassCount+1
end
if MupMin > TB_MU_LIMIT
  let TBPassCount=TBPassCount+1
end
if DeltaMax < TB_DELTA_LIMIT
  let TBPassCount=TBPassCount+1
end

let TBPass=0
if TBPassCount = 9
  let TBPass=1
end

set TB_S11W=$&S11Worst
set TB_S21MIN=$&S21Min
set TB_S21MAX=$&S21Max
set TB_RIPPLE=$&S21Ripple
set TB_TILT=$&S21Tilt
set TB_S12W=$&S12Worst
set TB_S22W=$&S22Worst
set TB_NFW=$&NFWorst
set TB_NFMINW=$&NFMINWorst
set TB_MUMIN=$&MuMin
set TB_MUPMIN=$&MupMin
set TB_KMIN=$&KMin
set TB_DELTAMAX=$&DeltaMax
set TB_VSWRINMAX=$&VSWRinMax
set TB_VSWROUTMAX=$&VSWRoutMax
set TB_PASSCOUNT=$&TBPassCount
set TB_PASS=$&TBPass

set TB_S11_2P4=$&S11At2p4
set TB_S21_2P4=$&S21At2p4
set TB_S12_2P4=$&S12At2p4
set TB_S22_2P4=$&S22At2p4
set TB_NF_2P4=$&NFAt2p4
set TB_NFMIN_2P4=$&NFMINAt2p4
set TB_MU_2P4=$&MuAt2p4
set TB_MUP_2P4=$&MupAt2p4
set TB_K_2P4=$&KAt2p4
set TB_DELTA_2P4=$&DeltaAt2p4
set TB_ZINRE_2P4=$&ZinReAt2p4
set TB_ZINIM_2P4=$&ZinImAt2p4
set TB_ZOUTRE_2P4=$&ZoutReAt2p4
set TB_ZOUTIM_2P4=$&ZoutImAt2p4

echo BAND_1_FULL_FREQUENCY_DATA_2P30_TO_2P50_GHZ >> lna_v28_detailed_report.txt
echo COLUMNS FGHz S11db S21db S12db S22db NFdb NFMINdb Mu Mup Kfactor DeltaMag ZinRe ZinIm ZoutRe ZoutIm VSWRin VSWRout >> lna_v28_detailed_report.txt
wrdata lna_v28_detailed_report.txt \\
  FGHz S11db S21db S12db S22db NFdb NFMINdb \\
  Mu Mup Kfactor DeltaMag ZinRe ZinIm ZoutRe ZoutIm VSWRin VSWRout
echo END_BAND_1_FULL_FREQUENCY_DATA >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt

destroy $curplot

* =============================================================================
* 3. EXACT 1 TO 6 GHz ANALYSIS
* =============================================================================
sp lin 2001 1G 6G 1

let FGHz=frequency/1e9
let S11db=db(s_1_1)
let S21db=db(s_2_1)
let S12db=db(s_1_2)
let S22db=db(s_2_2)
let NFdb=real(NF)
let NFMINdb=real(NFmin)

let Delta=s_1_1*s_2_2-s_1_2*s_2_1
let DeltaMag=mag(Delta)
let A11=mag(s_1_1)
let A12=mag(s_1_2)
let A21=mag(s_2_1)
let A22=mag(s_2_2)

let Mu=(1-A11*A11)/(mag(s_2_2-Delta*conj(s_1_1))+mag(s_1_2*s_2_1))
let Mup=(1-A22*A22)/(mag(s_1_1-Delta*conj(s_2_2))+mag(s_1_2*s_2_1))
let Kfactor=(1-A11*A11-A22*A22+DeltaMag*DeltaMag)/(2*A12*A21)

let Zin=50*(1+s_1_1)/(1-s_1_1)
let Zout=50*(1+s_2_2)/(1-s_2_2)
let ZinRe=real(Zin)
let ZinIm=imag(Zin)
let ZoutRe=real(Zout)
let ZoutIm=imag(Zout)
let VSWRin=(1+A11)/(1-A11)
let VSWRout=(1+A22)/(1-A22)

let S11Worst=maximum(S11db)
let S21Min=minimum(S21db)
let S21Max=maximum(S21db)
let S21Ripple=S21Max-S21Min
let S21Tilt=abs(S21db[0]-S21db[2000])
let S12Worst=maximum(S12db)
let S22Worst=maximum(S22db)
let NFWorst=maximum(NFdb)
let NFMINWorst=maximum(NFMINdb)
let MuMin=minimum(Mu)
let MupMin=minimum(Mup)
let KMin=minimum(Kfactor)
let DeltaMax=maximum(DeltaMag)
let VSWRinMax=maximum(VSWRin)
let VSWRoutMax=maximum(VSWRout)

let BBPassCount=0
if S11Worst < BB_S11_LIMIT
  let BBPassCount=BBPassCount+1
end
if S22Worst < BB_S22_LIMIT
  let BBPassCount=BBPassCount+1
end
if S21Min > BB_S21_LIMIT
  let BBPassCount=BBPassCount+1
end
if NFWorst < BB_NF_LIMIT
  let BBPassCount=BBPassCount+1
end

let BBPass=0
if BBPassCount = 4
  let BBPass=1
end

set BB_S11W=$&S11Worst
set BB_S21MIN=$&S21Min
set BB_S21MAX=$&S21Max
set BB_RIPPLE=$&S21Ripple
set BB_TILT=$&S21Tilt
set BB_S12W=$&S12Worst
set BB_S22W=$&S22Worst
set BB_NFW=$&NFWorst
set BB_NFMINW=$&NFMINWorst
set BB_MUMIN=$&MuMin
set BB_MUPMIN=$&MupMin
set BB_KMIN=$&KMin
set BB_DELTAMAX=$&DeltaMax
set BB_VSWRINMAX=$&VSWRinMax
set BB_VSWROUTMAX=$&VSWRoutMax
set BB_PASSCOUNT=$&BBPassCount
set BB_PASS=$&BBPass

echo BAND_2_FULL_FREQUENCY_DATA_1_TO_6_GHZ >> lna_v28_detailed_report.txt
echo COLUMNS FGHz S11db S21db S12db S22db NFdb NFMINdb Mu Mup Kfactor DeltaMag ZinRe ZinIm ZoutRe ZoutIm VSWRin VSWRout >> lna_v28_detailed_report.txt
wrdata lna_v28_detailed_report.txt \\
  FGHz S11db S21db S12db S22db NFdb NFMINdb \\
  Mu Mup Kfactor DeltaMag ZinRe ZinIm ZoutRe ZoutIm VSWRin VSWRout
echo END_BAND_2_FULL_FREQUENCY_DATA >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt

destroy $curplot

* =============================================================================
* 4. INTERACTIVE PLOTS: DISPLAY 0 TO 7 GHz
* =============================================================================
* The actual RF analysis begins at 1 MHz because SP/noise analysis is not
* evaluated at exactly DC. All graph x-axes are displayed from 0 to 7 GHz.
sp lin 2801 1MEG 7G 1

let FGHz=frequency/1e9
let S11db=db(s_1_1)
let S21db=db(s_2_1)
let S12db=db(s_1_2)
let S22db=db(s_2_2)
let NFdb=real(NF)
let NFMINdb=real(NFmin)

let Delta=s_1_1*s_2_2-s_1_2*s_2_1
let DeltaMag=mag(Delta)
let A11=mag(s_1_1)
let A12=mag(s_1_2)
let A21=mag(s_2_1)
let A22=mag(s_2_2)

let Mu=(1-A11*A11)/(mag(s_2_2-Delta*conj(s_1_1))+mag(s_1_2*s_2_1))
let Mup=(1-A22*A22)/(mag(s_1_1-Delta*conj(s_2_2))+mag(s_1_2*s_2_1))
let Kfactor=(1-A11*A11-A22*A22+DeltaMag*DeltaMag)/(2*A12*A21)

let Zin=50*(1+s_1_1)/(1-s_1_1)
let Zout=50*(1+s_2_2)/(1-s_2_2)
let ZinRe=real(Zin)
let ZinIm=imag(Zin)
let ZoutRe=real(Zout)
let ZoutIm=imag(Zout)
let VSWRin=(1+A11)/(1-A11)
let VSWRout=(1+A22)/(1-A22)

setscale FGHz

* NF and NFmin together
plot NFdb NFMINdb xlimit 0 7

* Combined response plots retained from the previous deck
plot S21db NFdb xlimit 0 7
plot S11db S22db xlimit 0 7

* Each S-parameter on a separate graph
plot S11db xlimit 0 7
plot S21db xlimit 0 7
plot S12db xlimit 0 7
plot S22db xlimit 0 7

* All S-parameters on one graph
plot S11db S21db S12db S22db xlimit 0 7

* Stability
plot Mu Mup xlimit 0 7
plot Kfactor xlimit 0 7
plot DeltaMag xlimit 0 7

* Impedance and VSWR
plot ZinRe ZinIm xlimit 0 7
plot ZoutRe ZoutIm xlimit 0 7
plot VSWRin VSWRout xlimit 0 7

* Do not destroy this plot. Keep all graph windows interactive.

* =============================================================================
* 5. WIDEBAND STABILITY CHECK: 10 MHz TO 30 GHz
* =============================================================================
sp dec 100 10Meg 30Gig 1

let WBFrequencyGHz=frequency/1e9
let WBDelta=s_1_1*s_2_2-s_1_2*s_2_1
let WBDeltaMag=mag(WBDelta)
let WBA11=mag(s_1_1)
let WBA12=mag(s_1_2)
let WBA21=mag(s_2_1)
let WBA22=mag(s_2_2)

let WBMu=(1-WBA11*WBA11)/(mag(s_2_2-WBDelta*conj(s_1_1))+mag(s_1_2*s_2_1))
let WBMup=(1-WBA22*WBA22)/(mag(s_1_1-WBDelta*conj(s_2_2))+mag(s_1_2*s_2_1))
let WBK=(1-WBA11*WBA11-WBA22*WBA22+WBDeltaMag*WBDeltaMag)/(2*WBA12*WBA21)

let WBMuMin=minimum(WBMu)
let WBMupMin=minimum(WBMup)
let WBKMin=minimum(WBK)
let WBDeltaMax=maximum(WBDeltaMag)

set WB_MUMIN=$&WBMuMin
set WB_MUPMIN=$&WBMupMin
set WB_KMIN=$&WBKMin
set WB_DELTAMAX=$&WBDeltaMax

* =============================================================================
* FINAL AGGREGATE SECTIONS IN THE DETAILED REPORT
* =============================================================================

echo BAND_1_AGGREGATE_RESULTS_2P30_TO_2P50_GHZ >> lna_v28_detailed_report.txt
echo S11_WORST_DB $TB_S11W >> lna_v28_detailed_report.txt
echo S21_MIN_DB $TB_S21MIN S21_MAX_DB $TB_S21MAX RIPPLE_DB $TB_RIPPLE TILT_DB $TB_TILT >> lna_v28_detailed_report.txt
echo S12_WORST_DB $TB_S12W S22_WORST_DB $TB_S22W >> lna_v28_detailed_report.txt
echo NF_WORST_DB $TB_NFW NFMIN_WORST_DB $TB_NFMINW >> lna_v28_detailed_report.txt
echo STABILITY MU_MIN $TB_MUMIN MUP_MIN $TB_MUPMIN K_MIN $TB_KMIN DELTA_MAX $TB_DELTAMAX >> lna_v28_detailed_report.txt
echo VSWR INPUT_MAX $TB_VSWRINMAX OUTPUT_MAX $TB_VSWROUTMAX >> lna_v28_detailed_report.txt
echo AT_2P4GHZ S11_DB $TB_S11_2P4 S21_DB $TB_S21_2P4 S12_DB $TB_S12_2P4 S22_DB $TB_S22_2P4 NF_DB $TB_NF_2P4 NFMIN_DB $TB_NFMIN_2P4 >> lna_v28_detailed_report.txt
echo AT_2P4GHZ MU $TB_MU_2P4 MUP $TB_MUP_2P4 K $TB_K_2P4 DELTA $TB_DELTA_2P4 >> lna_v28_detailed_report.txt
echo AT_2P4GHZ ZIN_RE $TB_ZINRE_2P4 ZIN_IM $TB_ZINIM_2P4 ZOUT_RE $TB_ZOUTRE_2P4 ZOUT_IM $TB_ZOUTIM_2P4 >> lna_v28_detailed_report.txt
echo BAND_1_RESULT PASSCOUNT $TB_PASSCOUNT OF_9 PASS $TB_PASS >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt

echo BAND_2_AGGREGATE_RESULTS_1_TO_6_GHZ >> lna_v28_detailed_report.txt
echo S11_WORST_DB $BB_S11W >> lna_v28_detailed_report.txt
echo S21_MIN_DB $BB_S21MIN S21_MAX_DB $BB_S21MAX RIPPLE_DB $BB_RIPPLE TILT_DB $BB_TILT >> lna_v28_detailed_report.txt
echo S12_WORST_DB $BB_S12W S22_WORST_DB $BB_S22W >> lna_v28_detailed_report.txt
echo NF_WORST_DB $BB_NFW NFMIN_WORST_DB $BB_NFMINW >> lna_v28_detailed_report.txt
echo STABILITY MU_MIN $BB_MUMIN MUP_MIN $BB_MUPMIN K_MIN $BB_KMIN DELTA_MAX $BB_DELTAMAX >> lna_v28_detailed_report.txt
echo VSWR INPUT_MAX $BB_VSWRINMAX OUTPUT_MAX $BB_VSWROUTMAX >> lna_v28_detailed_report.txt
echo BAND_2_RESULT PASSCOUNT $BB_PASSCOUNT OF_4 PASS $BB_PASS >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt

echo WIDEBAND_STABILITY_10MHZ_TO_30GHZ >> lna_v28_detailed_report.txt
echo MU_MIN $WB_MUMIN MUP_MIN $WB_MUPMIN K_MIN $WB_KMIN DELTA_MAX $WB_DELTAMAX >> lna_v28_detailed_report.txt
echo ============================================================ >> lna_v28_detailed_report.txt

* =============================================================================
* CONCISE SUMMARY REPORT
* =============================================================================

echo FIXED_POINT >> lna_v28_summary_report.txt
echo WCG_140u VBCG_2P00 RD1_760 W5_30u VBICG_1P55 C12_33p REQ_7 CEQ_12p RD2_490 COUT_56p >> lna_v28_summary_report.txt
echo POWER PDC_MW $OP_PDC IDD_A $OP_IDD DC_PASS $OP_DCPASS >> lna_v28_summary_report.txt
echo ============================================================ >> lna_v28_summary_report.txt

echo BAND_1_RESULTS_2P30_TO_2P50_GHZ >> lna_v28_summary_report.txt
echo S11_WORST_DB $TB_S11W LIMIT_LT_-10 >> lna_v28_summary_report.txt
echo S22_WORST_DB $TB_S22W LIMIT_LT_-10 >> lna_v28_summary_report.txt
echo S21_MIN_DB $TB_S21MIN LIMIT_GT_15 >> lna_v28_summary_report.txt
echo S21_MAX_DB $TB_S21MAX RIPPLE_DB $TB_RIPPLE LIMIT_LT_1P2 >> lna_v28_summary_report.txt
echo NF_WORST_DB $TB_NFW LIMIT_LT_3P5 >> lna_v28_summary_report.txt
echo MU_MIN $TB_MUMIN MUP_MIN $TB_MUPMIN DELTA_MAX $TB_DELTAMAX >> lna_v28_summary_report.txt
echo PASSCOUNT $TB_PASSCOUNT OF_9 BAND_1_PASS $TB_PASS >> lna_v28_summary_report.txt
echo ============================================================ >> lna_v28_summary_report.txt

echo BAND_2_RESULTS_1_TO_6_GHZ >> lna_v28_summary_report.txt
echo S11_WORST_DB $BB_S11W LIMIT_LT_-10 >> lna_v28_summary_report.txt
echo S22_WORST_DB $BB_S22W LIMIT_LT_-10 >> lna_v28_summary_report.txt
echo S21_MIN_DB $BB_S21MIN LIMIT_GT_10 >> lna_v28_summary_report.txt
echo S21_MAX_DB $BB_S21MAX RIPPLE_DB $BB_RIPPLE >> lna_v28_summary_report.txt
echo NF_WORST_DB $BB_NFW LIMIT_LT_5 >> lna_v28_summary_report.txt
echo MU_MIN $BB_MUMIN MUP_MIN $BB_MUPMIN DELTA_MAX $BB_DELTAMAX >> lna_v28_summary_report.txt
echo PASSCOUNT $BB_PASSCOUNT OF_4 BAND_2_PASS $BB_PASS >> lna_v28_summary_report.txt
echo ============================================================ >> lna_v28_summary_report.txt

echo WIDEBAND_STABILITY_10MHZ_TO_30GHZ >> lna_v28_summary_report.txt
echo MU_MIN $WB_MUMIN MUP_MIN $WB_MUPMIN K_MIN $WB_KMIN DELTA_MAX $WB_DELTAMAX >> lna_v28_summary_report.txt
echo ============================================================ >> lna_v28_summary_report.txt

echo LNA_V28_SIMULATION_COMPLETE
echo DETAILED_REPORT lna_v28_detailed_report.txt
echo SUMMARY_REPORT lna_v28_summary_report.txt
echo INTERACTIVE_PLOTS_OPENED 14
echo NGSPICE_LEFT_OPEN_FOR_CURSOR_ZOOM_AND_TRACE_INSPECTION

.endc
"}
