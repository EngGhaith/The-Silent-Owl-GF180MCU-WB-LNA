set op_ro2=$&ro2op

set op_id3=$&id3op
set op_gm3=$&gm3op
set op_gmb3=$&gmb3op
set op_gds3=$&gds3op
set op_vgs3=$&vgs3op
set op_vds3=$&vds3op
set op_vbs3=$&vbs3op
set op_vth3=$&vth3op
set op_vov3=$&vov3op
set op_vdsat3=$&vdsat3op
set op_sat3=$&sat3op
set op_gmid3=$&gmid3op
set op_ro3=$&ro3op

set op_id4=$&id4op
set op_gm4=$&gm4op
set op_gmb4=$&gmb4op
set op_gds4=$&gds4op
set op_vgs4=$&vgs4op
set op_vds4=$&vds4op
set op_vbs4=$&vbs4op
