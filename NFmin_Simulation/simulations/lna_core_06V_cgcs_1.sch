* =============================================================================
* FIXED SUPPLY / PACKAGE VALUES
* =============================================================================

.param VDS=5.0
.param VDDIO_SUP=5.0
.param L_BW=2n
.param R_BW=0.2


* =============================================================================
* FIXED INPUT NETWORK
* =============================================================================

.param L_IN=1.80n
.param R_L_IN=1.5
.param CIN_VAL=100p
.param C_SH_IN=1f


* =============================================================================
* FIXED XM2 COMMON-GATE INPUT STAGE
* =============================================================================

.param VBIAS_CG=2.20
.param W_CG=140u
.param M_CG=2
.param L_CG=0.60u
.param RD1=760
.param RBIAS_CG=50k
.param CBYP_CG=20p


* =============================================================================
* FIXED MIXED-VOLTAGE XM1/XM4 STAGE
* =============================================================================

.param C12_VAL=33p

.param VBIAS_CS=1.05
.param W_CS=40u
.param M_CS=2
.param L_CS=0.28u
.param RBIAS_CS=50k

.param VBIAS_CAS=3.30
.param W_CAS=70u
.param M_CAS=1
.param L_CAS=0.60u
.param RD2=490

.param RS_EQ=7
.param CSEQ_VAL=12p


* =============================================================================
* FIXED BODY-TIED SOURCE FOLLOWER
* =============================================================================

.param W_SF=125u
.param M_SF=2
.param L_SF=0.60u
.param RG_SF_VAL=0.01


* =============================================================================
* FIXED OUTPUT NETWORK
* =============================================================================

.param COUT_VAL=56p
.param L_OUT=0.20n
.param R_L_OUT=1.5
.param C_SH_OUT=1f


* =============================================================================
* FIXED XM5 COMMON-GATE CURRENT SINK
* =============================================================================

.param VBIAS_ICG=1.55
.param L_BIAS_CG=0.50u
.param W_BIAS_CG=30u
.param M_BIAS_CG=1


* =============================================================================
* FIXED XM6 SOURCE-FOLLOWER CURRENT SINK
* =============================================================================

.param VBIAS_BUF=2.40
.param L_BIAS_SF=0.50u
.param W_BIAS_SF=50u
.param M_BIAS_SF=3


* =============================================================================
* XM7 CG-CASCODE SWEEP PARAMETERS
* =============================================================================

.param VBIAS_CAS_CG=3.40
.param L_CAS_CG=0.60u
.param W_CAS_CG=50u
.param M_CAS_CG=2

* =============================================================================
* NGSPICE-42 REPORT BLOCK FOR lna_core_06V_cgcs
* Based on the scalar-save and fresh-plot method from the supplied reference.
* No double quote characters are used.
* Replace the existing .control through .endc block with this block.
* =============================================================================

.control

set noaskquit
set wr_singlescale
set wr_vecnames
set numdgt=10

let target_gain_bw=10.0

echo ============================================================ > lna_core_06V_cgcs_report.txt
echo GF180MCU_LNA_CORE_06V_CGCS_DETAILED_REPORT >> lna_core_06V_cgcs_report.txt
echo TARGET_FREQUENCY_HZ 2.400e9 >> lna_core_06V_cgcs_report.txt
echo TARGET_BAND_HZ 2.300e9 2.500e9 >> lna_core_06V_cgcs_report.txt
echo GAIN_BANDWIDTH_THRESHOLD_DB 10.0 >> lna_core_06V_cgcs_report.txt
echo PORT_REFERENCE_OHM 50 >> lna_core_06V_cgcs_report.txt
echo ============================================================ >> lna_core_06V_cgcs_report.txt

* =============================================================================
* DC OPERATING POINT
* =============================================================================

op

let pdcop=1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))
let icoreop=abs(i(VDD))
let iioop=abs(i(VDDIO))

let vsop=v(s)
let vdop=v(d)
let vnet3op=v(net3)
let vnet8op=v(net8)
let vbufop=v(vbuf)
let vgcsop=v(g_cs)
let vgcgop=v(g_cg)

let id1op=abs(@m.xm1.m0[id])
let gm1op=@m.xm1.m0[gm]
let gmb1op=@m.xm1.m0[gmbs]
let gds1op=@m.xm1.m0[gds]
let vgs1op=@m.xm1.m0[vgs]
let vds1op=@m.xm1.m0[vds]
let vbs1op=@m.xm1.m0[vbs]
let vth1op=@m.xm1.m0[vth]
let vov1op=vgs1op-vth1op
let vdsat1op=abs(@m.xm1.m0[vdsat])
let sat1op=vds1op-vdsat1op
let gmid1op=gm1op/(id1op+1e-30)
let ro1op=1/(gds1op+1e-30)

let id2op=abs(@m.xm2.m0[id])
let gm2op=@m.xm2.m0[gm]
let gmb2op=@m.xm2.m0[gmbs]
let gds2op=@m.xm2.m0[gds]
let vgs2op=@m.xm2.m0[vgs]
let vds2op=@m.xm2.m0[vds]
let vbs2op=@m.xm2.m0[vbs]
let vth2op=@m.xm2.m0[vth]
let vov2op=vgs2op-vth2op
let vdsat2op=abs(@m.xm2.m0[vdsat])
let sat2op=vds2op-vdsat2op
let gmid2op=gm2op/(id2op+1e-30)
let ro2op=1/(gds2op+1e-30)

let id3op=abs(@m.xm3.m0[id])
let gm3op=@m.xm3.m0[gm]
let gmb3op=@m.xm3.m0[gmbs]
let gds3op=@m.xm3.m0[gds]
let vgs3op=@m.xm3.m0[vgs]
let vds3op=@m.xm3.m0[vds]
let vbs3op=@m.xm3.m0[vbs]
let vth3op=@m.xm3.m0[vth]
let vov3op=vgs3op-vth3op
let vdsat3op=abs(@m.xm3.m0[vdsat])
let sat3op=vds3op-vdsat3op
let gmid3op=gm3op/(id3op+1e-30)
let ro3op=1/(gds3op+1e-30)

let id4op=abs(@m.xm4.m0[id])
let gm4op=@m.xm4.m0[gm]
let gmb4op=@m.xm4.m0[gmbs]
let gds4op=@m.xm4.m0[gds]
let vgs4op=@m.xm4.m0[vgs]
let vds4op=@m.xm4.m0[vds]
let vbs4op=@m.xm4.m0[vbs]
let vth4op=@m.xm4.m0[vth]
let vov4op=vgs4op-vth4op
let vdsat4op=abs(@m.xm4.m0[vdsat])
let sat4op=vds4op-vdsat4op
let gmid4op=gm4op/(id4op+1e-30)
let ro4op=1/(gds4op+1e-30)

let id5op=abs(@m.xm5.m0[id])
let gm5op=@m.xm5.m0[gm]
let gmb5op=@m.xm5.m0[gmbs]
let gds5op=@m.xm5.m0[gds]
let vgs5op=@m.xm5.m0[vgs]
let vds5op=@m.xm5.m0[vds]
let vbs5op=@m.xm5.m0[vbs]
let vth5op=@m.xm5.m0[vth]
let vov5op=vgs5op-vth5op
let vdsat5op=abs(@m.xm5.m0[vdsat])
let sat5op=vds5op-vdsat5op
let gmid5op=gm5op/(id5op+1e-30)
let ro5op=1/(gds5op+1e-30)

let id6op=abs(@m.xm6.m0[id])
let gm6op=@m.xm6.m0[gm]
let gmb6op=@m.xm6.m0[gmbs]
let gds6op=@m.xm6.m0[gds]
let vgs6op=@m.xm6.m0[vgs]
let vds6op=@m.xm6.m0[vds]
let vbs6op=@m.xm6.m0[vbs]
let vth6op=@m.xm6.m0[vth]
let vov6op=vgs6op-vth6op
let vdsat6op=abs(@m.xm6.m0[vdsat])
let sat6op=vds6op-vdsat6op
let gmid6op=gm6op/(id6op+1e-30)
let ro6op=1/(gds6op+1e-30)

let id7op=abs(@m.xm7.m0[id])
let gm7op=@m.xm7.m0[gm]
let gmb7op=@m.xm7.m0[gmbs]
let gds7op=@m.xm7.m0[gds]
let vgs7op=@m.xm7.m0[vgs]
let vds7op=@m.xm7.m0[vds]
let vbs7op=@m.xm7.m0[vbs]
let vth7op=@m.xm7.m0[vth]
let vov7op=vgs7op-vth7op
let vdsat7op=abs(@m.xm7.m0[vdsat])
let sat7op=vds7op-vdsat7op
let gmid7op=gm7op/(id7op+1e-30)
let ro7op=1/(gds7op+1e-30)

let vnet9op=vnet3op+vds1op
let vnet9check=vnet8op-vds4op
let vnet9diff=vnet9op-vnet9check
let vnet10op=vsop+vds2op
let vnet10check=vdop-vds7op
let vnet10diff=vnet10op-vnet10check

set op_pdc=$&pdcop
set op_icore=$&icoreop
set op_iio=$&iioop
set op_vs=$&vsop
set op_vnet10=$&vnet10op
set op_vnet10check=$&vnet10check
set op_vnet10diff=$&vnet10diff
set op_vd=$&vdop
set op_vnet3=$&vnet3op
set op_vnet9=$&vnet9op
set op_vnet9check=$&vnet9check
set op_vnet9diff=$&vnet9diff
set op_vnet8=$&vnet8op
set op_vbuf=$&vbufop
set op_vgcs=$&vgcsop
set op_vgcg=$&vgcgop

set op_id1=$&id1op
set op_gm1=$&gm1op
set op_gmb1=$&gmb1op
set op_gds1=$&gds1op
set op_vgs1=$&vgs1op
set op_vds1=$&vds1op
set op_vbs1=$&vbs1op
set op_vth1=$&vth1op
set op_vov1=$&vov1op
set op_vdsat1=$&vdsat1op
set op_sat1=$&sat1op
