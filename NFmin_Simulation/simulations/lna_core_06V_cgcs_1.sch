set op_ro4=$&ro4op

set op_id5=$&id5op
set op_gm5=$&gm5op
set op_gmb5=$&gmb5op
set op_gds5=$&gds5op
set op_vgs5=$&vgs5op
set op_vds5=$&vds5op
