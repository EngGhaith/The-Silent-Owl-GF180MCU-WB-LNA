        echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo STAGE_B_POINT RD $rdv COUT $coutv CSHOUT $cshoutv W3 $A_best_w3 W6 $A_best_w6 VB3 $A_best_vb3 VBCAS $A_best_vb6 >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo OP PDC_mW $op_pdc VSCG $op_vscg VDCG $op_vdcg NET7 $op_v7 NET8 $op_v8 GBUF $op_vg3 SOURCE3 $op_vs3 INTERNAL_X $op_vx OUTPUT_DC $op_vout XM1_ID $op_id1 XM1_GM $op_gm1 XM1_GDS $op_gds1 XM1_VDS $op_vds1 XM1_VDSAT $op_vdsat1 XM1_MARGIN $op_sat1 XM2_ID $op_id2 XM2_GM $op_gm2 XM2_GMB $op_gmb2 XM2_GMEFF $op_gm2eff XM2_GDS $op_gds2 XM2_VDS $op_vds2 XM2_VDSAT $op_vdsat2 XM2_MARGIN $op_sat2 XM3_ID $op_id3 XM3_GM $op_gm3 XM3_GMB $op_gmb3 XM3_GDS $op_gds3 XM3_GMID $op_gmid3 XM3_VGS $op_vgs3 XM3_VDS $op_vds3 XM3_VDSAT $op_vdsat3 XM3_MARGIN $op_sat3 XM3_RO $op_ro3 XM4_ID $op_id4 XM4_GM $op_gm4 XM4_GDS $op_gds4 XM4_VDS $op_vds4 XM4_VDSAT $op_vdsat4 XM4_MARGIN $op_sat4 XM5_ID $op_id5 XM5_GM $op_gm5 XM5_GDS $op_gds5 XM5_GMID $op_gmid5 XM5_VDS $op_vds5 XM5_VDSAT $op_vdsat5 XM5_MARGIN $op_sat5 XM5_RO $op_ro5 XM6_ID $op_id6 XM6_GM $op_gm6 XM6_GMB $op_gmb6 XM6_GDS $op_gds6 XM6_GMID $op_gmid6 XM6_VGS $op_vgs6 XM6_VDS $op_vds6 XM6_VDSAT $op_vdsat6 XM6_MARGIN $op_sat6 XM6_RO $op_ro6 GMEFF2_OVER_GM5 $op_ratio25 >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo RF SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall S11W_dB $&s11w S21MIN_dB $&s21m S21MAX_dB $&s21x RIPPLE_dB $&ripple S22W_dB $&s22w NFW_dB $&nfw MU_MIN $&mumin MUP_MIN $&mupmin DELTA_MAX $&dmax AT_2P4 S11_dB $&s11c S21_dB $&s21c S12_dB $&s12c S22_dB $&s22c NF_dB $&nfc ZIN_RE $&zinrc ZIN_IM $&zinic ZOUT_RE $&zoutrc ZOUT_IM $&zoutic >> lna_v22_cs_cascode_driver_corrected_detailed.txt



        echo $rdv $coutv $cshoutv $&score $&dcvalid $&passcount $&passall $op_pdc $op_vx $op_vout $op_id3 $op_gm3 $op_sat3 $op_id6 $op_gm6 $op_sat6 $&s11w $&s21m $&s21x $&ripple $&s22w $&nfw $&mumin $&mupmin $&dmax >> lna_v22_cs_cascode_driver_corrected_summary.txt



        if score < $B_best_score

  set B_best_score = $&score

  set B_best_rd = $rdv

  set B_best_cout = $coutv

  set B_best_cshout = $cshoutv

  set B_best_passall = $&passall

end



        destroy $curplot



end

  end

end

echo STAGE_B_BEST SCORE $B_best_score RD $B_best_rd COUT $B_best_cout CSHOUT $B_best_cshout PASSALL $B_best_passall >> lna_v22_cs_cascode_driver_corrected_summary.txt



* =============================================================================

* STAGE C — SOURCE RC EQUALIZATION

* 5 RS x 7 CS = 35 points.

* =============================================================================

set C_best_score = 1e99

set C_best_rs = 0.5

set C_best_cs = 100p

set C_best_passall = 0



echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_C_SOURCE_RC_EQUALIZATION >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo RS CS SCORE DCVALID PASSCOUNT PASSALL PDC VS3 VX VOUT ID3 GM3 SAT3 ID6 GM6 SAT6 S11W S21MIN S21MAX RIPPLE S22W NFW MU MUP DELTA >> lna_v22_cs_cascode_driver_corrected_summary.txt



foreach rsv 0.5 2 5 10 15

  foreach csv 2.2p 3.3p 4.7p 6.8p 10p 15p 100p

    alterparam W_SF = $A_best_w3

    alterparam W_SF_CAS = $A_best_w6

    alterparam VBIAS_BUF = $A_best_vb3

    alterparam VBIAS_CAS_BUF = $A_best_vb6

    alterparam RD_OUT = $B_best_rd

    alterparam RS_OUT = $rsv

    alterparam CSOUT_VAL = $csv

    alterparam COUT_VAL = $B_best_cout

    alterparam C_SH_OUT = $B_best_cshout

    alterparam L_IN = 2.0n

    alterparam C_SH_IN = 1f



reset

        op



        * ----- DC operating point -----

        let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))

        let vscgop = v(s)

        let vdcgop = v(d)

        let v7op = v(net7)

        let v8op = v(net8)

        let vg3op = v(g_buf)

        let vs3op = v(net3)

        let vxop = v(net9)

        let voutop = v(vbuf)



        let id1op = abs(@m.xm1.m0[id])

        let gm1op = @m.xm1.m0[gm]

        let gds1op = @m.xm1.m0[gds]

        let vds1op = v(net7)

        let vdsat1op = abs(@m.xm1.m0[vdsat])

        let sat1op = vds1op-vdsat1op



        let id2op = abs(@m.xm2.m0[id])

        let gm2op = @m.xm2.m0[gm]

        let gmb2op = @m.xm2.m0[gmbs]

        let gm2effop = gm2op+gmb2op

        let gds2op = @m.xm2.m0[gds]

        let vds2op = v(d)-v(s)

        let vdsat2op = abs(@m.xm2.m0[vdsat])

        let sat2op = vds2op-vdsat2op



        let id3op = abs(@m.xm3.m0[id])

        let gm3op = @m.xm3.m0[gm]

        let gmb3op = @m.xm3.m0[gmbs]

        let gds3op = @m.xm3.m0[gds]

        let gmid3op = gm3op/id3op

        let vgs3op = v(g_buf)-v(net3)

        let vds3op = v(net9)-v(net3)

        let vdsat3op = abs(@m.xm3.m0[vdsat])

        let sat3op = vds3op-vdsat3op

        let ro3op = 1/gds3op



        let id4op = abs(@m.xm4.m0[id])

        let gm4op = @m.xm4.m0[gm]

        let gds4op = @m.xm4.m0[gds]

        let vds4op = v(net8)-v(net7)

        let vdsat4op = abs(@m.xm4.m0[vdsat])

        let sat4op = vds4op-vdsat4op



        let id5op = abs(@m.xm5.m0[id])

        let gm5op = @m.xm5.m0[gm]

        let gds5op = @m.xm5.m0[gds]

        let gmid5op = gm5op/id5op

        let vds5op = v(s)

        let vdsat5op = abs(@m.xm5.m0[vdsat])

        let sat5op = vds5op-vdsat5op

        let ro5op = 1/gds5op



        let id6op = abs(@m.xm6.m0[id])

        let gm6op = @m.xm6.m0[gm]

        let gmb6op = @m.xm6.m0[gmbs]

        let gds6op = @m.xm6.m0[gds]

        let gmid6op = gm6op/id6op

        let vgs6op = v(vbias_cas_buf)-v(net9)

        let vds6op = v(vbuf)-v(net9)

        let vdsat6op = abs(@m.xm6.m0[vdsat])

        let sat6op = vds6op-vdsat6op

        let ro6op = 1/gds6op



        let ratio25op = gm2effop/gm5op



        set op_pdc = $&pdcop

        set op_vscg = $&vscgop

        set op_vdcg = $&vdcgop

        set op_v7 = $&v7op

        set op_v8 = $&v8op

        set op_vg3 = $&vg3op

        set op_vs3 = $&vs3op

        set op_vx = $&vxop

        set op_vout = $&voutop



        set op_id1 = $&id1op

        set op_gm1 = $&gm1op

        set op_gds1 = $&gds1op

        set op_vds1 = $&vds1op

        set op_vdsat1 = $&vdsat1op

        set op_sat1 = $&sat1op



        set op_id2 = $&id2op

        set op_gm2 = $&gm2op

        set op_gmb2 = $&gmb2op

        set op_gm2eff = $&gm2effop

        set op_gds2 = $&gds2op

        set op_vds2 = $&vds2op

        set op_vdsat2 = $&vdsat2op

        set op_sat2 = $&sat2op



        set op_id3 = $&id3op

        set op_gm3 = $&gm3op

        set op_gmb3 = $&gmb3op

        set op_gds3 = $&gds3op

        set op_gmid3 = $&gmid3op

        set op_vgs3 = $&vgs3op

        set op_vds3 = $&vds3op

        set op_vdsat3 = $&vdsat3op

        set op_sat3 = $&sat3op

        set op_ro3 = $&ro3op



        set op_id4 = $&id4op

        set op_gm4 = $&gm4op

        set op_gds4 = $&gds4op

        set op_vds4 = $&vds4op

        set op_vdsat4 = $&vdsat4op

        set op_sat4 = $&sat4op



        set op_id5 = $&id5op

        set op_gm5 = $&gm5op

        set op_gds5 = $&gds5op

        set op_gmid5 = $&gmid5op

        set op_vds5 = $&vds5op

        set op_vdsat5 = $&vdsat5op

        set op_sat5 = $&sat5op

        set op_ro5 = $&ro5op



        set op_id6 = $&id6op

        set op_gm6 = $&gm6op

        set op_gmb6 = $&gmb6op

        set op_gds6 = $&gds6op

        set op_gmid6 = $&gmid6op

        set op_vgs6 = $&vgs6op

        set op_vds6 = $&vds6op

        set op_vdsat6 = $&vdsat6op

        set op_sat6 = $&sat6op

        set op_ro6 = $&ro6op

        set op_ratio25 = $&ratio25op



        destroy $curplot



        * ----- RF/noise/stability over target band -----

        sp lin 51 2.30G 2.50G 1

        let s11db = db(s_1_1)

        let s21db = db(s_2_1)

        let s12db = db(s_1_2)

        let s22db = db(s_2_2)

        let nfdb = real(NF)



        let delta = s_1_1*s_2_2-s_1_2*s_2_1

        let md = mag(delta)

        let a11 = mag(s_1_1)

        let a12 = mag(s_1_2)

        let a21 = mag(s_2_1)

        let a22 = mag(s_2_2)

        let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))

        let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

        let kval = (1-a11*a11-a22*a22+md*md)/(2*a12*a21)



        let zin = 50*(1+s_1_1)/(1-s_1_1)

        let zout = 50*(1+s_2_2)/(1-s_2_2)

        let zin_re = real(zin)

        let zin_im = imag(zin)

        let zout_re = real(zout)

        let zout_im = imag(zout)



        let s11w = maximum(s11db)

        let s21m = minimum(s21db)

        let s21x = maximum(s21db)

        let ripple = s21x-s21m

        let s22w = maximum(s22db)

        let nfw = maximum(nfdb)

        let mumin = minimum(mu)

        let mupmin = minimum(mup)

        let dmax = maximum(md)



        let s11c = s11db[25]

        let s21c = s21db[25]

        let s12c = s12db[25]

        let s22c = s22db[25]

        let nfc = nfdb[25]

        let zinrc = zin_re[25]

        let zinic = zin_im[25]

        let zoutrc = zout_re[25]

        let zoutic = zout_im[25]



        * ----- Formal score -----

        let penalty_gain = 0

        let penalty_nf = 0

        let penalty_ripple = 0

        let penalty_s11 = 0

        let penalty_s22 = 0

        let penalty_pdc = 0

        let penalty_mu = 0

        let penalty_mup = 0

        let penalty_delta = 0

        let passcount = 0



        if s21m < target_gain

          let penalty_gain = target_gain-s21m

        else

          let passcount = passcount+1

        end

        if nfw > target_nf

          let penalty_nf = nfw-target_nf

        else

          let passcount = passcount+1

        end

        if ripple > target_ripple

          let penalty_ripple = ripple-target_ripple

        else

          let passcount = passcount+1

        end

        if s11w > target_s11

          let penalty_s11 = s11w-target_s11

        else

          let passcount = passcount+1

        end

        if s22w > target_s22

          let penalty_s22 = s22w-target_s22

        else

          let passcount = passcount+1

        end

        if $op_pdc > target_pdc

          let penalty_pdc = $op_pdc-target_pdc

        else

          let passcount = passcount+1

        end

        if mumin < target_mu

          let penalty_mu = target_mu-mumin

        else

          let passcount = passcount+1

        end

        if mupmin < target_mu

          let penalty_mup = target_mu-mupmin

        else

          let passcount = passcount+1

        end

        if dmax >= target_delta

          let penalty_delta = dmax-target_delta+0.001

        else

          let passcount = passcount+1

        end



        let score = 320*penalty_gain+280*penalty_nf+180*penalty_ripple

        let score = score+35*penalty_s11+35*penalty_s22+2*penalty_pdc

        let score = score+300*penalty_mu+300*penalty_mup+600*penalty_delta

        let score = score+5*nfw-3*s21m+2*ripple+0.004*$op_pdc



        * Do not force very high gm; V20 showed capacitance can dominate.

        let penalty_gm3 = 0

        if $op_gm3 < 0.020

          let penalty_gm3 = 1000*(0.020-$op_gm3)

        end

        let score = score+5*penalty_gm3



        * Prefer a reasonably strong upper cascode without making it a hard RF constraint.

        let penalty_gm6 = 0

        if $op_gm6 < 0.015

          let penalty_gm6 = 1000*(0.015-$op_gm6)

        end

        let score = score+3*penalty_gm6



        * ----- Hard DC validity -----

        let dcvalid = 1

        if $op_pdc > target_pdc

          let dcvalid = 0

        end

        if $op_sat1 < min_satmargin_core

          let dcvalid = 0

        end

        if $op_sat2 < min_satmargin_cg

          let dcvalid = 0

        end

        if $op_sat4 < min_satmargin_core

          let dcvalid = 0

        end

        if $op_sat5 < min_satmargin_sink

          let dcvalid = 0

        end

        if $op_id5 < 0.0025

          let dcvalid = 0

        end

        if $op_id5 > 0.0060

          let dcvalid = 0

        end



        if $op_id3 < 0.008

          let dcvalid = 0

        end

        if $op_id3 > 0.030

          let dcvalid = 0

        end

        if $op_id6 < 0.008

          let dcvalid = 0

        end

        if $op_id6 > 0.030

          let dcvalid = 0

        end

        if $op_sat3 < min_satmargin_out_cs

          let dcvalid = 0

        end

        if $op_sat6 < min_satmargin_out_cas

          let dcvalid = 0

        end

        if $op_vs3 < 0

          let dcvalid = 0

        end

        if $op_vs3 > 0.50

          let dcvalid = 0

        end

        if $op_vx < 0.70

          let dcvalid = 0

        end

        if $op_vx > 2.30

          let dcvalid = 0

        end

        if $op_vout < 2.20

          let dcvalid = 0

        end

        if $op_vout > 4.50

          let dcvalid = 0

        end

        if $op_vout <= $op_vx

          let dcvalid = 0

        end

        if $op_vx <= $op_vs3

          let dcvalid = 0

        end



        let penalty_ratio = 0

        if $op_ratio25 < 3.0

          let penalty_ratio = 3.0-$op_ratio25

        end

        let penalty_gm5 = 0

        if $op_gm5 > 0.0065

          let penalty_gm5 = 1000*($op_gm5-0.0065)

        end

        let penalty_gds5 = 0

        if $op_gds5 > 0.0004

          let penalty_gds5 = 1000*($op_gds5-0.0004)

        end

        let score = score+30*penalty_ratio+10*penalty_gm5+20*penalty_gds5



        if dcvalid = 0

          let score = score+10000

        end



        let passall = 1

        if passcount < 9

          let passall = 0

        end

        if dcvalid = 0

          let passall = 0

        end



        echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo STAGE_C_POINT RS $rsv CS $csv RD $B_best_rd COUT $B_best_cout CSHOUT $B_best_cshout >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo OP PDC_mW $op_pdc VSCG $op_vscg VDCG $op_vdcg NET7 $op_v7 NET8 $op_v8 GBUF $op_vg3 SOURCE3 $op_vs3 INTERNAL_X $op_vx OUTPUT_DC $op_vout XM1_ID $op_id1 XM1_GM $op_gm1 XM1_GDS $op_gds1 XM1_VDS $op_vds1 XM1_VDSAT $op_vdsat1 XM1_MARGIN $op_sat1 XM2_ID $op_id2 XM2_GM $op_gm2 XM2_GMB $op_gmb2 XM2_GMEFF $op_gm2eff XM2_GDS $op_gds2 XM2_VDS $op_vds2 XM2_VDSAT $op_vdsat2 XM2_MARGIN $op_sat2 XM3_ID $op_id3 XM3_GM $op_gm3 XM3_GMB $op_gmb3 XM3_GDS $op_gds3 XM3_GMID $op_gmid3 XM3_VGS $op_vgs3 XM3_VDS $op_vds3 XM3_VDSAT $op_vdsat3 XM3_MARGIN $op_sat3 XM3_RO $op_ro3 XM4_ID $op_id4 XM4_GM $op_gm4 XM4_GDS $op_gds4 XM4_VDS $op_vds4 XM4_VDSAT $op_vdsat4 XM4_MARGIN $op_sat4 XM5_ID $op_id5 XM5_GM $op_gm5 XM5_GDS $op_gds5 XM5_GMID $op_gmid5 XM5_VDS $op_vds5 XM5_VDSAT $op_vdsat5 XM5_MARGIN $op_sat5 XM5_RO $op_ro5 XM6_ID $op_id6 XM6_GM $op_gm6 XM6_GMB $op_gmb6 XM6_GDS $op_gds6 XM6_GMID $op_gmid6 XM6_VGS $op_vgs6 XM6_VDS $op_vds6 XM6_VDSAT $op_vdsat6 XM6_MARGIN $op_sat6 XM6_RO $op_ro6 GMEFF2_OVER_GM5 $op_ratio25 >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo RF SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall S11W_dB $&s11w S21MIN_dB $&s21m S21MAX_dB $&s21x RIPPLE_dB $&ripple S22W_dB $&s22w NFW_dB $&nfw MU_MIN $&mumin MUP_MIN $&mupmin DELTA_MAX $&dmax AT_2P4 S11_dB $&s11c S21_dB $&s21c S12_dB $&s12c S22_dB $&s22c NF_dB $&nfc ZIN_RE $&zinrc ZIN_IM $&zinic ZOUT_RE $&zoutrc ZOUT_IM $&zoutic >> lna_v22_cs_cascode_driver_corrected_detailed.txt



        echo $rsv $csv $&score $&dcvalid $&passcount $&passall $op_pdc $op_vs3 $op_vx $op_vout $op_id3 $op_gm3 $op_sat3 $op_id6 $op_gm6 $op_sat6 $&s11w $&s21m $&s21x $&ripple $&s22w $&nfw $&mumin $&mupmin $&dmax >> lna_v22_cs_cascode_driver_corrected_summary.txt



        if score < $C_best_score

  set C_best_score = $&score

  set C_best_rs = $rsv

  set C_best_cs = $csv

  set C_best_passall = $&passall

end



        destroy $curplot



end

end

echo STAGE_C_BEST SCORE $C_best_score RS $C_best_rs CS $C_best_cs PASSALL $C_best_passall >> lna_v22_cs_cascode_driver_corrected_summary.txt



* =============================================================================

* STAGE D — INPUT MATCH, MAXIMUM INTENTIONAL L = 2 nH

* 6 LIN x 4 CSHIN = 24 points.

* =============================================================================

set D_best_score = 1e99

set D_best_lin = 2.0n

set D_best_cshin = 1f

set D_best_passall = 0



echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_D_INPUT_MATCH >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo LIN CSHIN SCORE DCVALID PASSCOUNT PASSALL PDC S11W S21MIN S21MAX RIPPLE S22W NFW MU MUP DELTA >> lna_v22_cs_cascode_driver_corrected_summary.txt



foreach linv 1.0n 1.2n 1.4n 1.6n 1.8n 2.0n

  foreach cshinv 1f 50f 100f 200f

    alterparam W_SF = $A_best_w3

    alterparam W_SF_CAS = $A_best_w6

    alterparam VBIAS_BUF = $A_best_vb3

    alterparam VBIAS_CAS_BUF = $A_best_vb6

    alterparam RD_OUT = $B_best_rd

    alterparam RS_OUT = $C_best_rs

    alterparam CSOUT_VAL = $C_best_cs

    alterparam COUT_VAL = $B_best_cout

    alterparam C_SH_OUT = $B_best_cshout

    alterparam L_IN = $linv

    alterparam C_SH_IN = $cshinv



reset

        op



        * ----- DC operating point -----

        let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))

        let vscgop = v(s)

        let vdcgop = v(d)

        let v7op = v(net7)

        let v8op = v(net8)

        let vg3op = v(g_buf)

        let vs3op = v(net3)

        let vxop = v(net9)

        let voutop = v(vbuf)



        let id1op = abs(@m.xm1.m0[id])

        let gm1op = @m.xm1.m0[gm]

        let gds1op = @m.xm1.m0[gds]

        let vds1op = v(net7)

        let vdsat1op = abs(@m.xm1.m0[vdsat])

        let sat1op = vds1op-vdsat1op



        let id2op = abs(@m.xm2.m0[id])

        let gm2op = @m.xm2.m0[gm]

        let gmb2op = @m.xm2.m0[gmbs]

        let gm2effop = gm2op+gmb2op

        let gds2op = @m.xm2.m0[gds]

        let vds2op = v(d)-v(s)

        let vdsat2op = abs(@m.xm2.m0[vdsat])

        let sat2op = vds2op-vdsat2op



        let id3op = abs(@m.xm3.m0[id])

        let gm3op = @m.xm3.m0[gm]

        let gmb3op = @m.xm3.m0[gmbs]

        let gds3op = @m.xm3.m0[gds]

        let gmid3op = gm3op/id3op

        let vgs3op = v(g_buf)-v(net3)

        let vds3op = v(net9)-v(net3)

        let vdsat3op = abs(@m.xm3.m0[vdsat])

        let sat3op = vds3op-vdsat3op

        let ro3op = 1/gds3op



        let id4op = abs(@m.xm4.m0[id])

        let gm4op = @m.xm4.m0[gm]

        let gds4op = @m.xm4.m0[gds]

        let vds4op = v(net8)-v(net7)

        let vdsat4op = abs(@m.xm4.m0[vdsat])

        let sat4op = vds4op-vdsat4op



        let id5op = abs(@m.xm5.m0[id])

        let gm5op = @m.xm5.m0[gm]

        let gds5op = @m.xm5.m0[gds]

        let gmid5op = gm5op/id5op

        let vds5op = v(s)

        let vdsat5op = abs(@m.xm5.m0[vdsat])

        let sat5op = vds5op-vdsat5op

        let ro5op = 1/gds5op



        let id6op = abs(@m.xm6.m0[id])

        let gm6op = @m.xm6.m0[gm]

        let gmb6op = @m.xm6.m0[gmbs]

        let gds6op = @m.xm6.m0[gds]

        let gmid6op = gm6op/id6op

        let vgs6op = v(vbias_cas_buf)-v(net9)

        let vds6op = v(vbuf)-v(net9)

        let vdsat6op = abs(@m.xm6.m0[vdsat])

        let sat6op = vds6op-vdsat6op

        let ro6op = 1/gds6op



        let ratio25op = gm2effop/gm5op



        set op_pdc = $&pdcop

        set op_vscg = $&vscgop

        set op_vdcg = $&vdcgop

        set op_v7 = $&v7op

        set op_v8 = $&v8op

        set op_vg3 = $&vg3op

        set op_vs3 = $&vs3op

        set op_vx = $&vxop

        set op_vout = $&voutop



        set op_id1 = $&id1op

        set op_gm1 = $&gm1op

        set op_gds1 = $&gds1op

        set op_vds1 = $&vds1op

        set op_vdsat1 = $&vdsat1op

        set op_sat1 = $&sat1op



        set op_id2 = $&id2op

        set op_gm2 = $&gm2op

        set op_gmb2 = $&gmb2op

        set op_gm2eff = $&gm2effop

        set op_gds2 = $&gds2op

        set op_vds2 = $&vds2op

        set op_vdsat2 = $&vdsat2op

        set op_sat2 = $&sat2op



        set op_id3 = $&id3op

        set op_gm3 = $&gm3op

        set op_gmb3 = $&gmb3op

        set op_gds3 = $&gds3op

        set op_gmid3 = $&gmid3op

        set op_vgs3 = $&vgs3op

        set op_vds3 = $&vds3op

        set op_vdsat3 = $&vdsat3op

        set op_sat3 = $&sat3op

        set op_ro3 = $&ro3op



        set op_id4 = $&id4op

        set op_gm4 = $&gm4op

        set op_gds4 = $&gds4op

        set op_vds4 = $&vds4op

        set op_vdsat4 = $&vdsat4op

        set op_sat4 = $&sat4op



        set op_id5 = $&id5op

        set op_gm5 = $&gm5op

        set op_gds5 = $&gds5op

        set op_gmid5 = $&gmid5op

        set op_vds5 = $&vds5op

        set op_vdsat5 = $&vdsat5op

        set op_sat5 = $&sat5op

        set op_ro5 = $&ro5op



        set op_id6 = $&id6op

        set op_gm6 = $&gm6op

        set op_gmb6 = $&gmb6op

        set op_gds6 = $&gds6op

        set op_gmid6 = $&gmid6op

        set op_vgs6 = $&vgs6op

        set op_vds6 = $&vds6op

        set op_vdsat6 = $&vdsat6op

        set op_sat6 = $&sat6op

        set op_ro6 = $&ro6op

        set op_ratio25 = $&ratio25op



        destroy $curplot



        * ----- RF/noise/stability over target band -----

        sp lin 51 2.30G 2.50G 1

        let s11db = db(s_1_1)

        let s21db = db(s_2_1)

        let s12db = db(s_1_2)

        let s22db = db(s_2_2)

        let nfdb = real(NF)



        let delta = s_1_1*s_2_2-s_1_2*s_2_1

        let md = mag(delta)

        let a11 = mag(s_1_1)

        let a12 = mag(s_1_2)

        let a21 = mag(s_2_1)

        let a22 = mag(s_2_2)

        let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))

        let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

        let kval = (1-a11*a11-a22*a22+md*md)/(2*a12*a21)



        let zin = 50*(1+s_1_1)/(1-s_1_1)

        let zout = 50*(1+s_2_2)/(1-s_2_2)

        let zin_re = real(zin)

        let zin_im = imag(zin)

        let zout_re = real(zout)

        let zout_im = imag(zout)



        let s11w = maximum(s11db)

        let s21m = minimum(s21db)

        let s21x = maximum(s21db)

        let ripple = s21x-s21m

        let s22w = maximum(s22db)

        let nfw = maximum(nfdb)

        let mumin = minimum(mu)

        let mupmin = minimum(mup)

        let dmax = maximum(md)



        let s11c = s11db[25]

        let s21c = s21db[25]

        let s12c = s12db[25]

        let s22c = s22db[25]

        let nfc = nfdb[25]

        let zinrc = zin_re[25]

        let zinic = zin_im[25]

        let zoutrc = zout_re[25]

        let zoutic = zout_im[25]



        * ----- Formal score -----

        let penalty_gain = 0

        let penalty_nf = 0

        let penalty_ripple = 0

        let penalty_s11 = 0

        let penalty_s22 = 0

        let penalty_pdc = 0

        let penalty_mu = 0

        let penalty_mup = 0

        let penalty_delta = 0

        let passcount = 0



        if s21m < target_gain

          let penalty_gain = target_gain-s21m

        else

          let passcount = passcount+1

        end

        if nfw > target_nf

          let penalty_nf = nfw-target_nf

        else

          let passcount = passcount+1

        end

        if ripple > target_ripple

          let penalty_ripple = ripple-target_ripple

        else

          let passcount = passcount+1

        end

        if s11w > target_s11

          let penalty_s11 = s11w-target_s11

        else

          let passcount = passcount+1

        end

        if s22w > target_s22

          let penalty_s22 = s22w-target_s22

        else

          let passcount = passcount+1

        end

        if $op_pdc > target_pdc

          let penalty_pdc = $op_pdc-target_pdc

        else

          let passcount = passcount+1

        end

        if mumin < target_mu

          let penalty_mu = target_mu-mumin

        else

          let passcount = passcount+1

        end

        if mupmin < target_mu

          let penalty_mup = target_mu-mupmin

        else

          let passcount = passcount+1

        end

        if dmax >= target_delta

          let penalty_delta = dmax-target_delta+0.001

        else

          let passcount = passcount+1

        end



        let score = 320*penalty_gain+280*penalty_nf+180*penalty_ripple

        let score = score+35*penalty_s11+35*penalty_s22+2*penalty_pdc

        let score = score+300*penalty_mu+300*penalty_mup+600*penalty_delta

        let score = score+5*nfw-3*s21m+2*ripple+0.004*$op_pdc



        * Do not force very high gm; V20 showed capacitance can dominate.

        let penalty_gm3 = 0

        if $op_gm3 < 0.020

          let penalty_gm3 = 1000*(0.020-$op_gm3)

        end

        let score = score+5*penalty_gm3



        * Prefer a reasonably strong upper cascode without making it a hard RF constraint.

        let penalty_gm6 = 0

        if $op_gm6 < 0.015

          let penalty_gm6 = 1000*(0.015-$op_gm6)

        end

        let score = score+3*penalty_gm6



        * ----- Hard DC validity -----

        let dcvalid = 1

        if $op_pdc > target_pdc

          let dcvalid = 0

        end

        if $op_sat1 < min_satmargin_core

          let dcvalid = 0

        end

        if $op_sat2 < min_satmargin_cg

          let dcvalid = 0

        end

        if $op_sat4 < min_satmargin_core

          let dcvalid = 0

        end

        if $op_sat5 < min_satmargin_sink

          let dcvalid = 0

        end

        if $op_id5 < 0.0025

          let dcvalid = 0

        end

        if $op_id5 > 0.0060

          let dcvalid = 0

        end



        if $op_id3 < 0.008

          let dcvalid = 0

        end

        if $op_id3 > 0.030

          let dcvalid = 0

        end

        if $op_id6 < 0.008

          let dcvalid = 0

        end

        if $op_id6 > 0.030

          let dcvalid = 0

        end

        if $op_sat3 < min_satmargin_out_cs

          let dcvalid = 0

        end

        if $op_sat6 < min_satmargin_out_cas

          let dcvalid = 0

        end

        if $op_vs3 < 0

          let dcvalid = 0

        end

        if $op_vs3 > 0.50

          let dcvalid = 0

        end

        if $op_vx < 0.70

          let dcvalid = 0

        end

        if $op_vx > 2.30

          let dcvalid = 0

        end

        if $op_vout < 2.20

          let dcvalid = 0

        end

        if $op_vout > 4.50

          let dcvalid = 0

        end

        if $op_vout <= $op_vx

          let dcvalid = 0

        end

        if $op_vx <= $op_vs3

          let dcvalid = 0

        end



        let penalty_ratio = 0

        if $op_ratio25 < 3.0

          let penalty_ratio = 3.0-$op_ratio25

        end

        let penalty_gm5 = 0

        if $op_gm5 > 0.0065

          let penalty_gm5 = 1000*($op_gm5-0.0065)

        end

        let penalty_gds5 = 0

        if $op_gds5 > 0.0004

          let penalty_gds5 = 1000*($op_gds5-0.0004)

        end

        let score = score+30*penalty_ratio+10*penalty_gm5+20*penalty_gds5



        if dcvalid = 0

          let score = score+10000

        end



        let passall = 1

        if passcount < 9

          let passall = 0

        end

        if dcvalid = 0

          let passall = 0

        end



        echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo STAGE_D_POINT LIN $linv CSHIN $cshinv >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo OP PDC_mW $op_pdc VSCG $op_vscg VDCG $op_vdcg NET7 $op_v7 NET8 $op_v8 GBUF $op_vg3 SOURCE3 $op_vs3 INTERNAL_X $op_vx OUTPUT_DC $op_vout XM1_ID $op_id1 XM1_GM $op_gm1 XM1_GDS $op_gds1 XM1_VDS $op_vds1 XM1_VDSAT $op_vdsat1 XM1_MARGIN $op_sat1 XM2_ID $op_id2 XM2_GM $op_gm2 XM2_GMB $op_gmb2 XM2_GMEFF $op_gm2eff XM2_GDS $op_gds2 XM2_VDS $op_vds2 XM2_VDSAT $op_vdsat2 XM2_MARGIN $op_sat2 XM3_ID $op_id3 XM3_GM $op_gm3 XM3_GMB $op_gmb3 XM3_GDS $op_gds3 XM3_GMID $op_gmid3 XM3_VGS $op_vgs3 XM3_VDS $op_vds3 XM3_VDSAT $op_vdsat3 XM3_MARGIN $op_sat3 XM3_RO $op_ro3 XM4_ID $op_id4 XM4_GM $op_gm4 XM4_GDS $op_gds4 XM4_VDS $op_vds4 XM4_VDSAT $op_vdsat4 XM4_MARGIN $op_sat4 XM5_ID $op_id5 XM5_GM $op_gm5 XM5_GDS $op_gds5 XM5_GMID $op_gmid5 XM5_VDS $op_vds5 XM5_VDSAT $op_vdsat5 XM5_MARGIN $op_sat5 XM5_RO $op_ro5 XM6_ID $op_id6 XM6_GM $op_gm6 XM6_GMB $op_gmb6 XM6_GDS $op_gds6 XM6_GMID $op_gmid6 XM6_VGS $op_vgs6 XM6_VDS $op_vds6 XM6_VDSAT $op_vdsat6 XM6_MARGIN $op_sat6 XM6_RO $op_ro6 GMEFF2_OVER_GM5 $op_ratio25 >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo RF SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall S11W_dB $&s11w S21MIN_dB $&s21m S21MAX_dB $&s21x RIPPLE_dB $&ripple S22W_dB $&s22w NFW_dB $&nfw MU_MIN $&mumin MUP_MIN $&mupmin DELTA_MAX $&dmax AT_2P4 S11_dB $&s11c S21_dB $&s21c S12_dB $&s12c S22_dB $&s22c NF_dB $&nfc ZIN_RE $&zinrc ZIN_IM $&zinic ZOUT_RE $&zoutrc ZOUT_IM $&zoutic >> lna_v22_cs_cascode_driver_corrected_detailed.txt



        echo $linv $cshinv $&score $&dcvalid $&passcount $&passall $op_pdc $&s11w $&s21m $&s21x $&ripple $&s22w $&nfw $&mumin $&mupmin $&dmax >> lna_v22_cs_cascode_driver_corrected_summary.txt



        if score < $D_best_score

  set D_best_score = $&score

  set D_best_lin = $linv

  set D_best_cshin = $cshinv

  set D_best_passall = $&passall

end



        destroy $curplot



end

end

echo STAGE_D_BEST SCORE $D_best_score LIN $D_best_lin CSHIN $D_best_cshin PASSALL $D_best_passall >> lna_v22_cs_cascode_driver_corrected_summary.txt



* =============================================================================

* STAGE E — LOCAL CG/XM5 FRONT-END REFINEMENT

* 3 WCG x 3 RD1 x 3 VBCG x 3 VBICG x 3 W5 = 243 points.

* =============================================================================

set E_best_score = 1e99

set E_best_wcg = 130u

set E_best_rd1 = 660

set E_best_vbcg = 2.10

set E_best_vbicg = 1.60

set E_best_w5 = 35u

set E_best_passall = 0



echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_E_FRONT_END_REFINEMENT >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo WCG RD1 VBCG VBICG W5 SCORE DCVALID PASSCOUNT PASSALL PDC ID2 GM2 GMB2 ID5 GM5 GDS5 RATIO S11W S21MIN S21MAX RIPPLE S22W NFW MU MUP DELTA >> lna_v22_cs_cascode_driver_corrected_summary.txt



foreach wcgv 120u 130u 140u

  foreach rd1v 620 660 700

    foreach vbcgv 2.0 2.1 2.2

      foreach vbicgv 1.5 1.6 1.7

        foreach w5v 30u 35u 40u

          alterparam W_CG = $wcgv

          alterparam RD1 = $rd1v

          alterparam VBIAS_CG = $vbcgv

          alterparam VBIAS_ICG = $vbicgv

          alterparam W_BIAS_CG = $w5v



          alterparam W_SF = $A_best_w3

          alterparam W_SF_CAS = $A_best_w6

          alterparam VBIAS_BUF = $A_best_vb3

          alterparam VBIAS_CAS_BUF = $A_best_vb6

          alterparam RD_OUT = $B_best_rd

          alterparam RS_OUT = $C_best_rs

          alterparam CSOUT_VAL = $C_best_cs

          alterparam COUT_VAL = $B_best_cout

          alterparam C_SH_OUT = $B_best_cshout

          alterparam L_IN = $D_best_lin

          alterparam C_SH_IN = $D_best_cshin



reset

        op



        * ----- DC operating point -----

        let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))

        let vscgop = v(s)

        let vdcgop = v(d)

        let v7op = v(net7)

        let v8op = v(net8)

        let vg3op = v(g_buf)

        let vs3op = v(net3)

        let vxop = v(net9)

        let voutop = v(vbuf)



        let id1op = abs(@m.xm1.m0[id])

        let gm1op = @m.xm1.m0[gm]

        let gds1op = @m.xm1.m0[gds]

        let vds1op = v(net7)

        let vdsat1op = abs(@m.xm1.m0[vdsat])

        let sat1op = vds1op-vdsat1op



        let id2op = abs(@m.xm2.m0[id])

        let gm2op = @m.xm2.m0[gm]

        let gmb2op = @m.xm2.m0[gmbs]

        let gm2effop = gm2op+gmb2op

        let gds2op = @m.xm2.m0[gds]

        let vds2op = v(d)-v(s)

        let vdsat2op = abs(@m.xm2.m0[vdsat])

        let sat2op = vds2op-vdsat2op



        let id3op = abs(@m.xm3.m0[id])

        let gm3op = @m.xm3.m0[gm]

        let gmb3op = @m.xm3.m0[gmbs]

        let gds3op = @m.xm3.m0[gds]

        let gmid3op = gm3op/id3op

        let vgs3op = v(g_buf)-v(net3)

        let vds3op = v(net9)-v(net3)

        let vdsat3op = abs(@m.xm3.m0[vdsat])

        let sat3op = vds3op-vdsat3op

        let ro3op = 1/gds3op



        let id4op = abs(@m.xm4.m0[id])

        let gm4op = @m.xm4.m0[gm]

        let gds4op = @m.xm4.m0[gds]

        let vds4op = v(net8)-v(net7)

        let vdsat4op = abs(@m.xm4.m0[vdsat])

        let sat4op = vds4op-vdsat4op



        let id5op = abs(@m.xm5.m0[id])

        let gm5op = @m.xm5.m0[gm]

        let gds5op = @m.xm5.m0[gds]

        let gmid5op = gm5op/id5op

        let vds5op = v(s)

        let vdsat5op = abs(@m.xm5.m0[vdsat])

        let sat5op = vds5op-vdsat5op

        let ro5op = 1/gds5op



        let id6op = abs(@m.xm6.m0[id])

        let gm6op = @m.xm6.m0[gm]

        let gmb6op = @m.xm6.m0[gmbs]

        let gds6op = @m.xm6.m0[gds]

        let gmid6op = gm6op/id6op

        let vgs6op = v(vbias_cas_buf)-v(net9)

        let vds6op = v(vbuf)-v(net9)

        let vdsat6op = abs(@m.xm6.m0[vdsat])

        let sat6op = vds6op-vdsat6op

        let ro6op = 1/gds6op



        let ratio25op = gm2effop/gm5op



        set op_pdc = $&pdcop

        set op_vscg = $&vscgop

        set op_vdcg = $&vdcgop

        set op_v7 = $&v7op

        set op_v8 = $&v8op

