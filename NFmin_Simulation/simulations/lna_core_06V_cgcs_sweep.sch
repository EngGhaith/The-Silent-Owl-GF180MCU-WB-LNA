        set op_vdsat6 = $&vdsat6op

        set op_sat6 = $&sat6op

        set op_ro6 = $&ro6op

        set op_ratio25 = $&ratio25op



        destroy $curplot



        * ----- RF/noise/stability over target band -----

        sp lin 51 2.30G 2.50G 1

        let s11db = db(s_1_1)

        let s21db = db(s_2_1)

        let s12db = db(s_1_2)

        let s22db = db(s_2_2)

        let nfdb = real(NF)



        let delta = s_1_1*s_2_2-s_1_2*s_2_1

        let md = mag(delta)

        let a11 = mag(s_1_1)

        let a12 = mag(s_1_2)

        let a21 = mag(s_2_1)

        let a22 = mag(s_2_2)

        let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))

        let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

        let kval = (1-a11*a11-a22*a22+md*md)/(2*a12*a21)



        let zin = 50*(1+s_1_1)/(1-s_1_1)

        let zout = 50*(1+s_2_2)/(1-s_2_2)

        let zin_re = real(zin)

        let zin_im = imag(zin)

        let zout_re = real(zout)

        let zout_im = imag(zout)



        let s11w = maximum(s11db)

        let s21m = minimum(s21db)

        let s21x = maximum(s21db)

        let ripple = s21x-s21m

        let s22w = maximum(s22db)

        let nfw = maximum(nfdb)

        let mumin = minimum(mu)

        let mupmin = minimum(mup)

        let dmax = maximum(md)



        let s11c = s11db[25]

        let s21c = s21db[25]

        let s12c = s12db[25]

        let s22c = s22db[25]

        let nfc = nfdb[25]

        let zinrc = zin_re[25]

        let zinic = zin_im[25]

        let zoutrc = zout_re[25]

        let zoutic = zout_im[25]



        * ----- Formal score -----

        let penalty_gain = 0

        let penalty_nf = 0

        let penalty_ripple = 0

        let penalty_s11 = 0

        let penalty_s22 = 0

        let penalty_pdc = 0

        let penalty_mu = 0

        let penalty_mup = 0

        let penalty_delta = 0

        let passcount = 0



        if s21m < target_gain

          let penalty_gain = target_gain-s21m

        else

          let passcount = passcount+1

        end

        if nfw > target_nf

          let penalty_nf = nfw-target_nf

        else

          let passcount = passcount+1

        end

        if ripple > target_ripple

          let penalty_ripple = ripple-target_ripple

        else

          let passcount = passcount+1

        end

        if s11w > target_s11

          let penalty_s11 = s11w-target_s11

        else

          let passcount = passcount+1

        end

        if s22w > target_s22

          let penalty_s22 = s22w-target_s22

        else

          let passcount = passcount+1

        end

        if $op_pdc > target_pdc

          let penalty_pdc = $op_pdc-target_pdc

        else

          let passcount = passcount+1

        end

        if mumin < target_mu

          let penalty_mu = target_mu-mumin

        else

          let passcount = passcount+1

        end

        if mupmin < target_mu

          let penalty_mup = target_mu-mupmin

        else

          let passcount = passcount+1

        end

        if dmax >= target_delta

          let penalty_delta = dmax-target_delta+0.001

        else

          let passcount = passcount+1

        end



        let score = 320*penalty_gain+280*penalty_nf+180*penalty_ripple

        let score = score+35*penalty_s11+35*penalty_s22+2*penalty_pdc

        let score = score+300*penalty_mu+300*penalty_mup+600*penalty_delta

        let score = score+5*nfw-3*s21m+2*ripple+0.004*$op_pdc



        * Do not force very high gm; V20 showed capacitance can dominate.

        let penalty_gm3 = 0

        if $op_gm3 < 0.020

          let penalty_gm3 = 1000*(0.020-$op_gm3)

        end

        let score = score+5*penalty_gm3



        * Prefer a reasonably strong upper cascode without making it a hard RF constraint.

        let penalty_gm6 = 0

        if $op_gm6 < 0.015

          let penalty_gm6 = 1000*(0.015-$op_gm6)

        end

        let score = score+3*penalty_gm6



        * ----- Hard DC validity -----

        let dcvalid = 1

        if $op_pdc > target_pdc

          let dcvalid = 0

        end

        if $op_sat1 < min_satmargin_core

          let dcvalid = 0

        end

        if $op_sat2 < min_satmargin_cg

          let dcvalid = 0

        end

        if $op_sat4 < min_satmargin_core

          let dcvalid = 0

        end

        if $op_sat5 < min_satmargin_sink

          let dcvalid = 0

        end

        if $op_id5 < 0.0025

          let dcvalid = 0

        end

        if $op_id5 > 0.0060

          let dcvalid = 0

        end



        if $op_id3 < 0.008

          let dcvalid = 0

        end

        if $op_id3 > 0.030

          let dcvalid = 0

        end

        if $op_id6 < 0.008

          let dcvalid = 0

        end

        if $op_id6 > 0.030

          let dcvalid = 0

        end

        if $op_sat3 < min_satmargin_out_cs

          let dcvalid = 0

        end

        if $op_sat6 < min_satmargin_out_cas

          let dcvalid = 0

        end

        if $op_vs3 < 0

          let dcvalid = 0

        end

        if $op_vs3 > 0.50

          let dcvalid = 0

        end

        if $op_vx < 0.70

          let dcvalid = 0

        end

        if $op_vx > 2.30

          let dcvalid = 0

        end

        if $op_vout < 2.20

          let dcvalid = 0

        end

        if $op_vout > 4.50

          let dcvalid = 0

        end

        if $op_vout <= $op_vx

          let dcvalid = 0

        end

        if $op_vx <= $op_vs3

          let dcvalid = 0

        end



        let penalty_ratio = 0

        if $op_ratio25 < 3.0

          let penalty_ratio = 3.0-$op_ratio25

        end

        let penalty_gm5 = 0

        if $op_gm5 > 0.0065

          let penalty_gm5 = 1000*($op_gm5-0.0065)

        end

        let penalty_gds5 = 0

        if $op_gds5 > 0.0004

          let penalty_gds5 = 1000*($op_gds5-0.0004)

        end

        let score = score+30*penalty_ratio+10*penalty_gm5+20*penalty_gds5



        if dcvalid = 0

          let score = score+10000

        end



        let passall = 1

        if passcount < 9

          let passall = 0

        end

        if dcvalid = 0

          let passall = 0

        end



        echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo STAGE_E_POINT WCG $wcgv RD1 $rd1v VBCG $vbcgv VBICG $vbicgv W5 $w5v >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo OP PDC_mW $op_pdc VSCG $op_vscg VDCG $op_vdcg NET7 $op_v7 NET8 $op_v8 GBUF $op_vg3 SOURCE3 $op_vs3 INTERNAL_X $op_vx OUTPUT_DC $op_vout XM1_ID $op_id1 XM1_GM $op_gm1 XM1_GDS $op_gds1 XM1_VDS $op_vds1 XM1_VDSAT $op_vdsat1 XM1_MARGIN $op_sat1 XM2_ID $op_id2 XM2_GM $op_gm2 XM2_GMB $op_gmb2 XM2_GMEFF $op_gm2eff XM2_GDS $op_gds2 XM2_VDS $op_vds2 XM2_VDSAT $op_vdsat2 XM2_MARGIN $op_sat2 XM3_ID $op_id3 XM3_GM $op_gm3 XM3_GMB $op_gmb3 XM3_GDS $op_gds3 XM3_GMID $op_gmid3 XM3_VGS $op_vgs3 XM3_VDS $op_vds3 XM3_VDSAT $op_vdsat3 XM3_MARGIN $op_sat3 XM3_RO $op_ro3 XM4_ID $op_id4 XM4_GM $op_gm4 XM4_GDS $op_gds4 XM4_VDS $op_vds4 XM4_VDSAT $op_vdsat4 XM4_MARGIN $op_sat4 XM5_ID $op_id5 XM5_GM $op_gm5 XM5_GDS $op_gds5 XM5_GMID $op_gmid5 XM5_VDS $op_vds5 XM5_VDSAT $op_vdsat5 XM5_MARGIN $op_sat5 XM5_RO $op_ro5 XM6_ID $op_id6 XM6_GM $op_gm6 XM6_GMB $op_gmb6 XM6_GDS $op_gds6 XM6_GMID $op_gmid6 XM6_VGS $op_vgs6 XM6_VDS $op_vds6 XM6_VDSAT $op_vdsat6 XM6_MARGIN $op_sat6 XM6_RO $op_ro6 GMEFF2_OVER_GM5 $op_ratio25 >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo RF SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall S11W_dB $&s11w S21MIN_dB $&s21m S21MAX_dB $&s21x RIPPLE_dB $&ripple S22W_dB $&s22w NFW_dB $&nfw MU_MIN $&mumin MUP_MIN $&mupmin DELTA_MAX $&dmax AT_2P4 S11_dB $&s11c S21_dB $&s21c S12_dB $&s12c S22_dB $&s22c NF_dB $&nfc ZIN_RE $&zinrc ZIN_IM $&zinic ZOUT_RE $&zoutrc ZOUT_IM $&zoutic >> lna_v22_cs_cascode_driver_corrected_detailed.txt



        echo $wcgv $rd1v $vbcgv $vbicgv $w5v $&score $&dcvalid $&passcount $&passall $op_pdc $op_id2 $op_gm2 $op_gmb2 $op_id5 $op_gm5 $op_gds5 $op_ratio25 $&s11w $&s21m $&s21x $&ripple $&s22w $&nfw $&mumin $&mupmin $&dmax >> lna_v22_cs_cascode_driver_corrected_summary.txt



        if score < $E_best_score

  set E_best_score = $&score

  set E_best_wcg = $wcgv

  set E_best_rd1 = $rd1v

  set E_best_vbcg = $vbcgv

  set E_best_vbicg = $vbicgv

  set E_best_w5 = $w5v

  set E_best_passall = $&passall

end



        destroy $curplot



end

      end

    end

  end

end

echo STAGE_E_BEST SCORE $E_best_score WCG $E_best_wcg RD1 $E_best_rd1 VBCG $E_best_vbcg VBICG $E_best_vbicg W5 $E_best_w5 PASSALL $E_best_passall >> lna_v22_cs_cascode_driver_corrected_summary.txt



* =============================================================================

* APPLY FINAL SELECTED PARAMETERS

* =============================================================================

alterparam W_CG = $E_best_wcg

alterparam RD1 = $E_best_rd1

alterparam VBIAS_CG = $E_best_vbcg

alterparam VBIAS_ICG = $E_best_vbicg

alterparam W_BIAS_CG = $E_best_w5



alterparam W_SF = $A_best_w3

alterparam W_SF_CAS = $A_best_w6

alterparam VBIAS_BUF = $A_best_vb3

alterparam VBIAS_CAS_BUF = $A_best_vb6

alterparam RD_OUT = $B_best_rd

alterparam RS_OUT = $C_best_rs

alterparam CSOUT_VAL = $C_best_cs

alterparam COUT_VAL = $B_best_cout

alterparam C_SH_OUT = $B_best_cshout

alterparam L_IN = $D_best_lin

alterparam C_SH_IN = $D_best_cshin



reset

op



let final_pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))

let final_vs3op = v(net3)

let final_vxop = v(net9)

let final_voutop = v(vbuf)



let final_id1op = abs(@m.xm1.m0[id])

let final_gm1op = @m.xm1.m0[gm]

let final_vds1op = v(net7)

let final_vdsat1op = abs(@m.xm1.m0[vdsat])

let final_sat1op = final_vds1op-final_vdsat1op



let final_id2op = abs(@m.xm2.m0[id])

let final_gm2op = @m.xm2.m0[gm]

let final_gmb2op = @m.xm2.m0[gmbs]

let final_vds2op = v(d)-v(s)

let final_vdsat2op = abs(@m.xm2.m0[vdsat])

let final_sat2op = final_vds2op-final_vdsat2op



let final_id3op = abs(@m.xm3.m0[id])

let final_gm3op = @m.xm3.m0[gm]

let final_gds3op = @m.xm3.m0[gds]

let final_vgs3op = v(g_buf)-v(net3)

let final_vds3op = v(net9)-v(net3)

let final_vdsat3op = abs(@m.xm3.m0[vdsat])

let final_sat3op = final_vds3op-final_vdsat3op



let final_id4op = abs(@m.xm4.m0[id])

let final_gm4op = @m.xm4.m0[gm]

let final_vds4op = v(net8)-v(net7)

let final_vdsat4op = abs(@m.xm4.m0[vdsat])

let final_sat4op = final_vds4op-final_vdsat4op



let final_id5op = abs(@m.xm5.m0[id])

let final_gm5op = @m.xm5.m0[gm]

let final_gds5op = @m.xm5.m0[gds]

let final_vds5op = v(s)

let final_vdsat5op = abs(@m.xm5.m0[vdsat])

let final_sat5op = final_vds5op-final_vdsat5op



let final_id6op = abs(@m.xm6.m0[id])

let final_gm6op = @m.xm6.m0[gm]

let final_gds6op = @m.xm6.m0[gds]

let final_vgs6op = v(vbias_cas_buf)-v(net9)

let final_vds6op = v(vbuf)-v(net9)

let final_vdsat6op = abs(@m.xm6.m0[vdsat])

let final_sat6op = final_vds6op-final_vdsat6op



set final_pdc = $&final_pdcop

set final_vs3 = $&final_vs3op

set final_vx = $&final_vxop

set final_vout = $&final_voutop

set final_id1 = $&final_id1op

set final_gm1 = $&final_gm1op

set final_vds1 = $&final_vds1op

set final_vdsat1 = $&final_vdsat1op

set final_sat1 = $&final_sat1op

set final_id2 = $&final_id2op

set final_gm2 = $&final_gm2op

set final_gmb2 = $&final_gmb2op

set final_vds2 = $&final_vds2op

set final_vdsat2 = $&final_vdsat2op

set final_sat2 = $&final_sat2op

set final_id3 = $&final_id3op

set final_gm3 = $&final_gm3op

set final_gds3 = $&final_gds3op

set final_vgs3 = $&final_vgs3op

set final_vds3 = $&final_vds3op

set final_vdsat3 = $&final_vdsat3op

set final_sat3 = $&final_sat3op

set final_id4 = $&final_id4op

set final_gm4 = $&final_gm4op

set final_vds4 = $&final_vds4op

set final_vdsat4 = $&final_vdsat4op

set final_sat4 = $&final_sat4op

set final_id5 = $&final_id5op

set final_gm5 = $&final_gm5op

set final_gds5 = $&final_gds5op

set final_vds5 = $&final_vds5op

set final_vdsat5 = $&final_vdsat5op

set final_sat5 = $&final_sat5op

set final_id6 = $&final_id6op

set final_gm6 = $&final_gm6op

set final_gds6 = $&final_gds6op

set final_vgs6 = $&final_vgs6op

set final_vds6 = $&final_vds6op

set final_vdsat6 = $&final_vdsat6op

set final_sat6 = $&final_sat6op



echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FINAL_SELECTED_PARAMETERS >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FRONT WCG $E_best_wcg RD1 $E_best_rd1 VBCG $E_best_vbcg VBICG $E_best_vbicg W5 $E_best_w5 L5 0.50u >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo OUTPUT W3 $A_best_w3 M3 2 L3 0.60u W6 $A_best_w6 M6 2 L6 0.60u VB3 $A_best_vb3 VBCAS $A_best_vb6 RD $B_best_rd RS $C_best_rs CS $C_best_cs COUT $B_best_cout CSHOUT $B_best_cshout >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo INPUT LIN $D_best_lin CSHIN $D_best_cshin LOUT 0 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FINAL_DC PDC_mW $final_pdc VS3 $final_vs3 VX_INTERNAL $final_vx VOUT_DC $final_vout XM1_ID $final_id1 XM1_GM $final_gm1 XM1_VDS $final_vds1 XM1_VDSAT $final_vdsat1 XM1_MARGIN $final_sat1 XM2_ID $final_id2 XM2_GM $final_gm2 XM2_GMB $final_gmb2 XM2_VDS $final_vds2 XM2_VDSAT $final_vdsat2 XM2_MARGIN $final_sat2 XM3_ID $final_id3 XM3_GM $final_gm3 XM3_GDS $final_gds3 XM3_VGS $final_vgs3 XM3_VDS $final_vds3 XM3_VDSAT $final_vdsat3 XM3_MARGIN $final_sat3 XM4_ID $final_id4 XM4_GM $final_gm4 XM4_VDS $final_vds4 XM4_VDSAT $final_vdsat4 XM4_MARGIN $final_sat4 XM5_ID $final_id5 XM5_GM $final_gm5 XM5_GDS $final_gds5 XM5_VDS $final_vds5 XM5_VDSAT $final_vdsat5 XM5_MARGIN $final_sat5 XM6_ID $final_id6 XM6_GM $final_gm6 XM6_GDS $final_gds6 XM6_VGS $final_vgs6 XM6_VDS $final_vds6 XM6_VDSAT $final_vdsat6 XM6_MARGIN $final_sat6 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FINAL_DC PDC_mW $final_pdc VS3 $final_vs3 VX_INTERNAL $final_vx VOUT_DC $final_vout XM1_ID $final_id1 XM1_GM $final_gm1 XM1_MARGIN $final_sat1 XM2_ID $final_id2 XM2_GM $final_gm2 XM2_GMB $final_gmb2 XM2_MARGIN $final_sat2 XM3_ID $final_id3 XM3_GM $final_gm3 XM3_GDS $final_gds3 XM3_VGS $final_vgs3 XM3_VDS $final_vds3 XM3_MARGIN $final_sat3 XM4_ID $final_id4 XM4_GM $final_gm4 XM4_MARGIN $final_sat4 XM5_ID $final_id5 XM5_GM $final_gm5 XM5_GDS $final_gds5 XM5_MARGIN $final_sat5 XM6_ID $final_id6 XM6_GM $final_gm6 XM6_GDS $final_gds6 XM6_VGS $final_vgs6 XM6_VDS $final_vds6 XM6_MARGIN $final_sat6 >> lna_v22_cs_cascode_driver_corrected_detailed.txt



destroy $curplot



* =============================================================================

* FINAL 201-POINT TARGET-BAND VERIFICATION

* =============================================================================

sp lin 201 2.30G 2.50G 1

let fs11db = db(s_1_1)

let fs21db = db(s_2_1)

let fs12db = db(s_1_2)

let fs22db = db(s_2_2)

let fnfdb = real(NF)



let fdelta = s_1_1*s_2_2-s_1_2*s_2_1

let fmd = mag(fdelta)

let fa11 = mag(s_1_1)

let fa12 = mag(s_1_2)

let fa21 = mag(s_2_1)

let fa22 = mag(s_2_2)

let fmu = (1-fa11*fa11)/(mag(s_2_2-fdelta*conj(s_1_1))+mag(s_1_2*s_2_1))

let fmup = (1-fa22*fa22)/(mag(s_1_1-fdelta*conj(s_2_2))+mag(s_1_2*s_2_1))

let fk = (1-fa11*fa11-fa22*fa22+fmd*fmd)/(2*fa12*fa21)



let fzin = 50*(1+s_1_1)/(1-s_1_1)

let fzout = 50*(1+s_2_2)/(1-s_2_2)

let fzinre = real(fzin)

let fzinim = imag(fzin)

let fzoutre = real(fzout)

let fzoutim = imag(fzout)



let fs11w = maximum(fs11db)

let fs21m = minimum(fs21db)

let fs21x = maximum(fs21db)

let fripple = fs21x-fs21m

let fs22w = maximum(fs22db)

let fnfw = maximum(fnfdb)

let fmumin = minimum(fmu)

let fmupmin = minimum(fmup)

let fdmax = maximum(fmd)



let fs11c = fs11db[100]

let fs21c = fs21db[100]

let fs12c = fs12db[100]

let fs22c = fs22db[100]

let fnfc = fnfdb[100]

let fzinrc = fzinre[100]

let fzinic = fzinim[100]

let fzoutrc = fzoutre[100]

let fzoutic = fzoutim[100]



set final_s11w = $&fs11w

set final_s21m = $&fs21m

set final_s21x = $&fs21x

set final_ripple = $&fripple

set final_s22w = $&fs22w

set final_nfw = $&fnfw

set final_mumin = $&fmumin

set final_mupmin = $&fmupmin

set final_dmax = $&fdmax

set final_s11c = $&fs11c

set final_s21c = $&fs21c

set final_s12c = $&fs12c

set final_s22c = $&fs22c

set final_nfc = $&fnfc

set final_zinrc = $&fzinrc

set final_zinic = $&fzinic

set final_zoutrc = $&fzoutrc

set final_zoutic = $&fzoutic



echo FINAL_TARGET_BAND S11W_dB $final_s11w S21MIN_dB $final_s21m S21MAX_dB $final_s21x RIPPLE_dB $final_ripple S22W_dB $final_s22w NFW_dB $final_nfw MU_MIN $final_mumin MUP_MIN $final_mupmin DELTA_MAX $final_dmax >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FINAL_AT_2P4 S11_dB $final_s11c S21_dB $final_s21c S12_dB $final_s12c S22_dB $final_s22c NF_dB $final_nfc ZIN_RE $final_zinrc ZIN_IM $final_zinic ZOUT_RE $final_zoutrc ZOUT_IM $final_zoutic >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FINAL_TARGET_BAND S11W_dB $final_s11w S21MIN_dB $final_s21m S21MAX_dB $final_s21x RIPPLE_dB $final_ripple S22W_dB $final_s22w NFW_dB $final_nfw MU_MIN $final_mumin MUP_MIN $final_mupmin DELTA_MAX $final_dmax >> lna_v22_cs_cascode_driver_corrected_detailed.txt

echo FINAL_AT_2P4 S11_dB $final_s11c S21_dB $final_s21c S12_dB $final_s12c S22_dB $final_s22c NF_dB $final_nfc ZIN_RE $final_zinrc ZIN_IM $final_zinic ZOUT_RE $final_zoutrc ZOUT_IM $final_zoutic >> lna_v22_cs_cascode_driver_corrected_detailed.txt



wrdata lna_v22_cs_cascode_driver_corrected_detailed.txt frequency s_1_1 s_2_1 s_1_2 s_2_2 fs11db fs21db fs12db fs22db fnfdb fk fmu fmup fmd fzinre fzinim fzoutre fzoutim

destroy $curplot



* =============================================================================

* WIDEBAND STABILITY: 10 MHz TO 30 GHz

* =============================================================================

sp dec 101 10Meg 30G 1

let wbdelta = s_1_1*s_2_2-s_1_2*s_2_1

let wbmd = mag(wbdelta)

let wba11 = mag(s_1_1)

let wba12 = mag(s_1_2)

let wba21 = mag(s_2_1)

let wba22 = mag(s_2_2)

let wbmu = (1-wba11*wba11)/(mag(s_2_2-wbdelta*conj(s_1_1))+mag(s_1_2*s_2_1))

let wbmup = (1-wba22*wba22)/(mag(s_1_1-wbdelta*conj(s_2_2))+mag(s_1_2*s_2_1))

let wbk = (1-wba11*wba11-wba22*wba22+wbmd*wbmd)/(2*wba12*wba21)

let wbkmin = minimum(wbk)

let wbmumin = minimum(wbmu)

let wbmupmin = minimum(wbmup)

let wbdmax = maximum(wbmd)



set final_wbkmin = $&wbkmin

set final_wbmumin = $&wbmumin

set final_wbmupmin = $&wbmupmin

set final_wbdmax = $&wbdmax



echo WIDEBAND_STABILITY_10MHZ_TO_30GHZ KMIN $final_wbkmin MU_MIN $final_wbmumin MUP_MIN $final_wbmupmin DELTA_MAX $final_wbdmax >> lna_v22_cs_cascode_driver_corrected_summary.txt

wrdata lna_v22_cs_cascode_driver_corrected_detailed.txt frequency wbk wbmu wbmup wbmd



* =============================================================================

* PASS / FAIL REPORT

* =============================================================================

echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FINAL_PASS_FAIL >> lna_v22_cs_cascode_driver_corrected_summary.txt



if $final_s11w <= target_s11

  echo S11 PASS worst_dB $final_s11w limit_dB -10 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo S11 FAIL worst_dB $final_s11w limit_dB -10 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_s22w <= target_s22

  echo S22 PASS worst_dB $final_s22w limit_dB -10 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo S22 FAIL worst_dB $final_s22w limit_dB -10 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_s21m >= target_gain

  echo GAIN PASS minimum_dB $final_s21m limit_dB 12 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo GAIN FAIL minimum_dB $final_s21m limit_dB 12 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_nfw <= target_nf

  echo NF PASS worst_dB $final_nfw limit_dB 4 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo NF FAIL worst_dB $final_nfw limit_dB 4 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_ripple <= target_ripple

  echo RIPPLE PASS value_dB $final_ripple limit_dB 1.20 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo RIPPLE FAIL value_dB $final_ripple limit_dB 1.20 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_pdc <= target_pdc

  echo PDC PASS value_mW $final_pdc limit_mW 220 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo PDC FAIL value_mW $final_pdc limit_mW 220 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_mumin >= target_mu

  echo MU PASS value $final_mumin limit 1.05 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo MU FAIL value $final_mumin limit 1.05 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_mupmin >= target_mu

  echo MUP PASS value $final_mupmin limit 1.05 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo MUP FAIL value $final_mupmin limit 1.05 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_dmax < target_delta

  echo DELTA PASS value $final_dmax limit 1.0 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo DELTA FAIL value $final_dmax limit 1.0 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_sat3 >= min_satmargin_out_cs

  echo XM3_SATURATION PASS MARGIN_V $final_sat3 LIMIT_V 0.30 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo XM3_SATURATION FAIL MARGIN_V $final_sat3 LIMIT_V 0.30 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_sat6 >= min_satmargin_out_cas

  echo XM6_CASCODE_SATURATION PASS MARGIN_V $final_sat6 LIMIT_V 0.40 >> lna_v22_cs_cascode_driver_corrected_summary.txt

else

  echo XM6_CASCODE_SATURATION FAIL MARGIN_V $final_sat6 LIMIT_V 0.40 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_vx >= 0.70

  if $final_vx <= 2.30

    echo INTERNAL_NODE PASS VX_V $final_vx RANGE_V 0.70 2.30 >> lna_v22_cs_cascode_driver_corrected_summary.txt

  else

    echo INTERNAL_NODE FAIL VX_V $final_vx RANGE_V 0.70 2.30 >> lna_v22_cs_cascode_driver_corrected_summary.txt

  end

else

  echo INTERNAL_NODE FAIL VX_V $final_vx RANGE_V 0.70 2.30 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



if $final_vout >= 2.20

  if $final_vout <= 4.50

    echo OUTPUT_DC PASS VOUT_V $final_vout RANGE_V 2.20 4.50 >> lna_v22_cs_cascode_driver_corrected_summary.txt

  else

    echo OUTPUT_DC FAIL VOUT_V $final_vout RANGE_V 2.20 4.50 >> lna_v22_cs_cascode_driver_corrected_summary.txt

  end

else

  echo OUTPUT_DC FAIL VOUT_V $final_vout RANGE_V 2.20 4.50 >> lna_v22_cs_cascode_driver_corrected_summary.txt

end



echo INDUCTANCE PASS L_IN $D_best_lin L_OUT 0 LIMIT_TOTAL 2nH >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo REQUIRED_SCHEMATIC_CHECK COUT_MUST_CONNECT_net9_to_net4 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo DETAILED_FILE lna_v22_cs_cascode_driver_corrected_detailed.txt >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo SUMMARY_FILE lna_v22_cs_cascode_driver_corrected_summary.txt >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo FINAL_SELECTED_PARAMETERS_LEFT_ACTIVE_IN_SIMULATION >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt



quit

.endc

