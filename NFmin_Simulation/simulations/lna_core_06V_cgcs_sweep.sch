          let dcvalid = 0

        end

        if $op_sat6 < min_satmargin_out_cas

          let dcvalid = 0

        end

        if $op_vs3 < 0

          let dcvalid = 0

        end

        if $op_vs3 > 0.50

          let dcvalid = 0

        end

        if $op_vx < 0.70

          let dcvalid = 0

        end

        if $op_vx > 2.30

          let dcvalid = 0

        end

        if $op_vout < 2.20

          let dcvalid = 0

        end

        if $op_vout > 4.50

          let dcvalid = 0

        end

        if $op_vout <= $op_vx

          let dcvalid = 0

        end

        if $op_vx <= $op_vs3

          let dcvalid = 0

        end



        let penalty_ratio = 0

        if $op_ratio25 < 3.0

          let penalty_ratio = 3.0-$op_ratio25

        end

        let penalty_gm5 = 0

        if $op_gm5 > 0.0065

          let penalty_gm5 = 1000*($op_gm5-0.0065)

        end

        let penalty_gds5 = 0

        if $op_gds5 > 0.0004

          let penalty_gds5 = 1000*($op_gds5-0.0004)

        end

        let score = score+30*penalty_ratio+10*penalty_gm5+20*penalty_gds5



        if dcvalid = 0

          let score = score+10000

        end



        let passall = 1

        if passcount < 9

          let passall = 0

        end

        if dcvalid = 0

          let passall = 0

        end



        echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo STAGE_A_POINT W3 $w3 W6 $w6 VB3 $vb3 VBCAS $vb6 RD $rdv RS 0.5 CS 100p COUT 33p CSHOUT 1f LIN 2.0n >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo OP PDC_mW $op_pdc VSCG $op_vscg VDCG $op_vdcg NET7 $op_v7 NET8 $op_v8 GBUF $op_vg3 SOURCE3 $op_vs3 INTERNAL_X $op_vx OUTPUT_DC $op_vout XM1_ID $op_id1 XM1_GM $op_gm1 XM1_GDS $op_gds1 XM1_VDS $op_vds1 XM1_VDSAT $op_vdsat1 XM1_MARGIN $op_sat1 XM2_ID $op_id2 XM2_GM $op_gm2 XM2_GMB $op_gmb2 XM2_GMEFF $op_gm2eff XM2_GDS $op_gds2 XM2_VDS $op_vds2 XM2_VDSAT $op_vdsat2 XM2_MARGIN $op_sat2 XM3_ID $op_id3 XM3_GM $op_gm3 XM3_GMB $op_gmb3 XM3_GDS $op_gds3 XM3_GMID $op_gmid3 XM3_VGS $op_vgs3 XM3_VDS $op_vds3 XM3_VDSAT $op_vdsat3 XM3_MARGIN $op_sat3 XM3_RO $op_ro3 XM4_ID $op_id4 XM4_GM $op_gm4 XM4_GDS $op_gds4 XM4_VDS $op_vds4 XM4_VDSAT $op_vdsat4 XM4_MARGIN $op_sat4 XM5_ID $op_id5 XM5_GM $op_gm5 XM5_GDS $op_gds5 XM5_GMID $op_gmid5 XM5_VDS $op_vds5 XM5_VDSAT $op_vdsat5 XM5_MARGIN $op_sat5 XM5_RO $op_ro5 XM6_ID $op_id6 XM6_GM $op_gm6 XM6_GMB $op_gmb6 XM6_GDS $op_gds6 XM6_GMID $op_gmid6 XM6_VGS $op_vgs6 XM6_VDS $op_vds6 XM6_VDSAT $op_vdsat6 XM6_MARGIN $op_sat6 XM6_RO $op_ro6 GMEFF2_OVER_GM5 $op_ratio25 >> lna_v22_cs_cascode_driver_corrected_detailed.txt

        echo RF SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall S11W_dB $&s11w S21MIN_dB $&s21m S21MAX_dB $&s21x RIPPLE_dB $&ripple S22W_dB $&s22w NFW_dB $&nfw MU_MIN $&mumin MUP_MIN $&mupmin DELTA_MAX $&dmax AT_2P4 S11_dB $&s11c S21_dB $&s21c S12_dB $&s12c S22_dB $&s22c NF_dB $&nfc ZIN_RE $&zinrc ZIN_IM $&zinic ZOUT_RE $&zoutrc ZOUT_IM $&zoutic >> lna_v22_cs_cascode_driver_corrected_detailed.txt



        echo $w3 $w6 $vb3 $vb6 $rdv $&score $&dcvalid $&passcount $&passall $op_pdc $op_vs3 $op_vx $op_vout $op_id3 $op_gm3 $op_sat3 $op_id6 $op_gm6 $op_sat6 $&s11w $&s21m $&s21x $&ripple $&s22w $&nfw $&mumin $&mupmin $&dmax >> lna_v22_cs_cascode_driver_corrected_summary.txt



        if score < $A_best_score

  set A_best_score = $&score

  set A_best_w3 = $w3

  set A_best_w6 = $w6

  set A_best_vb3 = $vb3

  set A_best_vb6 = $vb6

  set A_best_rd = $rdv

  set A_best_passall = $&passall

end



        destroy $curplot



end

      end

    end

  end

end

echo STAGE_A_BEST SCORE $A_best_score W3 $A_best_w3 W6 $A_best_w6 VB3 $A_best_vb3 VBCAS $A_best_vb6 RD $A_best_rd PASSALL $A_best_passall >> lna_v22_cs_cascode_driver_corrected_summary.txt



* =============================================================================

* STAGE B — RD, COUT AND OUTPUT SHUNT CAPACITANCE

* 7 RD x 5 COUT x 6 CSHOUT = 210 points.

