      alterparam C_SH_IN = 1f



reset

        op



        * ----- DC operating point -----

        let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))

        let vscgop = v(s)

        let vdcgop = v(d)

        let v7op = v(net7)

        let v8op = v(net8)

        let vg3op = v(g_buf)

        let vs3op = v(net3)

        let vxop = v(net9)

        let voutop = v(vbuf)



        let id1op = abs(@m.xm1.m0[id])

