        set op_vds1 = $&vds1op

        set op_vdsat1 = $&vdsat1op

        set op_sat1 = $&sat1op



        set op_id2 = $&id2op

        set op_gm2 = $&gm2op

        set op_gmb2 = $&gmb2op

        set op_gm2eff = $&gm2effop

        set op_gds2 = $&gds2op

        set op_vds2 = $&vds2op

        set op_vdsat2 = $&vdsat2op

        set op_sat2 = $&sat2op



        set op_id3 = $&id3op

        set op_gm3 = $&gm3op

        set op_gmb3 = $&gmb3op

        set op_gds3 = $&gds3op

        set op_gmid3 = $&gmid3op

        set op_vgs3 = $&vgs3op

        set op_vds3 = $&vds3op

        set op_vdsat3 = $&vdsat3op

        set op_sat3 = $&sat3op

        set op_ro3 = $&ro3op



        set op_id4 = $&id4op

        set op_gm4 = $&gm4op

        set op_gds4 = $&gds4op

