C {code.sym} 1140 50 0 0 {name=s2 only_toplevel=false value="

* =============================================================================

* SUPPLY / PACKAGE

* =============================================================================
.param L_OUT=1n
.param VDS=5.0

.param VDDIO_SUP=5.0

.param L_BW=2n

.param R_BW=0.2



* =============================================================================

* INPUT NETWORK — only intentional inductor

* =============================================================================

.param L_IN=2.0n

.param R_L_IN=1.5

.param CIN_VAL=100p

.param C_SH_IN=1f



* =============================================================================

* COMMON-GATE INPUT STAGE — V20 starting point

* =============================================================================

.param VBIAS_CG=2.10

.param W_CG=130u

.param M_CG=2

.param L_CG=0.60u

.param RD1=660

.param RBIAS_CG=50k

.param CBYP_CG=20p



* =============================================================================

* CS-CASCODE INTERMEDIATE STAGE

* =============================================================================

.param C12_VAL=100p

.param VBIAS_CS=1.25

.param W_CS=70u

.param M_CS=2

.param L_CS=0.60u

.param RBIAS_CS=50k

.param VBIAS_CAS=3.30

.param W_CAS=100u

.param M_CAS=1

.param L_CAS=0.60u

.param RD2=470



* =============================================================================

* REAL XM5 COMMON-GATE CURRENT SINK

* =============================================================================

.param VBIAS_ICG=1.60

.param L_BIAS_CG=0.50u

.param W_BIAS_CG=35u

.param M_BIAS_CG=1



* =============================================================================

* BOTTOM COMMON-SOURCE OUTPUT DEVICE XM3

* =============================================================================

.param W_SF=125u

.param M_SF=2

.param L_SF=0.60u

.param VBIAS_BUF=1.75

.param RBIAS_BUF=50k

.param C23_VAL=10p



* =============================================================================

* UPPER OUTPUT CASCODE XM6 — nfet_06v0

* =============================================================================

.param W_SF_CAS=100u

.param M_SF_CAS=2

.param L_SF_CAS=0.60u

.param VBIAS_CAS_BUF=2.80



* =============================================================================

* OUTPUT LOAD / SOURCE NETWORK — no intentional output inductor

* =============================================================================

.param RD_OUT=100

.param RS_OUT=0.5

.param CSOUT_VAL=100p

.param COUT_VAL=33p

.param R_L_OUT=1.5

.param C_SH_OUT=1f



.control

set noaskquit

set wr_singlescale

set wr_vecnames

set numdgt=10

set appendwrite



* =============================================================================

* FORMAL TARGETS AND DC VALIDITY

* =============================================================================

let target_s11 = -10

let target_s22 = -10

let target_gain = 12.0

let target_nf = 4.0

let target_ripple = 1.20

let target_pdc = 220

let target_mu = 1.05

let target_delta = 1.0

let target_ltotal = 2.0e-9



let min_satmargin_sink = 0.20

let min_satmargin_core = 0.40

let min_satmargin_cg = 0.50

let min_satmargin_out_cs = 0.30

let min_satmargin_out_cas = 0.40



* =============================================================================

* OUTPUT FILES

* =============================================================================

echo ============================================================ > lna_v22_cs_cascode_driver_corrected_detailed.txt

echo LNA_V22_CORRECTED_NODE_MAPPING_REAL_XM5_CS_CASCODE_OUTPUT_DRIVER >> lna_v22_cs_cascode_driver_corrected_detailed.txt

echo REQUIRED_COUT_CONNECTION COUT_vbuf_to_net4 >> lna_v22_cs_cascode_driver_corrected_detailed.txt
echo CORRECT_NODE_ORDER VBUF_OUTPUT_GT_NET9_INTERNAL_GT_NET3_SOURCE >> lna_v22_cs_cascode_driver_corrected_detailed.txt

echo XM3_BOTTOM_CS XM6_UPPER_CASCODE BOTH_NFET_06V0 >> lna_v22_cs_cascode_driver_corrected_detailed.txt

echo NO_INTENTIONAL_OUTPUT_INDUCTOR >> lna_v22_cs_cascode_driver_corrected_detailed.txt

echo MAX_INTENTIONAL_INPUT_INDUCTOR_2NH >> lna_v22_cs_cascode_driver_corrected_detailed.txt

echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_detailed.txt



echo ============================================================ > lna_v22_cs_cascode_driver_corrected_summary.txt

echo LNA_V22_CORRECTED_NODE_MAPPING_REAL_XM5_CS_CASCODE_OUTPUT_DRIVER_SUMMARY >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_BAND_HZ 2.30e9 2.50e9 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_S11_dB -10 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_S22_dB -10 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_GAIN_MIN_dB 12.0 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_NF_MAX_dB 4.0 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_GAIN_RIPPLE_MAX_dB 1.20 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_PDC_MAX_mW 220 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TARGET_MU_AND_MUP_MIN 1.05 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo MAX_INTENTIONAL_INDUCTANCE_H 2.0e-9 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo OUTPUT_INDUCTOR_H 0 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_A_CANDIDATES 1200 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_B_CANDIDATES 210 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_C_CANDIDATES 35 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_D_CANDIDATES 24 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_E_CANDIDATES 243 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo TOTAL_CANDIDATES 1712 >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt



* =============================================================================

* STAGE A — JOINT XM3/XM6 GEOMETRY, BIASES AND COARSE RD

* 4 W3 x 4 W6 x 5 VB3 x 5 VBCAS x 3 RD = 1200 points.

* Source is nearly RF-grounded during this topology search.

* =============================================================================

set A_best_score = 1e99

set A_best_w3 = 125u

set A_best_w6 = 100u

set A_best_vb3 = 1.75

set A_best_vb6 = 2.80

set A_best_rd = 100

set A_best_passall = 0



echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_A_JOINT_OUTPUT_CASCODE_GEOMETRY_AND_BIAS >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo W3 W6 VB3 VBCAS RD SCORE DCVALID PASSCOUNT PASSALL PDC VS3 VX VOUT ID3 GM3 SAT3 ID6 GM6 SAT6 S11W S21MIN S21MAX RIPPLE S22W NFW MU MUP DELTA >> lna_v22_cs_cascode_driver_corrected_summary.txt



foreach w3 100u 125u 150u 175u

  foreach w6 75u 100u 125u 150u

    foreach vb3 1.55 1.65 1.75 1.85 1.95

      foreach vb6 2.4 2.6 2.8 3.0 3.2

        foreach rdv 82 120 150

          alterparam W_SF = $w3

          alterparam W_SF_CAS = $w6

          alterparam VBIAS_BUF = $vb3

          alterparam VBIAS_CAS_BUF = $vb6

          alterparam RD_OUT = $rdv

          alterparam RS_OUT = 0.5

          alterparam CSOUT_VAL = 100p

          alterparam COUT_VAL = 33p

          alterparam C_SH_OUT = 1f

          alterparam L_IN = 2.0n

          alterparam C_SH_IN = 1f



reset

        op



        * ----- DC operating point -----

        let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))

        let vscgop = v(s)

        let vdcgop = v(d)

        let v7op = v(net7)

        let v8op = v(net8)

        let vg3op = v(g_buf)

        let vs3op = v(net3)

        let vxop = v(net9)

        let voutop = v(vbuf)



        let id1op = abs(@m.xm1.m0[id])

        let gm1op = @m.xm1.m0[gm]

        let gds1op = @m.xm1.m0[gds]

        let vds1op = v(net7)

        let vdsat1op = abs(@m.xm1.m0[vdsat])

        let sat1op = vds1op-vdsat1op



        let id2op = abs(@m.xm2.m0[id])

        let gm2op = @m.xm2.m0[gm]

        let gmb2op = @m.xm2.m0[gmbs]

        let gm2effop = gm2op+gmb2op

        let gds2op = @m.xm2.m0[gds]

        let vds2op = v(d)-v(s)

        let vdsat2op = abs(@m.xm2.m0[vdsat])

        let sat2op = vds2op-vdsat2op



        let id3op = abs(@m.xm3.m0[id])

        let gm3op = @m.xm3.m0[gm]

        let gmb3op = @m.xm3.m0[gmbs]

        let gds3op = @m.xm3.m0[gds]

        let gmid3op = gm3op/id3op

        let vgs3op = v(g_buf)-v(net3)

        let vds3op = v(net9)-v(net3)

        let vdsat3op = abs(@m.xm3.m0[vdsat])

        let sat3op = vds3op-vdsat3op

        let ro3op = 1/gds3op



        let id4op = abs(@m.xm4.m0[id])

        let gm4op = @m.xm4.m0[gm]

        let gds4op = @m.xm4.m0[gds]

        let vds4op = v(net8)-v(net7)

        let vdsat4op = abs(@m.xm4.m0[vdsat])

        let sat4op = vds4op-vdsat4op



        let id5op = abs(@m.xm5.m0[id])

        let gm5op = @m.xm5.m0[gm]

        let gds5op = @m.xm5.m0[gds]

        let gmid5op = gm5op/id5op

        let vds5op = v(s)

        let vdsat5op = abs(@m.xm5.m0[vdsat])

        let sat5op = vds5op-vdsat5op

        let ro5op = 1/gds5op



        let id6op = abs(@m.xm6.m0[id])

        let gm6op = @m.xm6.m0[gm]

        let gmb6op = @m.xm6.m0[gmbs]

        let gds6op = @m.xm6.m0[gds]

        let gmid6op = gm6op/id6op

        let vgs6op = v(vbias_cas_buf)-v(net9)

        let vds6op = v(vbuf)-v(net9)

        let vdsat6op = abs(@m.xm6.m0[vdsat])

        let sat6op = vds6op-vdsat6op

        let ro6op = 1/gds6op



        let ratio25op = gm2effop/gm5op



        set op_pdc = $&pdcop

        set op_vscg = $&vscgop

        set op_vdcg = $&vdcgop

        set op_v7 = $&v7op

        set op_v8 = $&v8op

        set op_vg3 = $&vg3op

        set op_vs3 = $&vs3op

        set op_vx = $&vxop

        set op_vout = $&voutop



        set op_id1 = $&id1op

        set op_gm1 = $&gm1op

        set op_gds1 = $&gds1op

        set op_vds1 = $&vds1op

        set op_vdsat1 = $&vdsat1op

        set op_sat1 = $&sat1op



        set op_id2 = $&id2op

        set op_gm2 = $&gm2op

        set op_gmb2 = $&gmb2op

        set op_gm2eff = $&gm2effop

        set op_gds2 = $&gds2op

        set op_vds2 = $&vds2op

        set op_vdsat2 = $&vdsat2op

        set op_sat2 = $&sat2op



        set op_id3 = $&id3op

        set op_gm3 = $&gm3op

        set op_gmb3 = $&gmb3op

        set op_gds3 = $&gds3op

        set op_gmid3 = $&gmid3op

        set op_vgs3 = $&vgs3op

        set op_vds3 = $&vds3op

        set op_vdsat3 = $&vdsat3op

        set op_sat3 = $&sat3op

        set op_ro3 = $&ro3op



        set op_id4 = $&id4op

        set op_gm4 = $&gm4op

        set op_gds4 = $&gds4op

        set op_vds4 = $&vds4op

        set op_vdsat4 = $&vdsat4op

        set op_sat4 = $&sat4op



        set op_id5 = $&id5op

        set op_gm5 = $&gm5op

        set op_gds5 = $&gds5op

        set op_gmid5 = $&gmid5op

        set op_vds5 = $&vds5op

        set op_vdsat5 = $&vdsat5op

        set op_sat5 = $&sat5op

        set op_ro5 = $&ro5op



        set op_id6 = $&id6op

        set op_gm6 = $&gm6op

        set op_gmb6 = $&gmb6op

        set op_gds6 = $&gds6op

        set op_gmid6 = $&gmid6op

        set op_vgs6 = $&vgs6op

        set op_vds6 = $&vds6op

        set op_vdsat6 = $&vdsat6op

        set op_sat6 = $&sat6op

        set op_ro6 = $&ro6op

        set op_ratio25 = $&ratio25op



        destroy $curplot



        * ----- RF/noise/stability over target band -----

        sp lin 51 2.30G 2.50G 1

        let s11db = db(s_1_1)

        let s21db = db(s_2_1)

        let s12db = db(s_1_2)

        let s22db = db(s_2_2)

        let nfdb = real(NF)



        let delta = s_1_1*s_2_2-s_1_2*s_2_1

        let md = mag(delta)

        let a11 = mag(s_1_1)

        let a12 = mag(s_1_2)

        let a21 = mag(s_2_1)

        let a22 = mag(s_2_2)

        let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))

        let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

        let kval = (1-a11*a11-a22*a22+md*md)/(2*a12*a21)



        let zin = 50*(1+s_1_1)/(1-s_1_1)

        let zout = 50*(1+s_2_2)/(1-s_2_2)

        let zin_re = real(zin)

        let zin_im = imag(zin)

        let zout_re = real(zout)

        let zout_im = imag(zout)



        let s11w = maximum(s11db)

        let s21m = minimum(s21db)

        let s21x = maximum(s21db)

        let ripple = s21x-s21m

        let s22w = maximum(s22db)

        let nfw = maximum(nfdb)

        let mumin = minimum(mu)

        let mupmin = minimum(mup)

        let dmax = maximum(md)



        let s11c = s11db[25]

        let s21c = s21db[25]

        let s12c = s12db[25]

        let s22c = s22db[25]

        let nfc = nfdb[25]

        let zinrc = zin_re[25]

        let zinic = zin_im[25]

        let zoutrc = zout_re[25]

        let zoutic = zout_im[25]



        * ----- Formal score -----

        let penalty_gain = 0

        let penalty_nf = 0

        let penalty_ripple = 0

        let penalty_s11 = 0

        let penalty_s22 = 0

        let penalty_pdc = 0

        let penalty_mu = 0

        let penalty_mup = 0

        let penalty_delta = 0

        let passcount = 0



        if s21m < target_gain

          let penalty_gain = target_gain-s21m

        else

          let passcount = passcount+1

        end

        if nfw > target_nf

          let penalty_nf = nfw-target_nf

        else

          let passcount = passcount+1

        end

        if ripple > target_ripple

          let penalty_ripple = ripple-target_ripple

        else

          let passcount = passcount+1

        end

        if s11w > target_s11

          let penalty_s11 = s11w-target_s11

        else

          let passcount = passcount+1

        end

        if s22w > target_s22

          let penalty_s22 = s22w-target_s22

        else

          let passcount = passcount+1

        end

        if $op_pdc > target_pdc

          let penalty_pdc = $op_pdc-target_pdc

        else

          let passcount = passcount+1

        end

        if mumin < target_mu

          let penalty_mu = target_mu-mumin

        else

          let passcount = passcount+1

        end

        if mupmin < target_mu

          let penalty_mup = target_mu-mupmin

        else

          let passcount = passcount+1

        end

        if dmax >= target_delta

          let penalty_delta = dmax-target_delta+0.001

        else

          let passcount = passcount+1

        end



        let score = 320*penalty_gain+280*penalty_nf+180*penalty_ripple

        let score = score+35*penalty_s11+35*penalty_s22+2*penalty_pdc

        let score = score+300*penalty_mu+300*penalty_mup+600*penalty_delta

        let score = score+5*nfw-3*s21m+2*ripple+0.004*$op_pdc



        * Do not force very high gm; V20 showed capacitance can dominate.

        let penalty_gm3 = 0

        if $op_gm3 < 0.020

          let penalty_gm3 = 1000*(0.020-$op_gm3)

        end

        let score = score+5*penalty_gm3



        * Prefer a reasonably strong upper cascode without making it a hard RF constraint.

        let penalty_gm6 = 0

        if $op_gm6 < 0.015

          let penalty_gm6 = 1000*(0.015-$op_gm6)

        end

        let score = score+3*penalty_gm6



        * ----- Hard DC validity -----

        let dcvalid = 1

        if $op_pdc > target_pdc

          let dcvalid = 0

        end

        if $op_sat1 < min_satmargin_core

          let dcvalid = 0

