        set op_gmid5 = $&gmid5op

        set op_vds5 = $&vds5op

        set op_vdsat5 = $&vdsat5op

        set op_sat5 = $&sat5op

        set op_ro5 = $&ro5op



        set op_id6 = $&id6op

        set op_gm6 = $&gm6op

        set op_gmb6 = $&gmb6op

