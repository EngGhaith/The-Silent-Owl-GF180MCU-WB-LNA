set B_best_score = 1e99

set B_best_rd = $A_best_rd

set B_best_cout = 33p

set B_best_cshout = 1f

set B_best_passall = 0



echo ============================================================ >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo STAGE_B_OUTPUT_LOAD_AND_MATCH >> lna_v22_cs_cascode_driver_corrected_summary.txt

echo RD COUT CSHOUT SCORE DCVALID PASSCOUNT PASSALL PDC VX VOUT ID3 GM3 SAT3 ID6 GM6 SAT6 S11W S21MIN S21MAX RIPPLE S22W NFW MU MUP DELTA >> lna_v22_cs_cascode_driver_corrected_summary.txt



foreach rdv 56 68 82 100 120 150 180

  foreach coutv 15p 22p 33p 47p 68p

    foreach cshoutv 1f 50f 100f 200f 300f 500f

      alterparam W_SF = $A_best_w3

      alterparam W_SF_CAS = $A_best_w6

