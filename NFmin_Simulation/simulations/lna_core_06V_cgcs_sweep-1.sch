* =============================================================================
* BEST OPTIMIZED PARAMETER SET
* =============================================================================
.param RLD2=7
* Currently unused unless a corresponding cascode-CG transistor is instantiated
.param VBIAS_CAS_CG=3.30
.param L_CAS_CG=0.60u
.param W_CAS_CG=80u
.param M_CAS_CG=4

* -----------------------------------------------------------------------------
* Supply / package
* -----------------------------------------------------------------------------
.param VDS=5.0
.param VDDIO_SUP=5.0

.param L_BW=2n
.param R_BW=0.2

* -----------------------------------------------------------------------------
* Source equalization networks
* -----------------------------------------------------------------------------

* XM9 cancellation-branch source equalizer
.param RS_EQ_D_VAL=0.25
.param CSEQ_D_VAL=4.7p

* XM1 main-path source equalizer
.param RS_EQ_S_VAL=0.10
.param CSEQ_S_VAL=220f

* Redundant aliases retained for compatibility
.param RS_EQ=0.10
.param CSEQ_VAL=220f

* -----------------------------------------------------------------------------
* Input network
*
* Package inductance       = 2.0 nH
* Intentional inductance   = 3.5 nH
* Total nominal inductance = 5.5 nH, excluding pad/interconnect parasitics
* -----------------------------------------------------------------------------
.param L_IN=3.5n
.param R_L_IN=2.26

.param CIN_VAL=8.2p
.param C_SH_IN=330f

* -----------------------------------------------------------------------------
* XM2 common-gate input stage
* -----------------------------------------------------------------------------
.param VBIAS_CG=2.10

.param W_CG=40u
.param M_CG=10
.param L_CG=0.60u

.param RD1=950

.param RBIAS_CG=50k
.param CBYP_CG=20p

* -----------------------------------------------------------------------------
* XM1 common-source / XM4 cascode main stage
* -----------------------------------------------------------------------------
.param C12_VAL=8.2p

.param VBIAS_CS=1.25

.param W_CS=20u
.param M_CS=8
.param L_CS=0.28u

.param RBIAS_CS=50k

.param VBIAS_CAS=3.60

.param W_CAS=35u
.param M_CAS=4
.param L_CAS=0.60u

.param RD2=1.2k

* -----------------------------------------------------------------------------
* XM3 body-tied source follower
* -----------------------------------------------------------------------------
.param W_SF=25u
.param M_SF=8
.param L_SF=0.60u

.param RG_SF_VAL=0.10

* -----------------------------------------------------------------------------
* Output network
*
* Package inductance       = 2.0 nH
* Intentional inductance   = 1.2 nH
* Total nominal inductance = 3.2 nH, excluding pad/interconnect parasitics
* -----------------------------------------------------------------------------
.param COUT_VAL=4.7p

.param L_OUT=1.2n
.param R_L_OUT=1.5

.param C_SH_OUT=470f

* -----------------------------------------------------------------------------
* XM5 common-gate current sink
* -----------------------------------------------------------------------------
.param VBIAS_ICG=1.80

.param L_BIAS_CG=0.50u
.param W_BIAS_CG=15u
.param M_BIAS_CG=1

* -----------------------------------------------------------------------------
* XM6 source-follower current sink
* -----------------------------------------------------------------------------
.param VBIAS_BUF=2.50

.param L_BIAS_SF=0.50u
.param W_BIAS_SF=25u
.param M_BIAS_SF=5

* -----------------------------------------------------------------------------
* XM9 source-sensing common-source cancellation branch
* -----------------------------------------------------------------------------
.param RBIAS_CSC=50k

.param VBIAS_CSC=0.90

.param L_CSC=0.28u
.param W_CSC=40u
.param M_CSC=6
.param NF_CSC=4

* -----------------------------------------------------------------------------
* XM7 cancellation-branch cascode
* -----------------------------------------------------------------------------
.param VBIAS_CASC=3.40

.param L_CASC=0.60u
.param W_CASC=35u
.param M_CASC=1

* -----------------------------------------------------------------------------
* Noise-cancellation coupling capacitor
* -----------------------------------------------------------------------------
.param CNC_VAL=8.2p

* -----------------------------------------------------------------------------
* Drain shunt-peaking network
* -----------------------------------------------------------------------------
.param LD2=4.7n
.param CD2=680f
.param R_LD2=7
"}
C {code.sym} 790 490 0 0 {name=s2 only_toplevel=false value="
.control

set num_threads=6
option klu
set noaskquit
set wr_singlescale
set wr_vecnames
set numdgt=10
set appendwrite

* ============================================================================
* LARGE-WINDOW GF180MCU NOISE-CANCELLING LNA OPTIMIZER
*
* Hard goals over 2.30-2.50 GHz:
*   minimum S21 >= 15 dB
*   worst NF <= 3.0 dB
*   worst S11 <= -10 dB
*   worst S22 <= -10 dB
*   gain ripple <= 1.5 dB
*   mu and mu' >= 1.05
*
* Each candidate is simulated twice:
*   1. CNC disconnected (1 aF)
*   2. CNC connected
*
* This gives a true noise-cancellation improvement:
*   NFIMP = NF_disconnected - NF_connected
*
* IMPORTANT SCHEMATIC REQUIREMENT:
*   RS_EQ_D net3  GND \{RS_EQ_D_VAL\}
*   CS_EQ_D net3  GND \{CSEQ_D_VAL\}
*   RS_EQ_S net10 GND \{RS_EQ_S_VAL\}
*   CS_EQ_S net10 GND \{CSEQ_S_VAL\}
* ============================================================================

* ---------------- Output files ----------------

shell rm -f lna_nc_wide_detailed.txt
shell rm -f lna_nc_wide_summary.txt
shell rm -f lna_nc_wide_ranked.txt
shell rm -f lna_nc_wide_top100.txt
shell rm -f lna_nc_wide_formal_pass.txt
shell rm -f lna_nc_wide_nc_formal_pass.txt
shell rm -f lna_nc_wide_final_connected_band.dat
shell rm -f lna_nc_wide_final_disconnected_band.dat
shell rm -f lna_nc_wide_final_broadband.dat
shell rm -f lna_nc_wide_final_stability.dat
shell rm -f lna_nc_wide_final.raw

* ---------------- Hard targets ----------------

let target_s11 = -10
let target_s22 = -10
let target_gain = 15
let target_nf = 3.0
let target_ripple = 1.5
let target_mu = 1.05
let target_pdc = 500
let target_nf_improvement = 0.05

* Exploratory validity limits. These allow the staged optimizer to move
* through imperfect intermediate designs while still rejecting unusable ones.
let relaxed_s11 = -4
let relaxed_s22 = -4
let relaxed_gain = 6
let relaxed_nf = 10
let relaxed_ripple = 5
let relaxed_mu = 0.98

* DC validity limits
let min_sat_xm1 = 0.15
let min_sat_xm2 = 0.20
let min_sat_cas = 0.20
let min_sat_sink = 0.08
let max_03v3_terminal = 3.00

* ---------------- Initial values ----------------
* Current verified noise-cancelling solution is used as the starting point.

set sel_lcg = 0.60u
set sel_wcg = 80u
set sel_mcg = 4
set sel_vbcg = 2.05
set sel_rd1 = 680

set sel_lbicg = 0.50u
set sel_wbicg = 25u
set sel_mbicg = 1
set sel_vbicg = 1.65

set sel_lcs = 0.28u
set sel_wcs = 40u
set sel_mcs = 2
set sel_vbcs = 0.95

set sel_wcas = 70u
set sel_mcas = 1
set sel_vbcas = 3.30
set sel_rd2 = 540

set sel_rs_d = 8
set sel_cs_d = 8.2p

set sel_wcsc = 5u
set sel_mcsc = 1
set sel_vbcsc = 0.90
set sel_vbcasc = 2.80

set sel_cnc = 2p
set sel_rs_s = 1
set sel_cs_s = 6.8p

set sel_lin = 2.30n
set sel_cshin = 1f

set sel_lout = 1.00n
set sel_cshout = 1f

set sel_wsf = 50u
set sel_msf = 5
set sel_vbbuf = 2.20
set sel_wbisf = 50u
set sel_mbisf = 3

* Fixed values not included in this sweep.
alterparam C12_VAL = 47p
alterparam COUT_VAL = 47p
alterparam W_CASC = 70u
alterparam M_CASC = 1
alterparam L_CASC = 0.60u
alterparam L_CAS = 0.60u
alterparam L_SF = 0.60u
alterparam L_BIAS_SF = 0.50u

* ---------------- Detailed output schema ----------------

echo ============================================================ > lna_nc_wide_detailed.txt
echo GF180MCU_NOISE_CANCELLING_LNA_LARGE_WINDOW_SEARCH >> lna_nc_wide_detailed.txt
echo ============================================================ >> lna_nc_wide_detailed.txt
echo FIELDS POINT STAGE FINITE VALID DCVALID FORMAL NCFORMAL SCORE RAWSCORE LCG WCG MCG VBCG RD1 LBICG WBICG MBICG VBICG LCS WCS MCS VBCS WCAS MCAS VBCAS RD2 RS_D CS_D WCSC MCSC VBCSC VBCASC CNC RS_S CS_S LIN CSHIN LOUT CSHOUT WSF MSF VBBUF WBISF MBISF PDC_MW VX D S NET8 NET11 NET3 NET10 VBUF ID1 ID2 ID4 ID5 ID7 ID9 GM1 GM2 GM5 GM9 SAT1 SAT2 SAT4 SAT5 SAT7 SAT9 OFF_S11W OFF_S21MIN OFF_S22W OFF_NFW ON_S11W ON_S21MIN ON_S21MAX ON_S22W ON_NFW NFIMP_WORST NFIMP_2P4 GAIN_CHANGE_2P4 ON_RIPPLE ON_MU_MIN ON_MUP_MIN ON_K_MIN ON_DELTA_MAX ZIN_RE_2P4 ZIN_IM_2P4 ZOUT_RE_2P4 ZOUT_IM_2P4 >> lna_nc_wide_detailed.txt

echo ============================================================ > lna_nc_wide_summary.txt
echo GF180MCU_NOISE_CANCELLING_LNA_LARGE_WINDOW_SUMMARY >> lna_nc_wide_summary.txt
echo ============================================================ >> lna_nc_wide_summary.txt
echo HARD_TARGETS S11_DB $&target_s11 S22_DB $&target_s22 GAIN_MIN_DB $&target_gain NF_WORST_DB $&target_nf RIPPLE_DB $&target_ripple MU_MIN $&target_mu PDC_MW $&target_pdc NF_IMPROVEMENT_DB $&target_nf_improvement >> lna_nc_wide_summary.txt
echo ============================================================ >> lna_nc_wide_summary.txt

* ============================================================================
* STAGE A - COMMON-GATE INPUT DEVICE, MULTIPLICITY, BIAS AND DRAIN LOAD (1125 candidates)
* ============================================================================

set stage_best_any_score = 1e99
set stage_best_valid_score = 1e99
set stage_best_formal_score = 1e99
set stage_best_ncformal_score = 1e99

set stage_found_valid = 0
set stage_found_formal = 0
set stage_found_ncformal = 0

* Any point
set besta_lcg = $sel_lcg
set besta_wcg = $sel_wcg
set besta_mcg = $sel_mcg
set besta_vbcg = $sel_vbcg
set besta_rd1 = $sel_rd1
set besta_lbicg = $sel_lbicg
