foreach linv 0.30n 0.50n 0.80n 1.10n 1.40n 1.70n 2.00n 2.30n 2.60n 3.00n 3.50n 4.00n
  foreach cshinv 1f 50f 100f 150f 220f 330f 470f 680f 1p 1.5p

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
set cur_rd1 = $sel_rd1
