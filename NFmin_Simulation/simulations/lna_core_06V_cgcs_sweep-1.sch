    if $op_id5 > 0.0060
      let dcvalid = 0
    end
    if $op_id6 < 0.015
      let dcvalid = 0
    end
    if $op_id6 > 0.060
      let dcvalid = 0
    end
    if abs($op_vgs1) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs($op_vgd1) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs($op_vgb1) > max_03v3_terminal
