          echo C_JOINT WCG $wcg VBCG $vbcg RD1 $rd1v W5 $w5 VBICG $vbicg SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall PDC $op_pdc SAT5 $op_sat5 RATIO25 $op_ratio25 S11W $&s11w S21MIN $&s21m S21MAX $&s21x RIPPLE $&ripple TILT $&tilt S22W $&s22w NFW $&nfw MU $&mumin MUP $&mupmin DELTA $&dmax >> lna_v26_gain_nf_priority_summary.txt

          if score < $global_best_score
            set global_best_score = $&score
            set best_wcg = $wcg
          set best_vbcg = $vbcg
          set best_rd1 = $rd1v
          set best_w5 = $w5
          set best_vbicg = $vbicg
