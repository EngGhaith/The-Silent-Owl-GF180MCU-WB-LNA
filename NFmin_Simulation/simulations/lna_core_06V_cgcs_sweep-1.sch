end
echo I FOUND_VALID $stage_found_valid FOUND_FORMAL $stage_found_formal FOUND_NCFORMAL $stage_found_ncformal BEST_ANY $stage_best_any_score BEST_VALID $stage_best_valid_score BEST_FORMAL $stage_best_formal_score BEST_NCFORMAL $stage_best_ncformal_score >> lna_nc_wide_summary.txt
echo I_SELECTED LCG $sel_lcg WCG $sel_wcg MCG $sel_mcg VBCG $sel_vbcg RD1 $sel_rd1 LBICG $sel_lbicg WBICG $sel_wbicg MBICG $sel_mbicg VBICG $sel_vbicg LCS $sel_lcs WCS $sel_wcs MCS $sel_mcs VBCS $sel_vbcs WCAS $sel_wcas MCAS $sel_mcas VBCAS $sel_vbcas RD2 $sel_rd2 RS_D $sel_rs_d CS_D $sel_cs_d WCSC $sel_wcsc MCSC $sel_mcsc VBCSC $sel_vbcsc VBCASC $sel_vbcasc CNC $sel_cnc RS_S $sel_rs_s CS_S $sel_cs_s LIN $sel_lin CSHIN $sel_cshin LOUT $sel_lout CSHOUT $sel_cshout WSF $sel_wsf MSF $sel_msf VBBUF $sel_vbbuf WBISF $sel_wbisf MBISF $sel_mbisf >> lna_nc_wide_summary.txt
echo ============================================================ >> lna_nc_wide_summary.txt

* ============================================================================
