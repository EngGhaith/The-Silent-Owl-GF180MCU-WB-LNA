foreach msfv 2 3 4 5 6 8 10 12
  foreach vbbufv 1.60 1.80 2.00 2.20 2.40 2.60
    foreach mbisfv 1 2 3 4 5 6 8 10

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
set cur_rd1 = $sel_rd1
set cur_lbicg = $sel_lbicg
set cur_wbicg = $sel_wbicg
set cur_mbicg = $sel_mbicg
set cur_vbicg = $sel_vbicg
set cur_lcs = $sel_lcs
set cur_wcs = $sel_wcs
set cur_mcs = $sel_mcs
set cur_vbcs = $sel_vbcs
set cur_wcas = $sel_wcas
set cur_mcas = $sel_mcas
set cur_vbcas = $sel_vbcas
