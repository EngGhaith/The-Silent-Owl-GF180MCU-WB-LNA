* ---------------- Hard targets ----------------

let target_s11 = -10
let target_s22 = -10
let target_gain = 15
let target_nf = 3.0
let target_ripple = 1.5
let target_mu = 1.05
let target_pdc = 500
let target_nf_improvement = 0.05

* Exploratory validity limits. These allow the staged optimizer to move
* through imperfect intermediate designs while still rejecting unusable ones.
let relaxed_s11 = -4
let relaxed_s22 = -4
let relaxed_gain = 6
let relaxed_nf = 10
let relaxed_ripple = 5
let relaxed_mu = 0.98

* DC validity limits
let min_sat_xm1 = 0.15
let min_sat_xm2 = 0.20
let min_sat_cas = 0.20
let min_sat_sink = 0.08
let max_03v3_terminal = 3.00

* ---------------- Initial values ----------------
* Current verified solution is represented with conservative fixed W values.
* Effective device size is swept with integer multiplicity M to avoid large-W
* deck/model reload failures in ngspice-42.

set sel_lcg = 0.60u
set sel_wcg = 40u
set sel_mcg = 8
set sel_vbcg = 2.05
set sel_rd1 = 680

set sel_lbicg = 0.50u
set sel_wbicg = 10u
set sel_mbicg = 3
set sel_vbicg = 1.65

set sel_lcs = 0.28u
set sel_wcs = 20u
set sel_mcs = 4
set sel_vbcs = 0.95

set sel_wcas = 35u
set sel_mcas = 2
set sel_vbcas = 3.30
set sel_rd2 = 540

set sel_rs_d = 8
set sel_cs_d = 8.2p

set sel_wcsc = 2.5u
set sel_mcsc = 2
set sel_vbcsc = 0.90
set sel_vbcasc = 2.80

set sel_cnc = 2p
set sel_rs_s = 1
set sel_cs_s = 6.8p

set sel_lin = 2.30n
set sel_cshin = 1f

set sel_lout = 1.00n
set sel_cshout = 1f

set sel_wsf = 25u
set sel_msf = 10
set sel_vbbuf = 2.20
set sel_wbisf = 25u
set sel_mbisf = 6

* Fixed values not included in this sweep.
alterparam C12_VAL = 47p
alterparam COUT_VAL = 47p
alterparam W_CASC = 35u
alterparam M_CASC = 2
alterparam L_CASC = 0.60u
