foreach wsfv 30u 40u 50u 60u 80u
  foreach vbbufv 1.60 1.80 2.00 2.20 2.40 2.60
    foreach wbisfv 30u 40u 50u 60u 80u

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
set cur_rd1 = $sel_rd1
