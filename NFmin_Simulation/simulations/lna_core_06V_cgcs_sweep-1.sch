    let id5op = abs(@m.xm5.m0[id])
    let gm5op = @m.xm5.m0[gm]
    let gds5op = @m.xm5.m0[gds]
    let vds5op = v(s)
    let vdsat5op = abs(@m.xm5.m0[vdsat])
    let sat5op = vds5op-vdsat5op

    let id6op = abs(@m.xm6.m0[id])
    let gm6op = @m.xm6.m0[gm]
    let gds6op = @m.xm6.m0[gds]
    let vds6op = v(vbuf)
    let vdsat6op = abs(@m.xm6.m0[vdsat])
    let sat6op = vds6op-vdsat6op

    let ratio25op = gm2effop/gm5op
    let ltotalop = 2.0e-9

    set op_pdc = $&pdcop
    set op_vsrc1 = $&vsrc1op
    set op_vx1 = $&vx1op
    set op_v9 = $&v9op
    set op_vbuf = $&vbufop
    set op_id1 = $&id1op
    set op_vgs1 = $&vgs1op
    set op_vgd1 = $&vgd1op
    set op_vgb1 = $&vgb1op
    set op_vds1 = $&vds1op
    set op_sat1 = $&sat1op
    set op_id2 = $&id2op
    set op_gm2eff = $&gm2effop
    set op_sat2 = $&sat2op
    set op_id3 = $&id3op
    set op_sat3 = $&sat3op
    set op_id4 = $&id4op
    set op_sat4 = $&sat4op
    set op_id5 = $&id5op
    set op_gm5 = $&gm5op
    set op_gds5 = $&gds5op
    set op_sat5 = $&sat5op
    set op_id6 = $&id6op
    set op_sat6 = $&sat6op
    set op_ratio25 = $&ratio25op
    set op_ltotal = $&ltotalop

    destroy $curplot

    * ----- Target-band S/noise/stability -----
    sp lin 101 2.30G 2.50G 1
    let s11db = db(s_1_1)
    let s21db = db(s_2_1)
    let s12db = db(s_1_2)
    let s22db = db(s_2_2)
    let nfdb = real(NF)

    let delta = s_1_1*s_2_2-s_1_2*s_2_1
    let md = mag(delta)
    let a11 = mag(s_1_1)
    let a12 = mag(s_1_2)
    let a21 = mag(s_2_1)
    let a22 = mag(s_2_2)
    let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))
    let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

    let s11w = maximum(s11db)
