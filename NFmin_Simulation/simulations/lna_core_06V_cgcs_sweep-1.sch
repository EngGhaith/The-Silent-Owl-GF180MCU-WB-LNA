  set sel_msf = $bestn_msf
  set sel_vbbuf = $bestn_vbbuf
  set sel_wbisf = $bestn_wbisf
  set sel_mbisf = $bestn_mbisf
end
echo M FOUND_VALID $stage_found_valid FOUND_FORMAL $stage_found_formal FOUND_NCFORMAL $stage_found_ncformal BEST_ANY $stage_best_any_score BEST_VALID $stage_best_valid_score BEST_FORMAL $stage_best_formal_score BEST_NCFORMAL $stage_best_ncformal_score >> lna_nc_wide_summary.txt
echo M_SELECTED LCG $sel_lcg WCG $sel_wcg MCG $sel_mcg VBCG $sel_vbcg RD1 $sel_rd1 LBICG $sel_lbicg WBICG $sel_wbicg MBICG $sel_mbicg VBICG $sel_vbicg LCS $sel_lcs WCS $sel_wcs MCS $sel_mcs VBCS $sel_vbcs WCAS $sel_wcas MCAS $sel_mcas VBCAS $sel_vbcas RD2 $sel_rd2 RS_D $sel_rs_d CS_D $sel_cs_d WCSC $sel_wcsc MCSC $sel_mcsc VBCSC $sel_vbcsc VBCASC $sel_vbcasc CNC $sel_cnc RS_S $sel_rs_s CS_S $sel_cs_s LIN $sel_lin CSHIN $sel_cshin LOUT $sel_lout CSHOUT $sel_cshout WSF $sel_wsf MSF $sel_msf VBBUF $sel_vbbuf WBISF $sel_wbisf MBISF $sel_mbisf >> lna_nc_wide_summary.txt
echo ============================================================ >> lna_nc_wide_summary.txt

* ============================================================================
* FINAL SELECTED CONFIGURATION
* ============================================================================

alterparam L_CG = $sel_lcg
alterparam W_CG = $sel_wcg
alterparam M_CG = $sel_mcg
alterparam VBIAS_CG = $sel_vbcg
alterparam RD1 = $sel_rd1

alterparam L_BIAS_CG = $sel_lbicg
alterparam W_BIAS_CG = $sel_wbicg
alterparam M_BIAS_CG = $sel_mbicg
alterparam VBIAS_ICG = $sel_vbicg

alterparam L_CS = $sel_lcs
alterparam W_CS = $sel_wcs
alterparam M_CS = $sel_mcs
alterparam VBIAS_CS = $sel_vbcs

alterparam W_CAS = $sel_wcas
alterparam M_CAS = $sel_mcas
alterparam VBIAS_CAS = $sel_vbcas
alterparam RD2 = $sel_rd2

alterparam RS_EQ_D_VAL = $sel_rs_d
alterparam CSEQ_D_VAL = $sel_cs_d

alterparam W_CSC = $sel_wcsc
alterparam M_CSC = $sel_mcsc
alterparam VBIAS_CSC = $sel_vbcsc
alterparam VBIAS_CASC = $sel_vbcasc
alterparam CNC_VAL = $sel_cnc
alterparam RS_EQ_S_VAL = $sel_rs_s
alterparam CSEQ_S_VAL = $sel_cs_s

alterparam L_IN = $sel_lin
alterparam C_SH_IN = $sel_cshin
alterparam L_OUT = $sel_lout
alterparam C_SH_OUT = $sel_cshout

alterparam W_SF = $sel_wsf
alterparam M_SF = $sel_msf
alterparam VBIAS_BUF = $sel_vbbuf
alterparam W_BIAS_SF = $sel_wbisf
alterparam M_BIAS_SF = $sel_mbisf

* ---------------- Final DC ----------------

reset
op

let fpdc = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))
let fvx = v(vx)
let fd = v(d)
let fs = v(s)
let fnet8 = v(net8)
let fnet11 = v(net11)
let fnet3 = v(net3)
let fnet10 = v(net10)
let fvbuf = v(vbuf)

let fid1 = abs(@m.xm1.m0[id])
let fgm1 = @m.xm1.m0[gm]
let fgds1 = @m.xm1.m0[gds]
let fvds1 = v(net8)-v(net3)
let fsat1 = fvds1-abs(@m.xm1.m0[vdsat])

let fid2 = abs(@m.xm2.m0[id])
let fgm2 = @m.xm2.m0[gm]
let fgmb2 = @m.xm2.m0[gmbs]
let fgds2 = @m.xm2.m0[gds]
let fvds2 = v(d)-v(s)
let fsat2 = fvds2-abs(@m.xm2.m0[vdsat])

let fid3 = abs(@m.xm3.m0[id])
let fgm3 = @m.xm3.m0[gm]
let fgds3 = @m.xm3.m0[gds]
let fvds3 = v(vdcbias)-v(vbuf)
let fsat3 = fvds3-abs(@m.xm3.m0[vdsat])

let fid4 = abs(@m.xm4.m0[id])
let fgm4 = @m.xm4.m0[gm]
let fgds4 = @m.xm4.m0[gds]
let fvds4 = v(vx)-v(net8)
let fsat4 = fvds4-abs(@m.xm4.m0[vdsat])

let fid5 = abs(@m.xm5.m0[id])
let fgm5 = @m.xm5.m0[gm]
let fgds5 = @m.xm5.m0[gds]
let fvds5 = v(s)
let fsat5 = fvds5-abs(@m.xm5.m0[vdsat])

let fid6 = abs(@m.xm6.m0[id])
let fgm6 = @m.xm6.m0[gm]
let fgds6 = @m.xm6.m0[gds]
let fvds6 = v(vbuf)
let fsat6 = fvds6-abs(@m.xm6.m0[vdsat])

let fid7 = abs(@m.xm7.m0[id])
let fgm7 = @m.xm7.m0[gm]
let fgds7 = @m.xm7.m0[gds]
let fvds7 = v(vx)-v(net11)
let fsat7 = fvds7-abs(@m.xm7.m0[vdsat])

let fid9 = abs(@m.xm9.m0[id])
let fgm9 = @m.xm9.m0[gm]
let fgds9 = @m.xm9.m0[gds]
let fvds9 = v(net11)-v(net10)
let fsat9 = fvds9-abs(@m.xm9.m0[vdsat])

set f_pdc = $&fpdc
set f_vx = $&fvx
set f_d = $&fd
set f_s = $&fs
set f_net8 = $&fnet8
set f_net11 = $&fnet11
set f_net3 = $&fnet3
set f_net10 = $&fnet10
set f_vbuf = $&fvbuf

set f_id1 = $&fid1
set f_gm1 = $&fgm1
set f_gds1 = $&fgds1
set f_vds1 = $&fvds1
set f_sat1 = $&fsat1
set f_id2 = $&fid2
set f_gm2 = $&fgm2
set f_gmb2 = $&fgmb2
set f_gds2 = $&fgds2
set f_vds2 = $&fvds2
set f_sat2 = $&fsat2
set f_id3 = $&fid3
set f_gm3 = $&fgm3
set f_gds3 = $&fgds3
set f_vds3 = $&fvds3
set f_sat3 = $&fsat3
set f_id4 = $&fid4
set f_gm4 = $&fgm4
set f_gds4 = $&fgds4
set f_vds4 = $&fvds4
set f_sat4 = $&fsat4
set f_id5 = $&fid5
set f_gm5 = $&fgm5
set f_gds5 = $&fgds5
set f_vds5 = $&fvds5
set f_sat5 = $&fsat5
set f_id6 = $&fid6
set f_gm6 = $&fgm6
set f_gds6 = $&fgds6
set f_vds6 = $&fvds6
set f_sat6 = $&fsat6
set f_id7 = $&fid7
set f_gm7 = $&fgm7
set f_gds7 = $&fgds7
set f_vds7 = $&fvds7
set f_sat7 = $&fsat7
set f_id9 = $&fid9
set f_gm9 = $&fgm9
set f_gds9 = $&fgds9
set f_vds9 = $&fvds9
set f_sat9 = $&fsat9

destroy $curplot

* ---------------- Final disconnected band ----------------

alterparam CNC_VAL = 1a
reset
sp lin 201 2.30G 2.50G 1

let ds11db = db(s_1_1)
let ds21db = db(s_2_1)
let ds12db = db(s_1_2)
let ds22db = db(s_2_2)
let dnfdb = real(NF)
let dnfmin = real(NFMIN)

let ddelta = s_1_1*s_2_2-s_1_2*s_2_1
let dmd = mag(ddelta)
let da11 = mag(s_1_1)
let da12 = mag(s_1_2)
let da21 = mag(s_2_1)
let da22 = mag(s_2_2)
let dmu = (1-da11*da11)/(mag(s_2_2-ddelta*conj(s_1_1))+mag(s_1_2*s_2_1)+1e-30)
let dmup = (1-da22*da22)/(mag(s_1_1-ddelta*conj(s_2_2))+mag(s_1_2*s_2_1)+1e-30)
let dk = (1-da11*da11-da22*da22+dmd*dmd)/(2*da12*da21+1e-30)

let dzin = 50*(1+s_1_1)/(1-s_1_1)
let dzout = 50*(1+s_2_2)/(1-s_2_2)

let ds11w = maximum(ds11db)
let ds21m = minimum(ds21db)
let ds21x = maximum(ds21db)
let drip = ds21x-ds21m
let ds22w = maximum(ds22db)
let dnfw = maximum(dnfdb)
let dmumin = minimum(dmu)
let dmupmin = minimum(dmup)
let dkmin = minimum(dk)
let ddmax = maximum(dmd)

let ds11c = ds11db[100]
let ds21c = ds21db[100]
let ds12c = ds12db[100]
let ds22c = ds22db[100]
let dnfc = dnfdb[100]
let dnfminc = dnfmin[100]

set fd_s11w = $&ds11w
set fd_s21m = $&ds21m
set fd_s21x = $&ds21x
set fd_rip = $&drip
set fd_s22w = $&ds22w
set fd_nfw = $&dnfw
set fd_mumin = $&dmumin
set fd_mupmin = $&dmupmin
set fd_kmin = $&dkmin
set fd_dmax = $&ddmax
set fd_s11c = $&ds11c
set fd_s21c = $&ds21c
set fd_s12c = $&ds12c
set fd_s22c = $&ds22c
set fd_nfc = $&dnfc
set fd_nfminc = $&dnfminc

wrdata lna_nc_wide_final_disconnected_band.dat frequency ds11db ds21db ds12db ds22db dnfdb dnfmin dmu dmup dk dmd real(dzin) imag(dzin) real(dzout) imag(dzout)

destroy $curplot

* ---------------- Final connected band ----------------

alterparam CNC_VAL = $sel_cnc
reset
sp lin 201 2.30G 2.50G 1

let cs11db = db(s_1_1)
let cs21db = db(s_2_1)
let cs12db = db(s_1_2)
let cs22db = db(s_2_2)
let cnfdb = real(NF)
let cnfmin = real(NFMIN)

let cdelta = s_1_1*s_2_2-s_1_2*s_2_1
let cmd = mag(cdelta)
let ca11 = mag(s_1_1)
let ca12 = mag(s_1_2)
let ca21 = mag(s_2_1)
let ca22 = mag(s_2_2)
let cmu = (1-ca11*ca11)/(mag(s_2_2-cdelta*conj(s_1_1))+mag(s_1_2*s_2_1)+1e-30)
let cmup = (1-ca22*ca22)/(mag(s_1_1-cdelta*conj(s_2_2))+mag(s_1_2*s_2_1)+1e-30)
let ck = (1-ca11*ca11-ca22*ca22+cmd*cmd)/(2*ca12*ca21+1e-30)

let czin = 50*(1+s_1_1)/(1-s_1_1)
let czout = 50*(1+s_2_2)/(1-s_2_2)

let cs11w = maximum(cs11db)
let cs21m = minimum(cs21db)
let cs21x = maximum(cs21db)
let crip = cs21x-cs21m
let cs22w = maximum(cs22db)
let cnfw = maximum(cnfdb)
let cmumin = minimum(cmu)
let cmupmin = minimum(cmup)
let ckmin = minimum(ck)
let cdmax = maximum(cmd)

let cs11c = cs11db[100]
let cs21c = cs21db[100]
let cs12c = cs12db[100]
let cs22c = cs22db[100]
let cnfc = cnfdb[100]
let cnfminc = cnfmin[100]
let cmuc = cmu[100]
let cmupc = cmup[100]
let ckc = ck[100]
let cdeltac = cmd[100]

let czinre = real(czin[100])
let czinim = imag(czin[100])
let czoutre = real(czout[100])
let czoutim = imag(czout[100])

set fc_s11w = $&cs11w
set fc_s21m = $&cs21m
set fc_s21x = $&cs21x
set fc_rip = $&crip
set fc_s22w = $&cs22w
set fc_nfw = $&cnfw
set fc_mumin = $&cmumin
set fc_mupmin = $&cmupmin
set fc_kmin = $&ckmin
set fc_dmax = $&cdmax
set fc_s11c = $&cs11c
set fc_s21c = $&cs21c
set fc_s12c = $&cs12c
set fc_s22c = $&cs22c
set fc_nfc = $&cnfc
set fc_nfminc = $&cnfminc
set fc_muc = $&cmuc
set fc_mupc = $&cmupc
set fc_kc = $&ckc
set fc_dc = $&cdeltac
set fc_zinre = $&czinre
set fc_zinim = $&czinim
set fc_zoutre = $&czoutre
set fc_zoutim = $&czoutim

wrdata lna_nc_wide_final_connected_band.dat frequency cs11db cs21db cs12db cs22db cnfdb cnfmin cmu cmup ck cmd real(czin) imag(czin) real(czout) imag(czout)

write lna_nc_wide_final.raw all

destroy $curplot

* ---------------- Broadband connected ----------------

reset
sp dec 100 1MEG 7G 1

let bs11db = db(s_1_1)
let bs21db = db(s_2_1)
let bs12db = db(s_1_2)
let bs22db = db(s_2_2)
let bnfdb = real(NF)
let bnfmin = real(NFMIN)

wrdata lna_nc_wide_final_broadband.dat frequency bs11db bs21db bs12db bs22db bnfdb bnfmin

destroy $curplot

* ---------------- Wideband stability ----------------

reset
sp dec 100 10MEG 30G 0

let ws11db = db(s_1_1)
let ws21db = db(s_2_1)
let ws12db = db(s_1_2)
let ws22db = db(s_2_2)

let wdelta = s_1_1*s_2_2-s_1_2*s_2_1
let wmd = mag(wdelta)
let wa11 = mag(s_1_1)
let wa12 = mag(s_1_2)
let wa21 = mag(s_2_1)
let wa22 = mag(s_2_2)

let wmu = (1-wa11*wa11)/(mag(s_2_2-wdelta*conj(s_1_1))+mag(s_1_2*s_2_1)+1e-30)
let wmup = (1-wa22*wa22)/(mag(s_1_1-wdelta*conj(s_2_2))+mag(s_1_2*s_2_1)+1e-30)
let wk = (1-wa11*wa11-wa22*wa22+wmd*wmd)/(2*wa12*wa21+1e-30)

let wmumin = minimum(wmu)
let wmupmin = minimum(wmup)
let wkmin = minimum(wk)
let wdmax = maximum(wmd)

set fw_mumin = $&wmumin
set fw_mupmin = $&wmupmin
set fw_kmin = $&wkmin
set fw_dmax = $&wdmax

wrdata lna_nc_wide_final_stability.dat frequency ws11db ws21db ws12db ws22db wmu wmup wk wmd

destroy $curplot

* ---------------- Final comparison and pass/fail ----------------

let final_nf_imp_worst = $fd_nfw - $fc_nfw
let final_nf_imp_2p4 = $fd_nfc - $fc_nfc
let final_gain_change_2p4 = $fc_s21c - $fd_s21c

let final_formal = 1
if $fc_s11w > target_s11
  let final_formal = 0
end
if $fc_s22w > target_s22
  let final_formal = 0
end
if $fc_s21m < target_gain
  let final_formal = 0
end
if $fc_nfw > target_nf
  let final_formal = 0
end
if $fc_rip > target_ripple
  let final_formal = 0
end
if $fc_mumin < target_mu
  let final_formal = 0
end
if $fc_mupmin < target_mu
  let final_formal = 0
end
if $fc_dmax >= 1
  let final_formal = 0
end

let final_ncformal = final_formal
if final_nf_imp_worst < target_nf_improvement
  let final_ncformal = 0
end

echo ============================================================ >> lna_nc_wide_summary.txt
echo FINAL_SELECTED_PARAMETERS >> lna_nc_wide_summary.txt
echo L_CG $sel_lcg W_CG $sel_wcg M_CG $sel_mcg VBIAS_CG $sel_vbcg RD1 $sel_rd1 >> lna_nc_wide_summary.txt
echo L_BIAS_CG $sel_lbicg W_BIAS_CG $sel_wbicg M_BIAS_CG $sel_mbicg VBIAS_ICG $sel_vbicg >> lna_nc_wide_summary.txt
echo L_CS $sel_lcs W_CS $sel_wcs M_CS $sel_mcs VBIAS_CS $sel_vbcs >> lna_nc_wide_summary.txt
echo W_CAS $sel_wcas M_CAS $sel_mcas VBIAS_CAS $sel_vbcas RD2 $sel_rd2 >> lna_nc_wide_summary.txt
echo RS_EQ_D $sel_rs_d CSEQ_D $sel_cs_d >> lna_nc_wide_summary.txt
echo W_CSC $sel_wcsc M_CSC $sel_mcsc VBIAS_CSC $sel_vbcsc VBIAS_CASC $sel_vbcasc CNC $sel_cnc RS_EQ_S $sel_rs_s CSEQ_S $sel_cs_s >> lna_nc_wide_summary.txt
echo L_IN $sel_lin C_SH_IN $sel_cshin L_OUT $sel_lout C_SH_OUT $sel_cshout >> lna_nc_wide_summary.txt
echo W_SF $sel_wsf M_SF $sel_msf VBIAS_BUF $sel_vbbuf W_BIAS_SF $sel_wbisf M_BIAS_SF $sel_mbisf >> lna_nc_wide_summary.txt

echo ============================================================ >> lna_nc_wide_summary.txt
echo FINAL_DC >> lna_nc_wide_summary.txt
echo PDC_MW $f_pdc >> lna_nc_wide_summary.txt
echo NODES_V VX $f_vx D $f_d S $f_s NET8 $f_net8 NET11 $f_net11 NET3 $f_net3 NET10 $f_net10 VBUF $f_vbuf >> lna_nc_wide_summary.txt
echo XM1 ID_A $f_id1 GM_S $f_gm1 GDS_S $f_gds1 VDS_V $f_vds1 SAT_MARGIN_V $f_sat1 >> lna_nc_wide_summary.txt
echo XM2 ID_A $f_id2 GM_S $f_gm2 GMBS_S $f_gmb2 GDS_S $f_gds2 VDS_V $f_vds2 SAT_MARGIN_V $f_sat2 >> lna_nc_wide_summary.txt
echo XM3 ID_A $f_id3 GM_S $f_gm3 GDS_S $f_gds3 VDS_V $f_vds3 SAT_MARGIN_V $f_sat3 >> lna_nc_wide_summary.txt
echo XM4 ID_A $f_id4 GM_S $f_gm4 GDS_S $f_gds4 VDS_V $f_vds4 SAT_MARGIN_V $f_sat4 >> lna_nc_wide_summary.txt
echo XM5 ID_A $f_id5 GM_S $f_gm5 GDS_S $f_gds5 VDS_V $f_vds5 SAT_MARGIN_V $f_sat5 >> lna_nc_wide_summary.txt
echo XM6 ID_A $f_id6 GM_S $f_gm6 GDS_S $f_gds6 VDS_V $f_vds6 SAT_MARGIN_V $f_sat6 >> lna_nc_wide_summary.txt
echo XM7 ID_A $f_id7 GM_S $f_gm7 GDS_S $f_gds7 VDS_V $f_vds7 SAT_MARGIN_V $f_sat7 >> lna_nc_wide_summary.txt
echo XM9 ID_A $f_id9 GM_S $f_gm9 GDS_S $f_gds9 VDS_V $f_vds9 SAT_MARGIN_V $f_sat9 >> lna_nc_wide_summary.txt

echo ============================================================ >> lna_nc_wide_summary.txt
echo FINAL_DISCONNECTED_TARGET_BAND >> lna_nc_wide_summary.txt
echo S11_WORST_DB $fd_s11w S21_MIN_DB $fd_s21m S21_MAX_DB $fd_s21x RIPPLE_DB $fd_rip S22_WORST_DB $fd_s22w NF_WORST_DB $fd_nfw MU_MIN $fd_mumin MUP_MIN $fd_mupmin K_MIN $fd_kmin DELTA_MAX $fd_dmax >> lna_nc_wide_summary.txt
echo AT_2P4_GHZ S11_DB $fd_s11c S21_DB $fd_s21c S12_DB $fd_s12c S22_DB $fd_s22c NF_DB $fd_nfc NFMIN_DB $fd_nfminc >> lna_nc_wide_summary.txt

echo ============================================================ >> lna_nc_wide_summary.txt
echo FINAL_CONNECTED_TARGET_BAND >> lna_nc_wide_summary.txt
echo S11_WORST_DB $fc_s11w S21_MIN_DB $fc_s21m S21_MAX_DB $fc_s21x RIPPLE_DB $fc_rip S22_WORST_DB $fc_s22w NF_WORST_DB $fc_nfw MU_MIN $fc_mumin MUP_MIN $fc_mupmin K_MIN $fc_kmin DELTA_MAX $fc_dmax >> lna_nc_wide_summary.txt
echo AT_2P4_GHZ S11_DB $fc_s11c S21_DB $fc_s21c S12_DB $fc_s12c S22_DB $fc_s22c NF_DB $fc_nfc NFMIN_DB $fc_nfminc MU $fc_muc MUP $fc_mupc K $fc_kc DELTA_MAG $fc_dc >> lna_nc_wide_summary.txt
echo ZIN_2P4_OHM RE $fc_zinre IM $fc_zinim >> lna_nc_wide_summary.txt
echo ZOUT_2P4_OHM RE $fc_zoutre IM $fc_zoutim >> lna_nc_wide_summary.txt

echo ============================================================ >> lna_nc_wide_summary.txt
echo TRUE_NOISE_CANCELLATION_COMPARISON >> lna_nc_wide_summary.txt
echo NF_IMPROVEMENT_WORST_BAND_DB $&final_nf_imp_worst >> lna_nc_wide_summary.txt
echo NF_IMPROVEMENT_AT_2P4_DB $&final_nf_imp_2p4 >> lna_nc_wide_summary.txt
echo GAIN_CHANGE_AT_2P4_DB $&final_gain_change_2p4 >> lna_nc_wide_summary.txt

echo ============================================================ >> lna_nc_wide_summary.txt
echo WIDEBAND_STABILITY_10MHZ_TO_30GHZ >> lna_nc_wide_summary.txt
echo MU_MIN $fw_mumin MUP_MIN $fw_mupmin K_MIN $fw_kmin DELTA_MAX $fw_dmax >> lna_nc_wide_summary.txt

echo ============================================================ >> lna_nc_wide_summary.txt
echo FINAL_FORMAL_PASS $&final_formal >> lna_nc_wide_summary.txt
echo FINAL_NOISE_CANCELLING_FORMAL_PASS $&final_ncformal >> lna_nc_wide_summary.txt
echo ============================================================ >> lna_nc_wide_summary.txt

* ---------------- Clean and rank candidate database ----------------
* Columns:
*   3 FINITE, 4 VALID, 5 DCVALID, 6 FORMAL, 7 NCFORMAL, 8 SCORE, 9 RAWSCORE

shell grep '^POINT' lna_nc_wide_detailed.txt | grep -viE 'nan|inf' | sort -g -k8,8 > lna_nc_wide_ranked.txt
shell head -100 lna_nc_wide_ranked.txt > lna_nc_wide_top100.txt
shell awk '$6==1' lna_nc_wide_ranked.txt > lna_nc_wide_formal_pass.txt
shell awk '$8==1' lna_nc_wide_ranked.txt > lna_nc_wide_nc_formal_pass.txt

echo OUTPUT_FILES >> lna_nc_wide_summary.txt
echo DETAILED lna_nc_wide_detailed.txt >> lna_nc_wide_summary.txt
echo RANKED lna_nc_wide_ranked.txt >> lna_nc_wide_summary.txt
echo TOP100 lna_nc_wide_top100.txt >> lna_nc_wide_summary.txt
echo FORMAL_PASS_POINTS lna_nc_wide_formal_pass.txt >> lna_nc_wide_summary.txt
echo NC_FORMAL_PASS_POINTS lna_nc_wide_nc_formal_pass.txt >> lna_nc_wide_summary.txt
echo SUMMARY lna_nc_wide_summary.txt >> lna_nc_wide_summary.txt
echo CONNECTED_BAND lna_nc_wide_final_connected_band.dat >> lna_nc_wide_summary.txt
echo DISCONNECTED_BAND lna_nc_wide_final_disconnected_band.dat >> lna_nc_wide_summary.txt
echo BROADBAND lna_nc_wide_final_broadband.dat >> lna_nc_wide_summary.txt
echo STABILITY lna_nc_wide_final_stability.dat >> lna_nc_wide_summary.txt
echo RAW lna_nc_wide_final.raw >> lna_nc_wide_summary.txt

echo
echo ============================================================
echo LARGE-WINDOW SEARCH COMPLETE
echo Summary: lna_nc_wide_summary.txt
echo Ranked candidates: lna_nc_wide_ranked.txt
echo Formal target passes: lna_nc_wide_formal_pass.txt
echo Noise-cancelling formal passes: lna_nc_wide_nc_formal_pass.txt
echo ============================================================

quit
.endc
"
spice_ignore=true}
C {code.sym} 440 530 0 0 {name=s3 only_toplevel=false value="
.control

* VERSION: REFERENCE_STYLE_RAW_S_SCAN_V4
* Raw complex S-data are validated before scalar dB conversion.
* Invalid RF candidates are rejected without evaluating db/log10 on NaN.
*
set num_threads=6
option klu
set noaskquit
set wr_singlescale
set wr_vecnames
set numdgt=10
set appendwrite

* ============================================================================
* LARGE-WINDOW GF180MCU NOISE-CANCELLING LNA OPTIMIZER - M SWEEP
*
* Hard goals over 2.30-2.50 GHz:
*   minimum S21 >= 15 dB
*   worst NF <= 3.0 dB
*   worst S11 <= -10 dB
*   worst S22 <= -10 dB
*   gain ripple <= 1.5 dB
*   mu and mu' >= 1.05
*
* Each candidate is simulated twice:
*   1. CNC disconnected (1 aF)
*   2. CNC connected
*
* This gives a true noise-cancellation improvement:
*   NFIMP = NF_disconnected - NF_connected
*
* IMPORTANT SCHEMATIC REQUIREMENT:
*   RS_EQ_D net3  GND \{RS_EQ_D_VAL\}
*   CS_EQ_D net3  GND \{CSEQ_D_VAL\}
*   RS_EQ_S net10 GND \{RS_EQ_S_VAL\}
*   CS_EQ_S net10 GND \{CSEQ_S_VAL\}
* ============================================================================

* ---------------- Output files ----------------

shell rm -f lna_nc_wide_detailed.txt
shell rm -f lna_nc_wide_summary.txt
shell rm -f lna_nc_wide_ranked.txt
