  set sel_lin = $bestn_lin
  set sel_cshin = $bestn_cshin
  set sel_lout = $bestn_lout
  set sel_cshout = $bestn_cshout
  set sel_wsf = $bestn_wsf
  set sel_msf = $bestn_msf
  set sel_vbbuf = $bestn_vbbuf
  set sel_wbisf = $bestn_wbisf
  set sel_mbisf = $bestn_mbisf
end
echo G FOUND_VALID $stage_found_valid FOUND_FORMAL $stage_found_formal FOUND_NCFORMAL $stage_found_ncformal BEST_ANY $stage_best_any_score BEST_VALID $stage_best_valid_score BEST_FORMAL $stage_best_formal_score BEST_NCFORMAL $stage_best_ncformal_score >> lna_nc_wide_summary.txt
echo G_SELECTED LCG $sel_lcg WCG $sel_wcg MCG $sel_mcg VBCG $sel_vbcg RD1 $sel_rd1 LBICG $sel_lbicg WBICG $sel_wbicg MBICG $sel_mbicg VBICG $sel_vbicg LCS $sel_lcs WCS $sel_wcs MCS $sel_mcs VBCS $sel_vbcs WCAS $sel_wcas MCAS $sel_mcas VBCAS $sel_vbcas RD2 $sel_rd2 RS_D $sel_rs_d CS_D $sel_cs_d WCSC $sel_wcsc MCSC $sel_mcsc VBCSC $sel_vbcsc VBCASC $sel_vbcasc CNC $sel_cnc RS_S $sel_rs_s CS_S $sel_cs_s LIN $sel_lin CSHIN $sel_cshin LOUT $sel_lout CSHOUT $sel_cshout WSF $sel_wsf MSF $sel_msf VBBUF $sel_vbbuf WBISF $sel_wbisf MBISF $sel_mbisf >> lna_nc_wide_summary.txt
echo ============================================================ >> lna_nc_wide_summary.txt

* ============================================================================
* STAGE H - LARGE INPUT-MATCH WINDOW (120 candidates)
* ============================================================================

set stage_best_any_score = 1e99
set stage_best_valid_score = 1e99
set stage_best_formal_score = 1e99
set stage_best_ncformal_score = 1e99

set stage_found_valid = 0
set stage_found_formal = 0
set stage_found_ncformal = 0

* Any point
set besta_lcg = $sel_lcg
set besta_wcg = $sel_wcg
set besta_mcg = $sel_mcg
set besta_vbcg = $sel_vbcg
set besta_rd1 = $sel_rd1
set besta_lbicg = $sel_lbicg
set besta_wbicg = $sel_wbicg
set besta_mbicg = $sel_mbicg
set besta_vbicg = $sel_vbicg
set besta_lcs = $sel_lcs
set besta_wcs = $sel_wcs
set besta_mcs = $sel_mcs
set besta_vbcs = $sel_vbcs
set besta_wcas = $sel_wcas
set besta_mcas = $sel_mcas
set besta_vbcas = $sel_vbcas
set besta_rd2 = $sel_rd2
set besta_rs_d = $sel_rs_d
set besta_cs_d = $sel_cs_d
set besta_wcsc = $sel_wcsc
set besta_mcsc = $sel_mcsc
set besta_vbcsc = $sel_vbcsc
set besta_vbcasc = $sel_vbcasc
