foreach loutv 0.10n 0.20n 0.40n 0.60n 0.80n 1.00n 1.20n 1.50n 2.00n 2.50n 3.00n 4.00n
  foreach cshoutv 1f 50f 100f 150f 220f 330f 470f 680f 1p 1.5p

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
set cur_rd1 = $sel_rd1
set cur_lbicg = $sel_lbicg
