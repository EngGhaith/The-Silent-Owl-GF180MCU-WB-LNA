  set sel_mcs = $bestn_mcs
  set sel_vbcs = $bestn_vbcs
  set sel_wcas = $bestn_wcas
  set sel_mcas = $bestn_mcas
  set sel_vbcas = $bestn_vbcas
  set sel_rd2 = $bestn_rd2
  set sel_rs_d = $bestn_rs_d
  set sel_cs_d = $bestn_cs_d
  set sel_wcsc = $bestn_wcsc
  set sel_mcsc = $bestn_mcsc
  set sel_vbcsc = $bestn_vbcsc
