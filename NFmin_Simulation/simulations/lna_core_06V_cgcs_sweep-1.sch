foreach cncv 100f 150f 220f 330f 470f 680f 1p 1.5p 2p 3p 4p 6p
  foreach rssv 0.10 0.25 0.50 1 2 4 6 8 12
    foreach cssv 500f 1p 2p 3.3p 4.7p 6.8p 8.2p 10p 12p

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
