C {code_shown.sym} 40 45 0 0 {name=MODELS only_toplevel=true
format="tcleval( @value )"
value="
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice

.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice moscap_typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical

*.include /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_io/spice/gf180mcu_fd_io.spice
.include /media/sf_LNA_chipathon/The-Silent-Owl-GF180MCU-WB-LNA/analog_pad_sp_paramerters/xschem/gf180mcu_fd_io__asig_5p0.spice 
"}
C {code.sym} 1150 50 0 0 {name=s2 only_toplevel=false value="

* Supply / package
.param VDS=5.0
.param VDDIO_SUP=5.0
.param L_BW=2n
.param R_BW=0.2

* Input network; legal intentional total = 2 nH
.param L_IN=1.80n
.param R_L_IN=1.5
.param CIN_VAL=100p
.param C_SH_IN=1f

* XM2 common-gate input
.param VBIAS_CG=2.05
.param W_CG=160u
.param M_CG=2
.param L_CG=0.60u
.param RD1=680
.param RBIAS_CG=50k
.param CBYP_CG=20p

* Mixed-voltage XM1/XM4 stage
.param C12_VAL=47p
.param VBIAS_CS=0.95
.param W_CS=40u
.param M_CS=2
.param L_CS=0.28u
.param RBIAS_CS=50k
.param VBIAS_CAS=3.30
.param W_CAS=70u
.param M_CAS=1
.param L_CAS=0.60u
.param RD2=470

* XM1 source equalizer
.param RS_EQ=8
.param CSEQ_VAL=8.2p

* Body-tied source follower and gate stopper
.param W_SF=125u
.param M_SF=2
.param L_SF=0.60u
.param RG_SF_VAL=0.25

* Output network
.param COUT_VAL=47p
.param L_OUT=0.20n
.param R_L_OUT=1.5
.param C_SH_OUT=1f

* XM5 common-gate current sink
.param VBIAS_ICG=1.65
.param L_BIAS_CG=0.50u
.param W_BIAS_CG=25u
.param M_BIAS_CG=1

* XM6 follower current sink
.param VBIAS_BUF=2.20
.param L_BIAS_SF=0.50u
.param W_BIAS_SF=50u
.param M_BIAS_SF=3

* Series-RC shunt snubber from net9 to ground
.param C_STAB_VAL=1f
.param R_STAB_VAL=50
C_STAB net9 n_stab \{C_STAB_VAL\}
R_STAB n_stab GND \{R_STAB_VAL\}

.control
set noaskquit
set wr_singlescale
set wr_vecnames
set numdgt=10
set appendwrite

* Formal specifications
let target_s11 = -10
let target_s22 = -10
let target_gain = 15.0
let target_nf = 3.50
let target_ripple = 1.20
let target_pdc = 300
let target_mu = 1.05
let target_delta = 1.0

* Desired nominal margins
let margin_s11 = -12.0
let margin_s22 = -14.0
let margin_gain = 15.50
let margin_nf = 3.35
let margin_ripple = 1.10
let margin_tilt = 1.00
let margin_pdc = 240
let margin_mu_band = 1.20
let margin_mu_wide = 1.00
let margin_sat5 = 0.20
let margin_ratio25 = 4.00

* Hard validity
let min_satmargin_sink = 0.20
let min_satmargin_xm1 = 0.25
let min_satmargin_core = 0.40
let min_satmargin_cg = 0.50
let max_03v3_terminal = 3.00
let ltotal_limit = 2.0001e-9

echo ============================================================ > lna_v26_gain_nf_priority_summary.txt
echo LNA_V26_HIGH_GAIN_LOW_NF_GLOBAL_OPTIMIZER >> lna_v26_gain_nf_priority_summary.txt
echo FORMAL S11_-10 S22_-10 GAIN_15 NF_3P50 RIPPLE_1P2 PDC_300 MU_1P05 >> lna_v26_gain_nf_priority_summary.txt
echo MARGIN S11_-12 S22_-14 GAIN_15P50 NF_3P35 RIPPLE_1P10 TILT_1P00 PDC_240 BAND_MU_1P20 WIDE_MU_1P00 SAT5_0P20 RATIO_4P00 >> lna_v26_gain_nf_priority_summary.txt
echo SNUBBER_DISABLED_DEFAULT C_STAB_1f R_STAB_50 >> lna_v26_gain_nf_priority_summary.txt
echo ============================================================ >> lna_v26_gain_nf_priority_summary.txt

echo ============================================================ > lna_v26_gain_nf_priority_detailed.txt
echo LNA_V26_FINAL_FREQUENCY_DATA >> lna_v26_gain_nf_priority_detailed.txt
echo ============================================================ >> lna_v26_gain_nf_priority_detailed.txt

* Global best initialized from the strongest V24 Stage-C region
set global_best_score = 1e99
set best_wcg = 160u
set best_vbcg = 2.05
set best_rd1 = 680
set best_l5 = 0.50u
set best_w5 = 25u
set best_vbicg = 1.65
set best_c12 = 47p
set best_req = 8
set best_ceq = 8.2p
set best_rd2 = 470
set best_cout = 47p
set best_rg = 0.25
set best_cstab = 1f
set best_rstab = 50
set best_wsf = 125u
set best_l6 = 0.50u
set best_w6 = 50u
set best_m6 = 3
set best_vbuf = 2.20

* =============================================================================
* STAGE A — XM2 COARSE HIGH-GAIN / LOW-NF SEARCH: 5 x 5 x 4 = 100
* =============================================================================
echo STAGE_A_XM2_COARSE >> lna_v26_gain_nf_priority_summary.txt
foreach wcg 140u 150u 160u 170u 180u
  foreach vbcg 1.95 2.00 2.05 2.10 2.15
    foreach rd1v 640 680 720 760

      alterparam W_CG = $best_wcg
      alterparam VBIAS_CG = $best_vbcg
      alterparam RD1 = $best_rd1
      alterparam L_BIAS_CG = $best_l5
      alterparam W_BIAS_CG = $best_w5
      alterparam VBIAS_ICG = $best_vbicg
      alterparam C12_VAL = $best_c12
      alterparam RS_EQ = $best_req
      alterparam CSEQ_VAL = $best_ceq
      alterparam RD2 = $best_rd2
      alterparam COUT_VAL = $best_cout
      alterparam RG_SF_VAL = $best_rg
      alterparam C_STAB_VAL = $best_cstab
      alterparam R_STAB_VAL = $best_rstab

alterparam W_CG = $wcg
alterparam VBIAS_CG = $vbcg
alterparam RD1 = $rd1v

      reset
      op

      * ----- DC operating point -----
      let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))
      let vsrc1op = v(net3)
      let vx1op = v(net8)
      let v9op = v(net9)
      let vbufop = v(vbuf)

      let id1op = abs(@m.xm1.m0[id])
      let gm1op = @m.xm1.m0[gm]
      let gds1op = @m.xm1.m0[gds]
      let vgs1op = v(g_cs)-v(net3)
      let vgd1op = v(g_cs)-v(net8)
      let vgb1op = v(g_cs)
      let vds1op = v(net8)-v(net3)
      let vdsat1op = abs(@m.xm1.m0[vdsat])
      let sat1op = vds1op-vdsat1op

      let id2op = abs(@m.xm2.m0[id])
      let gm2op = @m.xm2.m0[gm]
      let gmb2op = @m.xm2.m0[gmbs]
      let gm2effop = gm2op+gmb2op
      let vds2op = v(d)-v(s)
      let vdsat2op = abs(@m.xm2.m0[vdsat])
      let sat2op = vds2op-vdsat2op

      let id3op = abs(@m.xm3.m0[id])
      let gm3op = @m.xm3.m0[gm]
      let gds3op = @m.xm3.m0[gds]
      let vds3op = v(vdcbias)-v(vbuf)
      let vdsat3op = abs(@m.xm3.m0[vdsat])
      let sat3op = vds3op-vdsat3op

      let id4op = abs(@m.xm4.m0[id])
      let gm4op = @m.xm4.m0[gm]
      let gds4op = @m.xm4.m0[gds]
      let vds4op = v(net9)-v(net8)
      let vdsat4op = abs(@m.xm4.m0[vdsat])
      let sat4op = vds4op-vdsat4op

      let id5op = abs(@m.xm5.m0[id])
      let gm5op = @m.xm5.m0[gm]
      let gds5op = @m.xm5.m0[gds]
      let vds5op = v(s)
      let vdsat5op = abs(@m.xm5.m0[vdsat])
      let sat5op = vds5op-vdsat5op

      let id6op = abs(@m.xm6.m0[id])
      let gm6op = @m.xm6.m0[gm]
      let gds6op = @m.xm6.m0[gds]
      let vds6op = v(vbuf)
      let vdsat6op = abs(@m.xm6.m0[vdsat])
      let sat6op = vds6op-vdsat6op

      let ratio25op = gm2effop/gm5op
      let ltotalop = 2.0e-9

      set op_pdc = $&pdcop
      set op_vsrc1 = $&vsrc1op
      set op_vx1 = $&vx1op
      set op_v9 = $&v9op
      set op_vbuf = $&vbufop
      set op_id1 = $&id1op
      set op_vgs1 = $&vgs1op
      set op_vgd1 = $&vgd1op
      set op_vgb1 = $&vgb1op
      set op_vds1 = $&vds1op
      set op_sat1 = $&sat1op
      set op_id2 = $&id2op
      set op_gm2eff = $&gm2effop
      set op_sat2 = $&sat2op
      set op_id3 = $&id3op
      set op_sat3 = $&sat3op
      set op_id4 = $&id4op
      set op_sat4 = $&sat4op
      set op_id5 = $&id5op
      set op_gm5 = $&gm5op
      set op_gds5 = $&gds5op
      set op_sat5 = $&sat5op
      set op_id6 = $&id6op
      set op_sat6 = $&sat6op
      set op_ratio25 = $&ratio25op
      set op_ltotal = $&ltotalop

      destroy $curplot

      * ----- Target-band S/noise/stability -----
      sp lin 101 2.30G 2.50G 1
      let s11db = db(s_1_1)
      let s21db = db(s_2_1)
      let s12db = db(s_1_2)
      let s22db = db(s_2_2)
      let nfdb = real(NF)

      let delta = s_1_1*s_2_2-s_1_2*s_2_1
      let md = mag(delta)
      let a11 = mag(s_1_1)
      let a12 = mag(s_1_2)
      let a21 = mag(s_2_1)
      let a22 = mag(s_2_2)
      let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))
      let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

      let s11w = maximum(s11db)
      let s21m = minimum(s21db)
      let s21x = maximum(s21db)
      let ripple = s21x-s21m
      let tilt = abs(s21db[0]-s21db[100])
      let s22w = maximum(s22db)
      let nfw = maximum(nfdb)
      let mumin = minimum(mu)
      let mupmin = minimum(mup)
      let dmax = maximum(md)

      let passcount = 0
      if s11w <= target_s11
        let passcount = passcount+1
      end
      if s22w <= target_s22
        let passcount = passcount+1
      end
      if s21m >= target_gain
        let passcount = passcount+1
      end
      if nfw <= target_nf
        let passcount = passcount+1
      end
      if ripple <= target_ripple
        let passcount = passcount+1
      end
      if $op_pdc <= target_pdc
        let passcount = passcount+1
      end
      if mumin >= target_mu
        let passcount = passcount+1
      end
      if mupmin >= target_mu
        let passcount = passcount+1
      end
      if dmax < target_delta
        let passcount = passcount+1
      end

      let dcvalid = 1
      if $op_pdc > target_pdc
        let dcvalid = 0
      end
      if $op_sat1 < min_satmargin_xm1
        let dcvalid = 0
      end
      if $op_sat2 < min_satmargin_cg
        let dcvalid = 0
      end
      if $op_sat3 < min_satmargin_core
        let dcvalid = 0
      end
      if $op_sat4 < min_satmargin_core
        let dcvalid = 0
      end
      if $op_sat5 < min_satmargin_sink
        let dcvalid = 0
      end
      if $op_sat6 < min_satmargin_sink
        let dcvalid = 0
      end
      if $op_id5 < 0.0015
        let dcvalid = 0
      end
      if $op_id5 > 0.0060
        let dcvalid = 0
      end
      if $op_id6 < 0.015
        let dcvalid = 0
      end
      if $op_id6 > 0.060
        let dcvalid = 0
      end
      if abs($op_vgs1) > max_03v3_terminal
        let dcvalid = 0
      end
      if abs($op_vgd1) > max_03v3_terminal
        let dcvalid = 0
      end
      if abs($op_vgb1) > max_03v3_terminal
        let dcvalid = 0
      end
      if abs($op_vds1) > max_03v3_terminal
        let dcvalid = 0
      end
      if $op_ltotal > ltotal_limit
        let dcvalid = 0
      end
      if $op_v9 <= $op_vx1
        let dcvalid = 0
      end
      if $op_vx1 <= $op_vsrc1
        let dcvalid = 0
      end

      let passall = 1
      if passcount < 9
        let passall = 0
      end
      if dcvalid = 0
        let passall = 0
      end

      let pgain = 0
      let pnf = 0
      let pripple = 0
      let ptilt = 0
      let ps11 = 0
      let ps22 = 0
      let ppdc = 0
      let pmu = 0
      let pmup = 0
      let psat5 = 0
      let pratio = 0

      if s21m < margin_gain
        let pgain = margin_gain-s21m
      end
      if nfw > margin_nf
        let pnf = nfw-margin_nf
      end
      if ripple > margin_ripple
        let pripple = ripple-margin_ripple
      end
      if tilt > margin_tilt
        let ptilt = tilt-margin_tilt
      end
      if s11w > margin_s11
        let ps11 = s11w-margin_s11
      end
      if s22w > margin_s22
        let ps22 = s22w-margin_s22
      end
      if $op_pdc > margin_pdc
        let ppdc = $op_pdc-margin_pdc
      end
      if mumin < margin_mu_band
        let pmu = margin_mu_band-mumin
      end
      if mupmin < margin_mu_band
        let pmup = margin_mu_band-mupmin
      end
      if $op_sat5 < margin_sat5
        let psat5 = margin_sat5-$op_sat5
      end
      if $op_ratio25 < margin_ratio25
        let pratio = margin_ratio25-$op_ratio25
      end

      let score = 5000*pgain+8000*pnf+300*pripple+50*ptilt
      let score = score+25*ps11+25*ps22+0.02*ppdc
      let score = score+75*pmu+75*pmup
      let score = score+20*psat5+5*pratio
      let score = score+20*nfw+10*ripple+2*tilt-0.75*s21m+0.0005*$op_pdc

      if passall = 0
        let score = score+1e7
      end
      if dcvalid = 0
        let score = score+1e8
      end

      echo A_XM2 WCG $wcg VBCG $vbcg RD1 $rd1v SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall PDC $op_pdc SAT5 $op_sat5 RATIO25 $op_ratio25 S11W $&s11w S21MIN $&s21m S21MAX $&s21x RIPPLE $&ripple TILT $&tilt S22W $&s22w NFW $&nfw MU $&mumin MUP $&mupmin DELTA $&dmax >> lna_v26_gain_nf_priority_summary.txt

      if score < $global_best_score
        set global_best_score = $&score
        set best_wcg = $wcg
      set best_vbcg = $vbcg
      set best_rd1 = $rd1v
      end

      destroy $curplot

    end
  end
end
echo GLOBAL_AFTER_A SCORE $global_best_score WCG $best_wcg VBCG $best_vbcg RD1 $best_rd1 >> lna_v26_gain_nf_priority_summary.txt

* =============================================================================
* STAGE B — XM5 LOW-NOISE SEARCH: 3 x 3 x 5 = 45
* =============================================================================
echo STAGE_B_XM5 >> lna_v26_gain_nf_priority_summary.txt
foreach l5 0.50u 0.60u 0.70u
  foreach w5 20u 25u 30u
    foreach vbicg 1.50 1.55 1.60 1.65 1.70

      alterparam W_CG = $best_wcg
      alterparam VBIAS_CG = $best_vbcg
      alterparam RD1 = $best_rd1
      alterparam L_BIAS_CG = $best_l5
      alterparam W_BIAS_CG = $best_w5
      alterparam VBIAS_ICG = $best_vbicg
      alterparam C12_VAL = $best_c12
      alterparam RS_EQ = $best_req
      alterparam CSEQ_VAL = $best_ceq
      alterparam RD2 = $best_rd2
      alterparam COUT_VAL = $best_cout
      alterparam RG_SF_VAL = $best_rg
      alterparam C_STAB_VAL = $best_cstab
      alterparam R_STAB_VAL = $best_rstab

alterparam L_BIAS_CG = $l5
alterparam W_BIAS_CG = $w5
alterparam VBIAS_ICG = $vbicg

      reset
      op

      * ----- DC operating point -----
      let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))
      let vsrc1op = v(net3)
      let vx1op = v(net8)
      let v9op = v(net9)
      let vbufop = v(vbuf)

      let id1op = abs(@m.xm1.m0[id])
      let gm1op = @m.xm1.m0[gm]
      let gds1op = @m.xm1.m0[gds]
      let vgs1op = v(g_cs)-v(net3)
      let vgd1op = v(g_cs)-v(net8)
      let vgb1op = v(g_cs)
      let vds1op = v(net8)-v(net3)
      let vdsat1op = abs(@m.xm1.m0[vdsat])
      let sat1op = vds1op-vdsat1op

      let id2op = abs(@m.xm2.m0[id])
      let gm2op = @m.xm2.m0[gm]
      let gmb2op = @m.xm2.m0[gmbs]
      let gm2effop = gm2op+gmb2op
      let vds2op = v(d)-v(s)
      let vdsat2op = abs(@m.xm2.m0[vdsat])
      let sat2op = vds2op-vdsat2op

      let id3op = abs(@m.xm3.m0[id])
      let gm3op = @m.xm3.m0[gm]
      let gds3op = @m.xm3.m0[gds]
      let vds3op = v(vdcbias)-v(vbuf)
      let vdsat3op = abs(@m.xm3.m0[vdsat])
      let sat3op = vds3op-vdsat3op

      let id4op = abs(@m.xm4.m0[id])
      let gm4op = @m.xm4.m0[gm]
      let gds4op = @m.xm4.m0[gds]
      let vds4op = v(net9)-v(net8)
      let vdsat4op = abs(@m.xm4.m0[vdsat])
      let sat4op = vds4op-vdsat4op

      let id5op = abs(@m.xm5.m0[id])
      let gm5op = @m.xm5.m0[gm]
      let gds5op = @m.xm5.m0[gds]
      let vds5op = v(s)
      let vdsat5op = abs(@m.xm5.m0[vdsat])
      let sat5op = vds5op-vdsat5op

      let id6op = abs(@m.xm6.m0[id])
      let gm6op = @m.xm6.m0[gm]
      let gds6op = @m.xm6.m0[gds]
      let vds6op = v(vbuf)
      let vdsat6op = abs(@m.xm6.m0[vdsat])
      let sat6op = vds6op-vdsat6op

      let ratio25op = gm2effop/gm5op
      let ltotalop = 2.0e-9

      set op_pdc = $&pdcop
      set op_vsrc1 = $&vsrc1op
      set op_vx1 = $&vx1op
      set op_v9 = $&v9op
      set op_vbuf = $&vbufop
      set op_id1 = $&id1op
      set op_vgs1 = $&vgs1op
      set op_vgd1 = $&vgd1op
      set op_vgb1 = $&vgb1op
      set op_vds1 = $&vds1op
      set op_sat1 = $&sat1op
      set op_id2 = $&id2op
      set op_gm2eff = $&gm2effop
      set op_sat2 = $&sat2op
      set op_id3 = $&id3op
      set op_sat3 = $&sat3op
      set op_id4 = $&id4op
      set op_sat4 = $&sat4op
      set op_id5 = $&id5op
      set op_gm5 = $&gm5op
      set op_gds5 = $&gds5op
      set op_sat5 = $&sat5op
      set op_id6 = $&id6op
      set op_sat6 = $&sat6op
      set op_ratio25 = $&ratio25op
      set op_ltotal = $&ltotalop

      destroy $curplot

      * ----- Target-band S/noise/stability -----
      sp lin 101 2.30G 2.50G 1
      let s11db = db(s_1_1)
      let s21db = db(s_2_1)
      let s12db = db(s_1_2)
      let s22db = db(s_2_2)
      let nfdb = real(NF)

      let delta = s_1_1*s_2_2-s_1_2*s_2_1
      let md = mag(delta)
      let a11 = mag(s_1_1)
      let a12 = mag(s_1_2)
      let a21 = mag(s_2_1)
      let a22 = mag(s_2_2)
      let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))
      let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

      let s11w = maximum(s11db)
      let s21m = minimum(s21db)
      let s21x = maximum(s21db)
      let ripple = s21x-s21m
      let tilt = abs(s21db[0]-s21db[100])
      let s22w = maximum(s22db)
      let nfw = maximum(nfdb)
      let mumin = minimum(mu)
      let mupmin = minimum(mup)
      let dmax = maximum(md)

      let passcount = 0
      if s11w <= target_s11
        let passcount = passcount+1
      end
      if s22w <= target_s22
        let passcount = passcount+1
      end
      if s21m >= target_gain
        let passcount = passcount+1
      end
      if nfw <= target_nf
        let passcount = passcount+1
      end
      if ripple <= target_ripple
        let passcount = passcount+1
      end
      if $op_pdc <= target_pdc
        let passcount = passcount+1
      end
      if mumin >= target_mu
        let passcount = passcount+1
      end
      if mupmin >= target_mu
        let passcount = passcount+1
      end
      if dmax < target_delta
        let passcount = passcount+1
      end

      let dcvalid = 1
      if $op_pdc > target_pdc
        let dcvalid = 0
      end
      if $op_sat1 < min_satmargin_xm1
        let dcvalid = 0
      end
      if $op_sat2 < min_satmargin_cg
        let dcvalid = 0
      end
      if $op_sat3 < min_satmargin_core
        let dcvalid = 0
      end
      if $op_sat4 < min_satmargin_core
        let dcvalid = 0
      end
      if $op_sat5 < min_satmargin_sink
        let dcvalid = 0
      end
      if $op_sat6 < min_satmargin_sink
        let dcvalid = 0
      end
      if $op_id5 < 0.0015
        let dcvalid = 0
      end
      if $op_id5 > 0.0060
        let dcvalid = 0
      end
      if $op_id6 < 0.015
        let dcvalid = 0
      end
      if $op_id6 > 0.060
        let dcvalid = 0
      end
      if abs($op_vgs1) > max_03v3_terminal
        let dcvalid = 0
      end
      if abs($op_vgd1) > max_03v3_terminal
        let dcvalid = 0
      end
      if abs($op_vgb1) > max_03v3_terminal
        let dcvalid = 0
      end
      if abs($op_vds1) > max_03v3_terminal
        let dcvalid = 0
      end
      if $op_ltotal > ltotal_limit
        let dcvalid = 0
      end
      if $op_v9 <= $op_vx1
        let dcvalid = 0
      end
      if $op_vx1 <= $op_vsrc1
        let dcvalid = 0
      end

      let passall = 1
      if passcount < 9
        let passall = 0
      end
      if dcvalid = 0
        let passall = 0
      end

      let pgain = 0
      let pnf = 0
      let pripple = 0
      let ptilt = 0
      let ps11 = 0
      let ps22 = 0
      let ppdc = 0
      let pmu = 0
      let pmup = 0
      let psat5 = 0
      let pratio = 0

      if s21m < margin_gain
        let pgain = margin_gain-s21m
      end
      if nfw > margin_nf
        let pnf = nfw-margin_nf
      end
      if ripple > margin_ripple
        let pripple = ripple-margin_ripple
      end
      if tilt > margin_tilt
        let ptilt = tilt-margin_tilt
      end
      if s11w > margin_s11
        let ps11 = s11w-margin_s11
      end
      if s22w > margin_s22
        let ps22 = s22w-margin_s22
      end
      if $op_pdc > margin_pdc
        let ppdc = $op_pdc-margin_pdc
      end
      if mumin < margin_mu_band
        let pmu = margin_mu_band-mumin
      end
      if mupmin < margin_mu_band
        let pmup = margin_mu_band-mupmin
      end
      if $op_sat5 < margin_sat5
        let psat5 = margin_sat5-$op_sat5
      end
      if $op_ratio25 < margin_ratio25
        let pratio = margin_ratio25-$op_ratio25
      end

      let score = 5000*pgain+8000*pnf+300*pripple+50*ptilt
      let score = score+25*ps11+25*ps22+0.02*ppdc
      let score = score+75*pmu+75*pmup
      let score = score+20*psat5+5*pratio
      let score = score+20*nfw+10*ripple+2*tilt-0.75*s21m+0.0005*$op_pdc

      if passall = 0
        let score = score+1e7
      end
      if dcvalid = 0
        let score = score+1e8
      end

      echo B_XM5 L5 $l5 W5 $w5 VBICG $vbicg SCORE $&score DCVALID $&dcvalid PASSCOUNT $&passcount PASSALL $&passall PDC $op_pdc SAT5 $op_sat5 RATIO25 $op_ratio25 S11W $&s11w S21MIN $&s21m S21MAX $&s21x RIPPLE $&ripple TILT $&tilt S22W $&s22w NFW $&nfw MU $&mumin MUP $&mupmin DELTA $&dmax >> lna_v26_gain_nf_priority_summary.txt

      if score < $global_best_score
        set global_best_score = $&score
        set best_l5 = $l5
      set best_w5 = $w5
      set best_vbicg = $vbicg
      end

      destroy $curplot

    end
  end
end
echo GLOBAL_AFTER_B SCORE $global_best_score L5 $best_l5 W5 $best_w5 VBICG $best_vbicg >> lna_v26_gain_nf_priority_summary.txt

* =============================================================================
* STAGE C — JOINT XM2/XM5 HIGH-GAIN LOW-NF SEARCH: 5 x 5 x 4 x 3 x 4 = 1200
* =============================================================================
echo STAGE_C_JOINT_XM2_XM5 >> lna_v26_gain_nf_priority_summary.txt
foreach wcg 140u 150u 160u 170u 180u
  foreach vbcg 1.95 2.00 2.05 2.10 2.15
    foreach rd1v 640 680 720 760
      foreach w5 20u 25u 30u
        foreach vbicg 1.50 1.55 1.60 1.65

          alterparam W_CG = $best_wcg
          alterparam VBIAS_CG = $best_vbcg
          alterparam RD1 = $best_rd1
          alterparam L_BIAS_CG = $best_l5
          alterparam W_BIAS_CG = $best_w5
          alterparam VBIAS_ICG = $best_vbicg
          alterparam C12_VAL = $best_c12
          alterparam RS_EQ = $best_req
          alterparam CSEQ_VAL = $best_ceq
          alterparam RD2 = $best_rd2
          alterparam COUT_VAL = $best_cout
          alterparam RG_SF_VAL = $best_rg
          alterparam C_STAB_VAL = $best_cstab
          alterparam R_STAB_VAL = $best_rstab

alterparam W_CG = $wcg
alterparam VBIAS_CG = $vbcg
alterparam RD1 = $rd1v
alterparam L_BIAS_CG = $best_l5
alterparam W_BIAS_CG = $w5
alterparam VBIAS_ICG = $vbicg

          reset
          op

          * ----- DC operating point -----
          let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))
          let vsrc1op = v(net3)
          let vx1op = v(net8)
          let v9op = v(net9)
          let vbufop = v(vbuf)

          let id1op = abs(@m.xm1.m0[id])
          let gm1op = @m.xm1.m0[gm]
          let gds1op = @m.xm1.m0[gds]
          let vgs1op = v(g_cs)-v(net3)
          let vgd1op = v(g_cs)-v(net8)
          let vgb1op = v(g_cs)
          let vds1op = v(net8)-v(net3)
          let vdsat1op = abs(@m.xm1.m0[vdsat])
          let sat1op = vds1op-vdsat1op

          let id2op = abs(@m.xm2.m0[id])
          let gm2op = @m.xm2.m0[gm]
          let gmb2op = @m.xm2.m0[gmbs]
          let gm2effop = gm2op+gmb2op
          let vds2op = v(d)-v(s)
          let vdsat2op = abs(@m.xm2.m0[vdsat])
          let sat2op = vds2op-vdsat2op

          let id3op = abs(@m.xm3.m0[id])
          let gm3op = @m.xm3.m0[gm]
          let gds3op = @m.xm3.m0[gds]
          let vds3op = v(vdcbias)-v(vbuf)
          let vdsat3op = abs(@m.xm3.m0[vdsat])
          let sat3op = vds3op-vdsat3op

          let id4op = abs(@m.xm4.m0[id])
          let gm4op = @m.xm4.m0[gm]
          let gds4op = @m.xm4.m0[gds]
          let vds4op = v(net9)-v(net8)
          let vdsat4op = abs(@m.xm4.m0[vdsat])
          let sat4op = vds4op-vdsat4op

          let id5op = abs(@m.xm5.m0[id])
          let gm5op = @m.xm5.m0[gm]
          let gds5op = @m.xm5.m0[gds]
          let vds5op = v(s)
          let vdsat5op = abs(@m.xm5.m0[vdsat])
          let sat5op = vds5op-vdsat5op

          let id6op = abs(@m.xm6.m0[id])
          let gm6op = @m.xm6.m0[gm]
          let gds6op = @m.xm6.m0[gds]
          let vds6op = v(vbuf)
          let vdsat6op = abs(@m.xm6.m0[vdsat])
          let sat6op = vds6op-vdsat6op

          let ratio25op = gm2effop/gm5op
          let ltotalop = 2.0e-9

          set op_pdc = $&pdcop
          set op_vsrc1 = $&vsrc1op
          set op_vx1 = $&vx1op
          set op_v9 = $&v9op
          set op_vbuf = $&vbufop
          set op_id1 = $&id1op
          set op_vgs1 = $&vgs1op
          set op_vgd1 = $&vgd1op
          set op_vgb1 = $&vgb1op
          set op_vds1 = $&vds1op
          set op_sat1 = $&sat1op
          set op_id2 = $&id2op
          set op_gm2eff = $&gm2effop
          set op_sat2 = $&sat2op
          set op_id3 = $&id3op
          set op_sat3 = $&sat3op
          set op_id4 = $&id4op
          set op_sat4 = $&sat4op
          set op_id5 = $&id5op
          set op_gm5 = $&gm5op
          set op_gds5 = $&gds5op
          set op_sat5 = $&sat5op
          set op_id6 = $&id6op
          set op_sat6 = $&sat6op
          set op_ratio25 = $&ratio25op
          set op_ltotal = $&ltotalop

          destroy $curplot

          * ----- Target-band S/noise/stability -----
          sp lin 101 2.30G 2.50G 1
          let s11db = db(s_1_1)
          let s21db = db(s_2_1)
          let s12db = db(s_1_2)
          let s22db = db(s_2_2)
          let nfdb = real(NF)

          let delta = s_1_1*s_2_2-s_1_2*s_2_1
          let md = mag(delta)
          let a11 = mag(s_1_1)
          let a12 = mag(s_1_2)
          let a21 = mag(s_2_1)
          let a22 = mag(s_2_2)
          let mu = (1-a11*a11)/(mag(s_2_2-delta*conj(s_1_1))+mag(s_1_2*s_2_1))
          let mup = (1-a22*a22)/(mag(s_1_1-delta*conj(s_2_2))+mag(s_1_2*s_2_1))

          let s11w = maximum(s11db)
          let s21m = minimum(s21db)
          let s21x = maximum(s21db)
          let ripple = s21x-s21m
          let tilt = abs(s21db[0]-s21db[100])
          let s22w = maximum(s22db)
          let nfw = maximum(nfdb)
          let mumin = minimum(mu)
          let mupmin = minimum(mup)
          let dmax = maximum(md)

          let passcount = 0
          if s11w <= target_s11
            let passcount = passcount+1
          end
          if s22w <= target_s22
            let passcount = passcount+1
          end
          if s21m >= target_gain
            let passcount = passcount+1
          end
          if nfw <= target_nf
            let passcount = passcount+1
          end
          if ripple <= target_ripple
            let passcount = passcount+1
          end
          if $op_pdc <= target_pdc
            let passcount = passcount+1
          end
          if mumin >= target_mu
            let passcount = passcount+1
          end
          if mupmin >= target_mu
            let passcount = passcount+1
          end
          if dmax < target_delta
            let passcount = passcount+1
          end

          let dcvalid = 1
          if $op_pdc > target_pdc
            let dcvalid = 0
          end
          if $op_sat1 < min_satmargin_xm1
            let dcvalid = 0
          end
          if $op_sat2 < min_satmargin_cg
            let dcvalid = 0
          end
          if $op_sat3 < min_satmargin_core
            let dcvalid = 0
          end
          if $op_sat4 < min_satmargin_core
            let dcvalid = 0
          end
          if $op_sat5 < min_satmargin_sink
            let dcvalid = 0
          end
          if $op_sat6 < min_satmargin_sink
            let dcvalid = 0
          end
          if $op_id5 < 0.0015
            let dcvalid = 0
          end
          if $op_id5 > 0.0060
            let dcvalid = 0
          end
          if $op_id6 < 0.015
            let dcvalid = 0
          end
          if $op_id6 > 0.060
            let dcvalid = 0
          end
          if abs($op_vgs1) > max_03v3_terminal
            let dcvalid = 0
          end
          if abs($op_vgd1) > max_03v3_terminal
            let dcvalid = 0
          end
          if abs($op_vgb1) > max_03v3_terminal
            let dcvalid = 0
          end
          if abs($op_vds1) > max_03v3_terminal
            let dcvalid = 0
          end
          if $op_ltotal > ltotal_limit
            let dcvalid = 0
          end
          if $op_v9 <= $op_vx1
            let dcvalid = 0
          end
          if $op_vx1 <= $op_vsrc1
            let dcvalid = 0
          end

          let passall = 1
          if passcount < 9
            let passall = 0
          end
          if dcvalid = 0
            let passall = 0
          end

          let pgain = 0
          let pnf = 0
          let pripple = 0
          let ptilt = 0
          let ps11 = 0
          let ps22 = 0
          let ppdc = 0
          let pmu = 0
          let pmup = 0
          let psat5 = 0
          let pratio = 0

          if s21m < margin_gain
            let pgain = margin_gain-s21m
          end
          if nfw > margin_nf
            let pnf = nfw-margin_nf
          end
          if ripple > margin_ripple
            let pripple = ripple-margin_ripple
          end
          if tilt > margin_tilt
            let ptilt = tilt-margin_tilt
          end
          if s11w > margin_s11
            let ps11 = s11w-margin_s11
          end
          if s22w > margin_s22
            let ps22 = s22w-margin_s22
          end
          if $op_pdc > margin_pdc
            let ppdc = $op_pdc-margin_pdc
          end
          if mumin < margin_mu_band
            let pmu = margin_mu_band-mumin
          end
          if mupmin < margin_mu_band
            let pmup = margin_mu_band-mupmin
          end
          if $op_sat5 < margin_sat5
            let psat5 = margin_sat5-$op_sat5
          end
          if $op_ratio25 < margin_ratio25
            let pratio = margin_ratio25-$op_ratio25
          end

          let score = 5000*pgain+8000*pnf+300*pripple+50*ptilt
          let score = score+25*ps11+25*ps22+0.02*ppdc
