set cur_cs_s = $sel_cs_s
set cur_lin = $sel_lin
set cur_cshin = $sel_cshin
set cur_lout = $sel_lout
set cur_cshout = $sel_cshout
set cur_wsf = $sel_wsf
set cur_msf = $sel_msf
set cur_vbbuf = $sel_vbbuf
set cur_wbisf = $sel_wbisf
set cur_mbisf = $sel_mbisf

set cur_lout = $loutv

set cur_cshout = $cshoutv

* Apply candidate parameters
    alterparam L_CG = $cur_lcg
    alterparam W_CG = $cur_wcg
    alterparam M_CG = $cur_mcg
    alterparam VBIAS_CG = $cur_vbcg
    alterparam RD1 = $cur_rd1

    alterparam L_BIAS_CG = $cur_lbicg
    alterparam W_BIAS_CG = $cur_wbicg
    alterparam M_BIAS_CG = $cur_mbicg
    alterparam VBIAS_ICG = $cur_vbicg

    alterparam L_CS = $cur_lcs
    alterparam W_CS = $cur_wcs
    alterparam M_CS = $cur_mcs
    alterparam VBIAS_CS = $cur_vbcs

    alterparam W_CAS = $cur_wcas
    alterparam M_CAS = $cur_mcas
    alterparam VBIAS_CAS = $cur_vbcas
    alterparam RD2 = $cur_rd2

    alterparam RS_EQ_D_VAL = $cur_rs_d
    alterparam CSEQ_D_VAL = $cur_cs_d

    alterparam W_CSC = $cur_wcsc
    alterparam M_CSC = $cur_mcsc
    alterparam VBIAS_CSC = $cur_vbcsc
    alterparam VBIAS_CASC = $cur_vbcasc
    alterparam CNC_VAL = $cur_cnc
    alterparam RS_EQ_S_VAL = $cur_rs_s
    alterparam CSEQ_S_VAL = $cur_cs_s

    alterparam L_IN = $cur_lin
    alterparam C_SH_IN = $cur_cshin
    alterparam L_OUT = $cur_lout
    alterparam C_SH_OUT = $cur_cshout

    alterparam W_SF = $cur_wsf
    alterparam M_SF = $cur_msf
    alterparam VBIAS_BUF = $cur_vbbuf
    alterparam W_BIAS_SF = $cur_wbisf
    alterparam M_BIAS_SF = $cur_mbisf

    reset
    op

    * ---------------- DC checks ----------------

    let pdcop = 1e3*(abs(i(VDD))*v(vdcbias)+abs(i(VDDIO))*v(vddio))

    let vxop = v(vx)
    let vdop = v(d)
    let vsop = v(s)
    let v8op = v(net8)
    let v11op = v(net11)
    let v3op = v(net3)
    let v10op = v(net10)
    let vbufop = v(vbuf)

    let id1op = abs(@m.xm1.m0[id])
    let gm1op = @m.xm1.m0[gm]
    let vds1op = v(net8)-v(net3)
    let sat1op = vds1op-abs(@m.xm1.m0[vdsat])
    let vgs1op = v(g_cs)-v(net3)
    let vgd1op = v(g_cs)-v(net8)
    let vgb1op = v(g_cs)

    let id2op = abs(@m.xm2.m0[id])
    let gm2op = @m.xm2.m0[gm]
    let vds2op = v(d)-v(s)
    let sat2op = vds2op-abs(@m.xm2.m0[vdsat])

    let id3op = abs(@m.xm3.m0[id])
    let vds3op = v(vdcbias)-v(vbuf)
    let sat3op = vds3op-abs(@m.xm3.m0[vdsat])

    let id4op = abs(@m.xm4.m0[id])
    let vds4op = v(vx)-v(net8)
    let sat4op = vds4op-abs(@m.xm4.m0[vdsat])

    let id5op = abs(@m.xm5.m0[id])
    let gm5op = @m.xm5.m0[gm]
    let vds5op = v(s)
    let sat5op = vds5op-abs(@m.xm5.m0[vdsat])
    let vgs5op = v(vbias_icg)
    let vgd5op = v(vbias_icg)-v(s)

    let id6op = abs(@m.xm6.m0[id])
    let vds6op = v(vbuf)
    let sat6op = vds6op-abs(@m.xm6.m0[vdsat])
    let vgs6op = v(vbias_buf)
    let vgd6op = v(vbias_buf)-v(vbuf)

    let id7op = abs(@m.xm7.m0[id])
    let vds7op = v(vx)-v(net11)
    let sat7op = vds7op-abs(@m.xm7.m0[vdsat])

    let id9op = abs(@m.xm9.m0[id])
    let gm9op = @m.xm9.m0[gm]
    let vds9op = v(net11)-v(net10)
    let sat9op = vds9op-abs(@m.xm9.m0[vdsat])
    let vgs9op = v(g_csc)-v(net10)
    let vgd9op = v(g_csc)-v(net11)
    let vgb9op = v(g_csc)

    let dcvalid = 1

    if pdcop > target_pdc
      let dcvalid = 0
    end
    if sat1op < min_sat_xm1
      let dcvalid = 0
    end
    if sat2op < min_sat_xm2
      let dcvalid = 0
    end
    if sat3op < min_sat_cas
      let dcvalid = 0
    end
    if sat4op < min_sat_cas
      let dcvalid = 0
    end
    if sat5op < min_sat_sink
      let dcvalid = 0
    end
    if sat6op < min_sat_sink
      let dcvalid = 0
    end
    if sat7op < min_sat_cas
      let dcvalid = 0
    end
    if sat9op < min_sat_xm1
      let dcvalid = 0
    end

    if id1op < 1e-4
      let dcvalid = 0
    end
    if id2op < 1e-4
      let dcvalid = 0
    end
    if id9op < 1e-6
      let dcvalid = 0
    end

    if vxop <= v8op
      let dcvalid = 0
    end
    if v8op <= v3op
      let dcvalid = 0
    end
    if vxop <= v11op
      let dcvalid = 0
    end
    if v11op <= v10op
      let dcvalid = 0
    end

    if abs(vgs1op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vgd1op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vgb1op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vds1op) > max_03v3_terminal
      let dcvalid = 0
    end

    if abs(vgs5op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vgd5op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vds5op) > max_03v3_terminal
      let dcvalid = 0
    end

    if abs(vgs6op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vgd6op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vds6op) > max_03v3_terminal
      let dcvalid = 0
    end

    if abs(vgs9op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vgd9op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vgb9op) > max_03v3_terminal
      let dcvalid = 0
    end
    if abs(vds9op) > max_03v3_terminal
      let dcvalid = 0
    end

    set op_pdc = $&pdcop
    set op_vx = $&vxop
    set op_d = $&vdop
    set op_s = $&vsop
    set op_v8 = $&v8op
    set op_v11 = $&v11op
    set op_v3 = $&v3op
    set op_v10 = $&v10op
    set op_vbuf = $&vbufop
    set op_id1 = $&id1op
    set op_id2 = $&id2op
    set op_id4 = $&id4op
    set op_id5 = $&id5op
    set op_id7 = $&id7op
    set op_id9 = $&id9op
    set op_gm1 = $&gm1op
    set op_gm2 = $&gm2op
    set op_gm5 = $&gm5op
    set op_gm9 = $&gm9op
    set op_sat1 = $&sat1op
    set op_sat2 = $&sat2op
    set op_sat4 = $&sat4op
    set op_sat5 = $&sat5op
    set op_sat7 = $&sat7op
    set op_sat9 = $&sat9op
    set op_dcvalid = $&dcvalid

    destroy $curplot

    
* ---------------- Same-candidate RF-off reference ----------------
*
* Reference-style robust evaluator:
*   1. Run a fresh SP plot.
*   2. Scan raw complex S-parameters sample by sample.
*   3. Reject NaN/Inf before any dB or log10 operation.
*   4. Convert only finite positive scalar extrema to dB.
*
* Some large-sweep candidates converge in DC but return invalid RF samples.
* Those candidates are rejected without aborting the optimizer.

alterparam CNC_VAL = 1a
reset
sp lin 41 2.30G 2.50G 1

let off_rfok = 1
let off_npts = length(frequency)
let off_ii = 0

let off_s11maxmag = 1e-30
let off_s21minmag = 1e30
let off_s22maxmag = 1e-30
let off_nfw = -1e30

let off_s21cmag = 1e-30
let off_nfc = 999

while off_ii < off_npts

  let off_m11 = mag(s_1_1[off_ii])
  let off_m21 = mag(s_2_1[off_ii])
  let off_m22 = mag(s_2_2[off_ii])
  let off_nfi = real(NF[off_ii])

  let off_sampleok = 0

  if off_m11 > -1
    if off_m11 < 1e20
      if off_m21 > -1
        if off_m21 < 1e20
          if off_m22 > -1
            if off_m22 < 1e20
              if off_nfi > -1000
                if off_nfi < 1000
                  let off_sampleok = 1
                end
              end
            end
          end
        end
      end
    end
  end

  if off_sampleok = 0
    let off_rfok = 0
  end

  if off_sampleok = 1

    if off_m11 < 1e-30
      let off_m11 = 1e-30
    end
    if off_m21 < 1e-30
      let off_m21 = 1e-30
    end
    if off_m22 < 1e-30
      let off_m22 = 1e-30
    end

    if off_m11 > off_s11maxmag
      let off_s11maxmag = off_m11
    end
    if off_m21 < off_s21minmag
      let off_s21minmag = off_m21
    end
    if off_m22 > off_s22maxmag
      let off_s22maxmag = off_m22
    end
    if off_nfi > off_nfw
      let off_nfw = off_nfi
    end

    if off_ii = 20
      let off_s21cmag = off_m21
      let off_nfc = off_nfi
    end

  end

  let off_ii = off_ii+1
end

let off_s11w = 999
let off_s21m = -999
let off_s22w = 999
let off_s21c = -999

if off_rfok = 1
  let off_s11w = 20*log10(off_s11maxmag)
  let off_s21m = 20*log10(off_s21minmag)
  let off_s22w = 20*log10(off_s22maxmag)
  let off_s21c = 20*log10(off_s21cmag)
end

set rf_off_ok = $&off_rfok
set rf_off_s11w = $&off_s11w
set rf_off_s21m = $&off_s21m
set rf_off_s22w = $&off_s22w
set rf_off_nfw = $&off_nfw
set rf_off_s21c = $&off_s21c
set rf_off_nfc = $&off_nfc

destroy $curplot

* ---------------- Connected candidate ----------------

alterparam CNC_VAL = $cur_cnc
reset
sp lin 41 2.30G 2.50G 1

let on_rfok = 1
let on_npts = length(frequency)
let on_ii = 0

let on_s11maxmag = 1e-30
let on_s21minmag = 1e30
let on_s21maxmag = 1e-30
let on_s22maxmag = 1e-30
let on_nfw = -1e30

let on_mumin = 1e30
let on_mupmin = 1e30
let on_kmin = 1e30
let on_dmax = 0

let on_s21cmag = 1e-30
let on_nfc = 999

let zinre = 1e30
let zinim = 1e30
let zoutre = 1e30
let zoutim = 1e30

while on_ii < on_npts

  let on_s11i = s_1_1[on_ii]
  let on_s21i = s_2_1[on_ii]
  let on_s12i = s_1_2[on_ii]
  let on_s22i = s_2_2[on_ii]

  let on_m11 = mag(on_s11i)
  let on_m21 = mag(on_s21i)
  let on_m12 = mag(on_s12i)
  let on_m22 = mag(on_s22i)
  let on_nfi = real(NF[on_ii])

  let on_sampleok = 0

  if on_m11 > -1
    if on_m11 < 1e20
      if on_m21 > -1
        if on_m21 < 1e20
          if on_m12 > -1
            if on_m12 < 1e20
              if on_m22 > -1
                if on_m22 < 1e20
                  if on_nfi > -1000
                    if on_nfi < 1000
                      let on_sampleok = 1
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  if on_sampleok = 1

    let on_deltai = on_s11i*on_s22i-on_s12i*on_s21i
    let on_mdi = mag(on_deltai)

    let on_mui = (1-on_m11*on_m11)/(mag(on_s22i-on_deltai*conj(on_s11i))+mag(on_s12i*on_s21i)+1e-30)
    let on_mupi = (1-on_m22*on_m22)/(mag(on_s11i-on_deltai*conj(on_s22i))+mag(on_s12i*on_s21i)+1e-30)
    let on_ki = (1-on_m11*on_m11-on_m22*on_m22+on_mdi*on_mdi)/(2*on_m12*on_m21+1e-30)

    let on_stabok = 0

    if on_mdi > -1e20
      if on_mdi < 1e20
        if on_mui > -1e20
          if on_mui < 1e20
            if on_mupi > -1e20
              if on_mupi < 1e20
                if on_ki > -1e20
                  if on_ki < 1e20
                    let on_stabok = 1
                  end
                end
              end
            end
          end
        end
      end
    end

    if on_stabok = 0
      let on_sampleok = 0
    end

  end

  if on_sampleok = 0
    let on_rfok = 0
  end

  if on_sampleok = 1

    if on_m11 < 1e-30
      let on_m11 = 1e-30
    end
    if on_m21 < 1e-30
      let on_m21 = 1e-30
    end
    if on_m12 < 1e-30
      let on_m12 = 1e-30
    end
    if on_m22 < 1e-30
      let on_m22 = 1e-30
    end

    if on_m11 > on_s11maxmag
      let on_s11maxmag = on_m11
    end
    if on_m21 < on_s21minmag
      let on_s21minmag = on_m21
    end
    if on_m21 > on_s21maxmag
      let on_s21maxmag = on_m21
    end
    if on_m22 > on_s22maxmag
      let on_s22maxmag = on_m22
    end
    if on_nfi > on_nfw
      let on_nfw = on_nfi
    end

    if on_mui < on_mumin
      let on_mumin = on_mui
    end
    if on_mupi < on_mupmin
      let on_mupmin = on_mupi
    end
    if on_ki < on_kmin
      let on_kmin = on_ki
    end
    if on_mdi > on_dmax
      let on_dmax = on_mdi
    end

    if on_ii = 20
      let on_s21cmag = on_m21
      let on_nfc = on_nfi

      let on_zinden = mag(1-on_s11i)
      let on_zoutden = mag(1-on_s22i)

      if on_zinden > 1e-20
        let on_zini = 50*(1+on_s11i)/(1-on_s11i)
        let zinre = real(on_zini)
        let zinim = imag(on_zini)
      end

      if on_zoutden > 1e-20
        let on_zouti = 50*(1+on_s22i)/(1-on_s22i)
        let zoutre = real(on_zouti)
        let zoutim = imag(on_zouti)
      end

    end

  end

  let on_ii = on_ii+1
end

let on_s11w = 999
let on_s21m = -999
let on_s21x = -999
let on_ripple = 999
let on_s22w = 999
let on_s21c = -999

if on_rfok = 1
  let on_s11w = 20*log10(on_s11maxmag)
  let on_s21m = 20*log10(on_s21minmag)
  let on_s21x = 20*log10(on_s21maxmag)
  let on_ripple = 20*log10(on_s21maxmag/on_s21minmag)
  let on_s22w = 20*log10(on_s22maxmag)
  let on_s21c = 20*log10(on_s21cmag)
end

let finite = 0
if $rf_off_ok = 1
  if on_rfok = 1
    let finite = 1
  end
end

let nfimp = -999
let nfimpc = -999
let gainchg = -999

if finite = 1
  let nfimp = $rf_off_nfw - on_nfw
  let nfimpc = $rf_off_nfc - on_nfc
  let gainchg = on_s21c - $rf_off_s21c
end

* ---------------- Validity ----------------

    let valid = 0
    let formal = 0
    let ncformal = 0

    if finite = 1
      let valid = $op_dcvalid

      if on_s11w > relaxed_s11
        let valid = 0
      end
      if on_s22w > relaxed_s22
        let valid = 0
      end
      if on_s21m < relaxed_gain
        let valid = 0
      end
      if on_nfw > relaxed_nf
        let valid = 0
      end
      if on_ripple > relaxed_ripple
        let valid = 0
      end
      if on_mumin < relaxed_mu
        let valid = 0
      end
      if on_mupmin < relaxed_mu
        let valid = 0
      end
      if on_dmax >= 1
        let valid = 0
      end

      let formal = $op_dcvalid
      if on_s11w > target_s11
        let formal = 0
      end
      if on_s22w > target_s22
        let formal = 0
      end
      if on_s21m < target_gain
        let formal = 0
      end
      if on_nfw > target_nf
        let formal = 0
      end
      if on_ripple > target_ripple
        let formal = 0
      end
      if on_mumin < target_mu
        let formal = 0
      end
      if on_mupmin < target_mu
        let formal = 0
      end
      if on_dmax >= 1
        let formal = 0
      end

      let ncformal = formal
      if nfimp < target_nf_improvement
        let ncformal = 0
      end
    end

    * ---------------- Objective score ----------------
    * Any hard-target violation receives a large penalty. Thus, if a formal
    * point exists, it outranks all non-formal points. Within formal points,
    * lower NF is primary, then higher minimum gain, matching, ripple,
    * noise-cancellation improvement and power.

    let rawscore = 1e12
    let score = 1e12

    if finite = 1
      let pgain = 0
      let pnf = 0
      let ps11 = 0
      let ps22 = 0
      let pripple = 0
      let pmu = 0
      let pmup = 0
      let pnc = 0

      if on_s21m < target_gain
        let pgain = target_gain-on_s21m
      end
      if on_nfw > target_nf
        let pnf = on_nfw-target_nf
      end
      if on_s11w > target_s11
        let ps11 = on_s11w-target_s11
      end
      if on_s22w > target_s22
        let ps22 = on_s22w-target_s22
      end
      if on_ripple > target_ripple
        let pripple = on_ripple-target_ripple
      end
      if on_mumin < target_mu
        let pmu = target_mu-on_mumin
      end
      if on_mupmin < target_mu
        let pmup = target_mu-on_mupmin
      end
      if nfimp < target_nf_improvement
        let pnc = target_nf_improvement-nfimp
      end

      let rawscore = 1000000*pnf
      let rawscore = rawscore+500000*pgain
      let rawscore = rawscore+100000*ps11+100000*ps22
      let rawscore = rawscore+50000*pripple
      let rawscore = rawscore+100000*pmu+100000*pmup
      let rawscore = rawscore+100000*pnc
      let rawscore = rawscore+10000*on_nfw
      let rawscore = rawscore-2500*on_s21m
      let rawscore = rawscore-5000*nfimp
      let rawscore = rawscore+0.10*$op_pdc

      let score = rawscore
      if valid = 0
        let score = score+1e8
      end
      if formal = 0
        let score = score+1e7
      end
      if ncformal = 0
        let score = score+1e6
      end
    end

    echo POINT I $&finite $&valid $op_dcvalid $&formal $&ncformal $&score $&rawscore $cur_lcg $cur_wcg $cur_mcg $cur_vbcg $cur_rd1 $cur_lbicg $cur_wbicg $cur_mbicg $cur_vbicg $cur_lcs $cur_wcs $cur_mcs $cur_vbcs $cur_wcas $cur_mcas $cur_vbcas $cur_rd2 $cur_rs_d $cur_cs_d $cur_wcsc $cur_mcsc $cur_vbcsc $cur_vbcasc $cur_cnc $cur_rs_s $cur_cs_s $cur_lin $cur_cshin $cur_lout $cur_cshout $cur_wsf $cur_msf $cur_vbbuf $cur_wbisf $cur_mbisf $op_pdc $op_vx $op_d $op_s $op_v8 $op_v11 $op_v3 $op_v10 $op_vbuf $op_id1 $op_id2 $op_id4 $op_id5 $op_id7 $op_id9 $op_gm1 $op_gm2 $op_gm5 $op_gm9 $op_sat1 $op_sat2 $op_sat4 $op_sat5 $op_sat7 $op_sat9 $rf_off_s11w $rf_off_s21m $rf_off_s22w $rf_off_nfw $&on_s11w $&on_s21m $&on_s21x $&on_s22w $&on_nfw $&nfimp $&nfimpc $&gainchg $&on_ripple $&on_mumin $&on_mupmin $&on_kmin $&on_dmax $&zinre $&zinim $&zoutre $&zoutim >> lna_nc_wide_detailed.txt

    if score < $stage_best_any_score
      set stage_best_any_score = $&score
    set besta_lcg = $cur_lcg
set besta_wcg = $cur_wcg
set besta_mcg = $cur_mcg
set besta_vbcg = $cur_vbcg
set besta_rd1 = $cur_rd1
set besta_lbicg = $cur_lbicg
set besta_wbicg = $cur_wbicg
set besta_mbicg = $cur_mbicg
set besta_vbicg = $cur_vbicg
set besta_lcs = $cur_lcs
set besta_wcs = $cur_wcs
set besta_mcs = $cur_mcs
set besta_vbcs = $cur_vbcs
set besta_wcas = $cur_wcas
set besta_mcas = $cur_mcas
set besta_vbcas = $cur_vbcas
set besta_rd2 = $cur_rd2
set besta_rs_d = $cur_rs_d
set besta_cs_d = $cur_cs_d
set besta_wcsc = $cur_wcsc
set besta_mcsc = $cur_mcsc
set besta_vbcsc = $cur_vbcsc
set besta_vbcasc = $cur_vbcasc
set besta_cnc = $cur_cnc
set besta_rs_s = $cur_rs_s
set besta_cs_s = $cur_cs_s
set besta_lin = $cur_lin
set besta_cshin = $cur_cshin
set besta_lout = $cur_lout
set besta_cshout = $cur_cshout
set besta_wsf = $cur_wsf
set besta_msf = $cur_msf
set besta_vbbuf = $cur_vbbuf
set besta_wbisf = $cur_wbisf
set besta_mbisf = $cur_mbisf
    end

    if valid = 1
      if rawscore < $stage_best_valid_score
        set stage_found_valid = 1
        set stage_best_valid_score = $&rawscore
    set bestv_lcg = $cur_lcg
set bestv_wcg = $cur_wcg
set bestv_mcg = $cur_mcg
set bestv_vbcg = $cur_vbcg
set bestv_rd1 = $cur_rd1
