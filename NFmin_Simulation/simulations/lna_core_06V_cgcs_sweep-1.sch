foreach mcscv 1 2 3 4 6 8
  foreach vbcscv 0.70 0.80 0.90 1.00 1.10
    foreach vbcascv 2.60 2.80 3.00 3.20 3.40

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
set cur_rd1 = $sel_rd1
set cur_lbicg = $sel_lbicg
