foreach wcasv 40u 55u 70u 90u 110u
  foreach vbcasv 2.60 2.80 3.00 3.20 3.40 3.60
    foreach rd2v 300 400 500 600 700 800 900

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
set cur_rd1 = $sel_rd1
set cur_lbicg = $sel_lbicg
set cur_wbicg = $sel_wbicg
set cur_mbicg = $sel_mbicg
set cur_vbicg = $sel_vbicg
