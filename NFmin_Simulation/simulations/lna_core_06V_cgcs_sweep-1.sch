foreach lbiv 0.50u 0.70u 1.00u 1.50u
  foreach mbiv 1 2 3 4 6 8 10
    foreach vbiv 1.20 1.40 1.60 1.80 2.00 2.20

set cur_lcg = $sel_lcg
set cur_wcg = $sel_wcg
set cur_mcg = $sel_mcg
set cur_vbcg = $sel_vbcg
set cur_rd1 = $sel_rd1
